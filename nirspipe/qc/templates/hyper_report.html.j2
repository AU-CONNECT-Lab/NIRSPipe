{% extends "_report_base.html.j2" %}
{% from "_macros.html.j2" import subject_metrics %}

{% block css %}
/* the two panels a row holds are not the same width: an optode map beside a head. They
   collapse to one column on a narrow screen */
.row { display: grid; gap: 1rem; margin-top: 0.5rem; }
.row-layout { grid-template-columns: 1fr 2fr; }
@media (max-width: 900px) {
  .row-layout { grid-template-columns: 1fr; }
}
.row h3 { margin-top: 0; }

.cd-chip{cursor:pointer;padding:.1rem .5rem;border-radius:3px;font-size:.78rem;
  font-weight:600;display:inline-block;min-width:4.2rem;text-align:center}
.cd-chip.cd-unrated{background:var(--surface-alt);color:var(--muted)}
.cd-chip.cd-good{background:var(--ok-soft);color:var(--ok)}
.cd-chip.cd-bad{background:var(--bad-soft);color:var(--bad)}
.cd-chip.cd-disabled{opacity:.45;pointer-events:none;cursor:not-allowed}
/* under the second line nirspipe-rate was given, apart from each member's own red */
.cd-table td.rate-low{outline:2px dashed var(--warn);outline-offset:-3px}
.cd-table td, .cd-table th { text-align: center; }
/* each member's columns sit side by side under its name; the rule before each block is what
   groups them, so the cell colours the metrics carry are still the only colour in the table */
.cd-table .pair-name { text-align: left; font-weight: 600; }
.cd-table .member-start { border-left: 1px solid var(--rule); }
.cd-table .cd-cell { padding-left: 0.4rem; padding-right: 0.4rem; }
{% endblock %}

{# One cell per section, anchored to it, as the subject and post bars are. An id may differ
   from the anchor it points at (`Signal_Quality` for #Quality): a rating is filed under the
   id, so renaming one leaves an old verdict on disk with no cell to show it in. #}
{% set nav_modules = [nav_bar([
  ("Alignment", "Alignment"),
  ("Usable", "Usable time"),
  ("Motion", "Motion"),
  ("Head", "Head"),
  ("Signal_Quality", "Comparable", "#Quality"),
  ("Channels", "Channels"),
], siblings=[{"label": "Post report →", "href": post_href,
              "current": not post_href}],
   index=index_href or "", index_label="← All windows")] %}
{% set nav_chip = "group-" ~ group_id %}
{% set rating_subject = page_stem %}
{% set rating_pinned = [{"id": "Final", "name": "FINAL", "href": "#Final"}] %}
{% set rating_save_endpoint = "/save_hyper_ratings" %}
{% set rating_load_endpoint = "/load_hyper_ratings/" ~ page_stem %}

{# The dyad report reads as a document, so its header is a titled band rather than the
   sticky nav bar the dashboard reports carry. #}
{% block header %}
<div class="page-header">
  <h1>{{ page_heading }}</h1>
  <span class="subtitle">dyad raw QC &bull;
    v{{ versions.get('nirspipe', 'unknown') }} &bull; {{ run_date }}</span>
</div>
{% endblock %}

{% block content %}

<!-- ============================================================== summary -->
<h2 id="Final">Summary</h2>
<div class="summary-box">
  <div class="summary-grid">
    <table>
      <tr><th>Group</th><td>group-{{ group_id }}</td></tr>
      <tr><th>Task</th><td>{{ task }}</td></tr>
      <tr><th>Members</th><td>{{ subject_ids | join(' &times; ') | safe }}</td></tr>
      <tr><th>Scope</th><td>the recording as acquired, before preprocessing</td></tr>
      <tr><th>Date</th><td>{{ run_date }}</td></tr>
      <tr><th>nirspipe</th><td>v{{ versions.get('nirspipe', 'n/a') }}</td></tr>
      <tr><th>MNE</th><td>v{{ versions.get('mne', 'n/a') }}</td></tr>
      <tr><th>Python</th><td>{{ versions.get('python', 'n/a') }}</td></tr>
    </table>
    <table>
      <tr><th>SCI threshold</th><td>{{ sci_lines_text }}</td></tr>
      <tr><th>Aligned duration</th>
          <td>{% if align_duration_s %}{{ "%.1f"|format(align_duration_s) }}&thinsp;s
              {%- else %}&mdash;{% endif %}</td></tr>
      <tr><th>Max crop offset</th>
          <td>{{ "%.3f"|format(align_max_offset_s) }}&thinsp;s</td></tr>
      <tr><th>Channel pairs</th><td id="sum-n-pairs">&mdash;</td></tr>
      <tr><th>Good in every member</th><td id="sum-all-good">&mdash;</td></tr>
      <tr><th>Bad in every member</th><td id="sum-all-bad">&mdash;</td></tr>
      <tr><th>Usable by the dyad</th><td id="sum-usable">&mdash;</td></tr>
    </table>
  </div>
  <p class="qm-note" style="margin-top:0.75rem;">{{ section_note('hyper_raw.scope') }}{% if post_href %} {{ section_note('hyper_raw.scope_post_link', href=post_href) }}{% endif %}</p>

  <h3 style="margin-top:1.1rem;">The two clocks</h3>
  <p class="qm-note">{{ section_note('hyper.clocks') }}</p>
  <div class="summary-grid">
    <table class="qm-table qm-flat" id="align-table">
      <thead><tr><th>Member</th><th>Offset (s)</th><th>Aligned duration (s)</th></tr></thead>
      <tbody id="align-tbody"></tbody>
    </table>
    <table class="qm-table qm-flat" id="blocks-table">
      <thead><tr><th>Block</th><th>Start (s)</th><th>Length (s)</th></tr></thead>
      <tbody id="blocks-tbody"></tbody>
    </table>
  </div>
  <p class="qm-note" id="blocks-verdict"></p>
  <h3 style="margin-top:1rem;">Run command</h3>
  <pre>{{ run_command }}</pre>
</div>

<!-- ================================================= 2. alignment and clocks -->
<h2 id="Alignment">1 &middot; Alignment and the two clocks</h2>
<p class="step-desc">{{ section_note('hyper_raw.alignment') }}</p>

{% if figure_paths.alignment_timeline %}
<section id="Timeline" class="step">
  <h3 class="step-title">The blocks, before and after alignment</h3>
  <div class="details-body">
    <iframe class="plotly-frame" src="{{ figure_paths.alignment_timeline.src }}"
            title="conditions before and after alignment"
            style="height:{{ figure_paths.alignment_timeline.h }}px"></iframe>
    <p class="qm-note">{{ section_note('hyper_raw.alignment_timeline') }}</p>
    <p class="fig-path">{{ figure_paths.alignment_timeline.src }}</p>
    {% if onset_residuals %}
    <p class="qm-note">{{ section_note('hyper_raw.onset_residuals', ref=subject_ids[0], tol="%.3f"|format(onset_tol_s), n="%g"|format(onset_tol_samples)) }}</p>
    <table class="qm-table qm-flat" id="onset-residual-table">
      <thead><tr><th>Condition</th><th>Member</th><th>Onset difference (s)</th><th>Within tolerance</th></tr></thead>
      <tbody>
      {% for r in onset_residuals %}
        <tr><td>{{ r.condition }}</td><td>{{ r.subject_id }}</td><td>{{ "%.3f"|format(r.residual_s) }}</td><td>{{ "yes" if r.within else "no" }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>
</section>
{% endif %}

<!-- ============================================================ per-channel signals -->
<h2 id="Signals">2 &middot; Per-channel signals</h2>

<section id="PerChannel" class="step">
  <h3 class="step-title">a. Both members on one set of axes <span class="hint">signal overlay and PSD</span></h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_raw.per_channel') }}</p>
    <select id="ch-select" class="ch-select"></select>
    <iframe id="ch-detail-iframe" class="plotly-frame" title="per-channel detail"
            style="height:600px"></iframe>
  </div>
</section>

<!-- ================================================== 3. shared usable time -->
<h2 id="Usable">3 &middot; Shared usable time</h2>
<p class="step-desc">{{ section_note('hyper_raw.usable') }}</p>

{% if figure_paths.usable_time %}
<section id="UsablePanel" class="step">
  <h3 class="step-title">a. Which pairs, when, and why not</h3>
  <div class="details-body">
    <iframe class="plotly-frame" src="{{ figure_paths.usable_time.src }}"
            title="usable channel pairs over the shared clock"
            style="height:{{ figure_paths.usable_time.h }}px"></iframe>
    <p class="qm-note">{{ section_note('hyper_raw.usable_panel') }}</p>
    <p class="fig-path">{{ figure_paths.usable_time.src }}</p>
  </div>
</section>
{% endif %}

<!-- ======================================================== 3. motion -->
{% if figure_paths.motion_before %}
<h2 id="Motion">4 &middot; Motion, and whether they moved together</h2>
<p class="step-desc">{{ section_note('hyper_raw.motion') }}</p>

<section id="MotionPanel" class="step">
  <h3 class="step-title">a. As it arrived</h3>
  <div class="details-body">
    <iframe class="plotly-frame" src="{{ figure_paths.motion_before.src }}"
            title="motion per member over the shared clock, before correction"
            style="height:{{ figure_paths.motion_before.h }}px"></iframe>
    <p class="qm-note">{{ section_note('hyper_raw.motion_before') }}</p>
    <p class="fig-path">{{ figure_paths.motion_before.src }}</p>
  </div>
</section>

{% if figure_paths.motion_after %}
<section id="MotionAfter" class="step">
  <h3 class="step-title">b. After motion correction</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_raw.motion_after') }}</p>
    <iframe class="plotly-frame" src="{{ figure_paths.motion_after.src }}"
            title="motion per member over the shared clock, after correction"
            style="height:{{ figure_paths.motion_after.h }}px"></iframe>
    <p class="fig-path">{{ figure_paths.motion_after.src }}</p>
  </div>
</section>
{% endif %}

{#- the two figures' numbers, under them rather than as a step of their own -#}
<div class="details-body" id="motion-summary">
  <table class="qm-table qm-flat qm-unified" id="motion-table"></table>
  <p class="qm-note">{{ section_note('hyper_raw.motion_together') }}</p>
</div>
{% endif %}

<!-- ==================================================== 3b. where on the head -->
{% if figure_paths.head_by_condition or figure_paths.head_slider %}
<h2 id="Head">5 &middot; Where on the head</h2>
<p class="step-desc">{{ section_note('hyper_raw.head') }}</p>

{% if figure_paths.head_by_condition %}
<section id="HeadByCondition" class="step">
  <h3 class="step-title">a. Per block</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_raw.head_by_condition') }}</p>
    <iframe class="plotly-frame" src="{{ figure_paths.head_by_condition.src }}"
            title="coupled-window share per member per block"
            style="height:{{ figure_paths.head_by_condition.h }}px"></iframe>
    <p class="fig-path">{{ figure_paths.head_by_condition.src }}</p>
  </div>
</section>
{% endif %}

{% if figure_paths.head_slider %}
<section id="HeadSlider" class="step">
  <h3 class="step-title">b. Over the recording <span class="hint">one head per member, with a slider</span></h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_raw.head_slider') }}</p>
    <iframe class="plotly-frame" src="{{ figure_paths.head_slider.src }}"
            title="SCI per channel over the recording"
            style="height:{{ figure_paths.head_slider.h }}px"></iframe>
    <p class="fig-path">{{ figure_paths.head_slider.src }}</p>
  </div>
</section>
{% endif %}
{% endif %}

<!-- ================================================== 1. are they comparable -->
<h2 id="Quality">6 &middot; Are the two members comparable</h2>
<p class="step-desc">{{ section_note('hyper_raw.comparable') }}</p>

<section id="Comparable" class="step">
  <h3 class="step-title">a. Montage and rate</h3>
  <div class="details-body">
    <table class="qm-table qm-flat" id="compare-table">
      <thead><tr><th>Member</th><th>Sampling rate (Hz)</th><th>Aligned duration (s)</th>
        <th>S-D pairs</th><th>Long pairs</th></tr></thead>
      <tbody id="compare-tbody"></tbody>
    </table>
    <p class="qm-note" id="compare-verdict"></p>
  </div>
</section>

{% if subject_metrics_rows %}
<section id="MemberMetrics" class="step">
  <h3 class="step-title">b. Per-member quality metrics</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_raw.member_metrics') }}</p>
    {{ subject_metrics(subject_metrics_rows) }}
  </div>
</section>
{% endif %}

<section id="GroupSQM" class="step">
  <h3 class="step-title">c. Group-level quality metrics</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_raw.group_sqm') }}</p>
    <ul id="sqm-list" class="qm-list"></ul>
  </div>
</section>

<!-- ============================================================= 5. channels -->
<h2 id="Channels">7 &middot; Channels</h2>

<section id="hyper-decisions-card" class="step">
  <h3 class="step-title">a. Channel decisions <span class="hint" id="hyper-decisions-hint">per member</span></h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_raw.channel_decisions') }}</p>
    <p class="step-desc" id="hyper-decisions-rate-line" style="display:none"></p>
    <div id="hyper-decisions-tables"></div>
  </div>
</section>

{% if figure_paths.ch_summary %}
<section id="ChannelSummary" class="step">
  <h3 class="step-title">b. Quality summary across the dyad</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_raw.channel_summary') }}</p>
    <iframe class="plotly-frame" src="{{ figure_paths.ch_summary.src }}"
            title="channel quality summary across the group"
            style="height:{{ figure_paths.ch_summary.h }}px"></iframe>
    <p class="fig-path">{{ figure_paths.ch_summary.src }}</p>
  </div>
</section>
{% endif %}



<script>
window.addEventListener("message", function(e) {
  if (!e.data || e.data.type !== "iframe-resize") return;
  var frames = document.querySelectorAll("iframe");
  for (var i = 0; i < frames.length; i++) {
    if (frames[i].contentWindow === e.source) {
      frames[i].style.height = e.data.h + "px";
      return;
    }
  }
});
</script>

<script>
var _ALIGN          = {{ alignment_json | safe }};
var _CH_PAIRS       = {{ ch_pairs_json | safe }};
var _SQM            = {{ sqm_json | safe }};
var _CH_DETAIL_TMPL = {{ ch_detail_template_json | safe }};
var _BLOCKS         = {{ blocks_json | safe }};
var _MEMBERS        = {{ member_info_json | safe }};

window._CH_PAIRS        = _CH_PAIRS;
window._HYPER_SUBJECTS  = {{ subject_ids | tojson }};
window._DECISION_ROWS   = {{ decision_rows_json | safe }};
window._CH_COLUMNS      = {{ ch_columns | tojson }};
window._CH_WAVELENGTHS  = {{ ch_wavelengths | tojson }};
window._WAVELENGTH_COLUMNS = {{ wavelength_columns | list | tojson }};

function _pairFname(pair) {
  return pair.replace(/[^a-zA-Z0-9]/g, "");
}

// ── alignment table ──────────────────────────────────────────────────────────
(function() {
  var tbody = document.getElementById("align-tbody");
  _ALIGN.forEach(function(row) {
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + row.subject_id + "</td>" +
      "<td>" + (row.offset_s   !== null ? row.offset_s.toFixed(3)   : "—") + "</td>" +
      "<td>" + (row.duration_s !== null ? row.duration_s.toFixed(1) : "—") + "</td>";
    tbody.appendChild(tr);
  });
})();

// ── channel selector → swap per-channel iframe src ───────────────────────────
(function() {
  var sel   = document.getElementById("ch-select");
  var frame = document.getElementById("ch-detail-iframe");
  _CH_PAIRS.forEach(function(pair) {
    var opt = document.createElement("option");
    opt.value = pair; opt.textContent = pair;
    sel.appendChild(opt);
  });
  function _load(pair) {
    if (!_CH_DETAIL_TMPL) return;
    frame.src = _CH_DETAIL_TMPL.replace("{pair}", _pairFname(pair));
  }
  sel.addEventListener("change", function() { _load(this.value); });
  if (_CH_PAIRS.length > 0) _load(_CH_PAIRS[0]);
})();

// the summary's cells come from the same record the sections do, so the two cannot
// disagree about a number the reader sees twice
function _set(id, text, cls) {
  var el = document.getElementById(id);
  if (!el) return;
  el.textContent = text;
  el.className = cls || "";
}

// ── group-level metrics, and the three of them the summary repeats ───────────
(function() {
  var q = _SQM;
  function li(label, value, cls) {
    return "<li><span class='ql'>" + label + "</span>" +
           "<span class='qv" + (cls ? " " + cls : "") + "'>" + value + "</span></li>";
  }
  var pct = q.pct_all_good;
  var goodCls = pct != null ? (pct >= 80 ? "qm-ok" : pct >= 50 ? "qm-warn" : "qm-bad") : "";
  document.getElementById("sqm-list").innerHTML =
    li("Channels: all good",
       (q.n_all_good != null ? q.n_all_good : "—") +
         (q.n_total ? " / " + q.n_total : ""), goodCls) +
    li("Channels: mixed",   q.n_mixed   != null ? q.n_mixed   : "—") +
    li("Channels: all bad", q.n_all_bad != null ? q.n_all_bad : "—",
       q.n_all_bad > 0 ? "qm-bad" : "") +
    li("Aligned duration",    q.aligned_duration_s != null ? q.aligned_duration_s + " s" : "—") +
    li("Max alignment offset",q.max_offset_s       != null ? q.max_offset_s + " s"       : "—");

  _set("sum-n-pairs", q.n_total != null ? String(q.n_total) : "—");
  _set("sum-all-good",
       (q.n_all_good != null ? q.n_all_good : "—") +
         (pct != null ? " (" + pct.toFixed(0) + "%)" : ""), goodCls);
  _set("sum-all-bad", q.n_all_bad != null ? String(q.n_all_bad) : "—",
       q.n_all_bad > 0 ? "qm-bad" : "");
  _set("sum-usable",
       q.usable_pairs_mean != null
         ? q.usable_pairs_mean.toFixed(2) + " of " + q.n_long_pairs + " pairs on average"
         : "—");
})();

// ── are the two members comparable ───────────────────────────────────────────
(function() {
  var tbody = document.getElementById("compare-tbody");
  if (!tbody || !_MEMBERS.length) return;
  _MEMBERS.forEach(function(m) {
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + m.subject_id + "</td>" +
      "<td>" + (m.sfreq != null ? m.sfreq.toFixed(4) : "—") + "</td>" +
      "<td>" + (m.duration_s != null ? m.duration_s.toFixed(1) : "—") + "</td>" +
      "<td>" + m.n_pairs + "</td>" +
      "<td>" + m.n_long + "</td>";
    tbody.appendChild(tr);
  });
  // a rate mismatch is drift alignment cannot remove, and an unmatched label becomes a
  // blank row in every later panel; both are silent unless this line says so
  var rates = _MEMBERS.map(function(m) { return m.sfreq; });
  var sameRate = rates.every(function(r) { return Math.abs(r - rates[0]) < 1e-9; });
  var counts = _MEMBERS.map(function(m) { return m.n_pairs; });
  var sameSet = counts.every(function(c) { return c === counts[0]; });
  var el = document.getElementById("compare-verdict");
  if (!el) return;
  if (sameRate && sameSet) {
    el.innerHTML = "<span class='badge-green'>Comparable</span>: same sampling rate and "
      + "the same " + counts[0] + " S-D pairs.";
  } else {
    var why = [];
    if (!sameRate) why.push("sampling rates differ (" + rates.join(", ") + " Hz)");
    if (!sameSet) why.push("the montages carry different channel counts ("
      + counts.join(", ") + ")");
    el.innerHTML = "<span class='badge-red'>Not comparable</span>: " + why.join("; ") + ".";
  }
})();

// ── where each block landed ──────────────────────────────────────────────────
(function() {
  var tbody = document.getElementById("blocks-tbody");
  var names = Object.keys(_BLOCKS);
  if (!tbody) return;
  if (!names.length) {
    tbody.innerHTML = "<tr><td colspan='3' style='color:#adb5bd;font-style:italic;"
      + "text-align:center'>No annotated blocks</td></tr>";
    return;
  }
  names.forEach(function(name) {
    var span = _BLOCKS[name];
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + name + "</td>" +
      "<td>" + span[0].toFixed(2) + "</td>" +
      "<td>" + (span[1] - span[0]).toFixed(1) + "</td>";
    tbody.appendChild(tr);
  });
  var el = document.getElementById("blocks-verdict");
  if (el) {
    el.textContent = {{ section_note('hyper_raw.blocks_verdict') | tojson }};
  }
})();

// ── motion: the two figures' numbers in one table, a channel set per column ─────
(function() {
  var m = _SQM.motion || {};
  var table = document.getElementById("motion-table");
  if (!table) return;
  // a channel set holds one number per member at each stage; the span count holds one number
  var sets = Object.keys(m).filter(function(k) {
    return m[k] && typeof m[k].before === "object";
  });
  if (!sets.length) {
    document.getElementById("motion-summary").style.display = "none";
    return;
  }
  function stages(before, after, digits) {
    if (before == null) return "—";
    var b = digits == null ? String(before) : before.toFixed(digits);
    if (after == null) return b;
    return b + " → " + (digits == null ? String(after) : after.toFixed(digits));
  }
  function row(label, cells) {
    return "<tr><td><span class='ql'>" + label + "</span></td>" + cells.map(function(c) {
      return "<td class='qv" + (c[1] ? " " + c[1] : "") + "'>" + c[0] + "</td>";
    }).join("") + "</tr>";
  }
  var html = "<thead><tr><th>Metric</th>" + sets.map(function(k) {
    return "<th>" + k.charAt(0).toUpperCase() + k.slice(1) + "</th>";
  }).join("") + "</tr></thead><tbody>";
  // "together" is the mean of the pointwise minimum: high only where both were high
  var keys = Object.keys(m[sets[0]].before).filter(function(k) { return k !== "together"; });
  keys.concat(["together"]).forEach(function(key) {
    var label = key === "together" ? "Both at once" : key + ", mean GVTD over own median";
    html += row(label, sets.map(function(set) {
      return [stages(m[set].before[key], (m[set].after || {})[key], 2), ""];
    }));
  });
  if (sets.some(function(set) { return m[set].reduction != null; })) {
    // a negative value means the correction put some back, worth seeing rather than rounding
    html += row("Simultaneous movement removed", sets.map(function(set) {
      var r = m[set].reduction;
      if (r == null) return ["—", ""];
      return [(r * 100).toFixed(0) + "%", r >= 0.3 ? "qm-ok" : r > 0 ? "qm-warn" : "qm-bad"];
    }));
  }
  // counted on the canonical channel set alone, so it sits in the first column only
  var spans = m.spike_spans_both || {};
  if (spans.before != null) {
    html += row("Spans where both spiked", [[stages(spans.before, spans.after), ""]]
      .concat(sets.slice(1).map(function() { return ["", ""]; })));
  }
  table.innerHTML = html + "</tbody>";
})();

</script>

<!-- Channel Decisions: populated by nirspipe-rate hyper when served via Flask -->
<script>
(function(){
  var _hyperDecisions = {};
  var _isStatic       = true;
  var _rateSciLine    = null;
  var _hdTimer        = null;

  var subjects = window._HYPER_SUBJECTS || [];
  // strings and cell classes already built by qc/channel_table.py, as in the raw viewer:
  // a renderer that formatted its own numbers would drift from the report beside it
  var _DECISION_ROWS = window._DECISION_ROWS || {};
  var _CH_COLUMNS    = window._CH_COLUMNS || [];
  var _CH_WAVELENGTHS = window._CH_WAVELENGTHS || [];
  var _WAVELENGTH_COLUMNS = window._WAVELENGTH_COLUMNS || [];

  // a second SCI line, only when nirspipe-rate hyper was given --sci-threshold
  fetch("/rate_config")
    .then(function(r) { if (!r.ok) throw new Error("no config"); return r.json(); })
    .then(function(cfg) {
      if (!cfg || cfg.sci_threshold == null) return;
      _rateSciLine = cfg.sci_threshold;
      var p = document.getElementById("hyper-decisions-rate-line");
      if (p) {
        p.innerHTML = {{ section_note('hyper_raw.rate_sci_line', line='{line}') | tojson }}
          .replace("{line}", Number(_rateSciLine).toFixed(2));
        p.style.display = "";
      }
      buildTable();
    })
    .catch(function() {});

  fetch("/load_decisions")
    .then(function(r) { if (!r.ok) throw new Error("load failed"); return r.json(); })
    .then(function(data) {
      _isStatic = false;
      _hyperDecisions = data || {};
      var hint = document.getElementById("hyper-decisions-hint");
      if (hint) hint.textContent = "per member";
      buildTable();
    })
    .catch(function() {
      _isStatic = true;
      var hint = document.getElementById("hyper-decisions-hint");
      if (hint) hint.textContent = "per member, read-only: launch via nirspipe-rate hyper to save decisions";
      buildTable();
    });

  // a table per separation group, each member's columns side by side under its name, so a
  // pair is compared across one row; long first, then short, as the subject report orders them
  function buildTable() {
    var host = document.getElementById("hyper-decisions-tables");
    if (!host) return;
    host.innerHTML = "";
    var metrics = _CH_COLUMNS.slice(1);                 // the name column heads the row
    if (!_DECISION_ROWS.length) {
      host.innerHTML = "<p class='step-desc'>No channels.</p>";
      return;
    }
    var blocks = [["Long channels", []], ["Short channels", []], ["Unclassified", []]];
    _DECISION_ROWS.forEach(function(row) {
      var i = row.separation === "short" ? 1 : (row.separation === "unclassified" ? 2 : 0);
      blocks[i][1].push(row);
    });
    blocks = blocks.filter(function(b) { return b[1].length; });
    blocks.forEach(function(block) {
      if (blocks.length > 1) {
        var title = document.createElement("h4");
        title.className = "qm-sub";
        title.textContent = block[0] + " (" + block[1].length + ")";
        host.appendChild(title);
      }
      var table = document.createElement("table");
      table.className = "qm-table cd-table";
      table.appendChild(headRows(metrics));
      var tbody = document.createElement("tbody");
      block[1].forEach(function(row) { tbody.appendChild(pairRow(row, metrics)); });
      table.appendChild(tbody);
      var wrap = document.createElement("div");
      wrap.style.overflowX = "auto";
      wrap.appendChild(table);
      host.appendChild(wrap);
    });
  }

  function headRows(metrics) {
    var thead = document.createElement("thead");
    var top = document.createElement("tr");
    var sub = document.createElement("tr");
    var name = document.createElement("th");
    name.rowSpan = 2;
    name.className = "pair-name";
    name.textContent = _CH_COLUMNS[0][1];
    top.appendChild(name);
    subjects.forEach(function(sid) {
      var th = document.createElement("th");
      th.colSpan = metrics.length + 1;
      th.className = "member-start";
      th.textContent = sid;
      top.appendChild(th);
      metrics.concat([["decision", "Decision"]]).forEach(function(col, j) {
        var h = document.createElement("th");
        if (j === 0) h.className = "member-start";
        h.textContent = col[1];
        if (_CH_WAVELENGTHS.length && _WAVELENGTH_COLUMNS.indexOf(col[0]) >= 0) {
          var wl = document.createElement("span");
          wl.className = "wl";
          wl.textContent = _CH_WAVELENGTHS.join(" / ") + " nm";
          h.appendChild(wl);
        }
        sub.appendChild(h);
      });
    });
    thead.appendChild(top);
    thead.appendChild(sub);
    return thead;
  }

  function pairRow(row, metrics) {
    var tr = document.createElement("tr");
    var tdName = document.createElement("td");
    tdName.className = "pair-name";
    tdName.textContent = row.pair;
    tr.appendChild(tdName);
    subjects.forEach(function(sid) {
      var cells = row.by_sub[sid] || {};
      // each member's own verdict tints its own columns
      var tint = cells.is_bad ? "#fff8f8" : "";
      metrics.forEach(function(col, j) {
        var td = document.createElement("td");
        td.textContent = cells[col[0]] != null ? cells[col[0]] : "—";
        var cls = cells[col[0] + "_cls"];
        if (cls) td.className = cls;
        if (j === 0) td.classList.add("member-start");
        if (col[0] === "sci_win" && _rateSciLine != null && cells.sci_win_value != null
            && cells.sci_win_value < _rateSciLine) td.classList.add("rate-low");
        td.style.background = tint;
        tr.appendChild(td);
      });
      var chip = chipCell(sid, row.pair);
      chip.style.background = tint;
      tr.appendChild(chip);
    });
    return tr;
  }

  function chipCell(sid, pair) {
    var hbo = pair + " hbo";
    var hbr = pair + " hbr";
    if (!_hyperDecisions[sid]) _hyperDecisions[sid] = {};
    var state = _hyperDecisions[sid][hbo] || "unrated";
    var chip = document.createElement("span");
    chip.className = "cd-chip cd-" + state + (_isStatic ? " cd-disabled" : "");
    chip.textContent = {unrated: "—", good: "good", bad: "bad"}[state];
    if (!_isStatic) {
      chip.addEventListener("click", function() {
        var cur  = _hyperDecisions[sid][hbo] || "unrated";
        var next = {unrated: "good", good: "bad", bad: "unrated"}[cur];
        _hyperDecisions[sid][hbo] = next;
        _hyperDecisions[sid][hbr] = next;
        chip.className   = "cd-chip cd-" + next;
        chip.textContent = {unrated: "—", good: "good", bad: "bad"}[next];
        save();
      });
    }
    var td = document.createElement("td");
    td.className = "cd-cell";
    td.appendChild(chip);
    return td;
  }

  function save() {
    if (_isStatic) return;
    if (_hdTimer) clearTimeout(_hdTimer);
    _hdTimer = setTimeout(function() {
      fetch("/save_hyper_decisions", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify(_hyperDecisions),
      })
      .then(function(r) { return r.json(); })
      .then(function(d) { if (d.status !== "success") console.warn("hyper cd save failed:", d); })
      .catch(function(e) { console.warn("hyper cd save error:", e); });
    }, 500);
  }
})();
</script>

{% endblock %}
