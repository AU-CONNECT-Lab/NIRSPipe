{% extends "_report_base.html.j2" %}

{% block css %}
/* The document look, the one every report wears: a section is a heading with a rule under
   it, laid out flat, and the page is read top to bottom. document.css owns the summary
   grid, the steps and the metric tables; only the group report's own panels belong here. */

.plot-frame { width: 100%; border: none; display: block; }

#box-flow { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-start; }
.box-frame { border: none; display: block; }

/* the cohort summary: a short lookup table, so compact rather than the page's width */
table.headline { width: auto; min-width: 32rem; }
table.headline td:not(:first-child),
table.headline th:not(:first-child) { text-align: right; }
table.headline td { font-variant-numeric: tabular-nums; }

/* a panel with one row per run is as tall as the cohort is long and the page grows with it;
   only a panel wider than the page scrolls, sideways */
.tall-frame { overflow-x: auto; margin-top: 0.5rem; }

/* sideways only. A scroll box captures a sticky header, so _sticky_head.html.j2 keeps a
   copy of it under the top bar */
#group-table-wrap { overflow-x: auto; margin-top: 0.5rem; }
table.group-table {
  width: 100%; border-collapse: collapse; font-size: 0.78rem;
  font-variant-numeric: tabular-nums;
}
/* no cell grid: a row is separated by a hairline and a column by being right-aligned, the way
   every other metric table on the document look reads */
table.group-table th, table.group-table td {
  padding: 0.25rem 0.55rem; text-align: right; white-space: nowrap;
}
table.group-table th {
  background: var(--surface); cursor: pointer; user-select: none;
  position: sticky; top: 0; font-size: 0.75rem;
}
table.group-table th:first-child, table.group-table td:first-child {
  text-align: left; position: sticky; left: 0; background: var(--surface);
}
table.group-table th:first-child { z-index: 2; }
table.group-table tbody tr:hover td { background: var(--surface-alt); }
table.group-table th .sort-ind { color: var(--faint); font-size: 0.7rem; margin-left: 0.3rem; }

#outlier-list ul { margin: 0; padding-left: 1.2rem; font-size: 0.85rem; }
#outlier-list li { padding: 0.18rem 0; border-bottom: 1px solid var(--rule-soft); }
#outlier-list li b { color: var(--bad); }
#outlier-list .no-out { color: var(--ok); font-weight: 600; }
.outlier-metric {
  display: inline-block; background: var(--warn-soft); color: var(--warn);
  padding: 0.05rem 0.45rem; margin: 0 0.15rem; border-radius: 999px; font-size: 0.78rem;
}
{% endblock %}

{# Navigation only: this page reads a cohort out of the runs' own records, and a verdict
   belongs on the run it is about. The sections follow the body, so a cohort with no
   conditions is not offered an entry for them. #}
{% set _sections = [("Overview", "Overview"), ("Distributions", "Distributions")] %}
{% if unfinished %}{% set _sections = [("Unfinished", "Subjects that did not finish")] + _sections %}{% endif %}
{% if conditions %}
  {% set _ = _sections.append(("Conditions", "By condition")) %}
  {% set _ = _sections.append(("ConditionMatrix", "Run × condition")) %}
{% endif %}
{% set _ = _sections.append(("Windowed", "Over time")) %}
{% set _ = _sections.append(("Outliers", "Outliers")) %}
{% set _ = _sections.append(("Metrics", "Quality Metrics")) %}
{% if regions %}{% set _ = _sections.append(("Regions", "Regions")) %}{% endif %}
{% if kept %}{% set _ = _sections.append(("ChannelsKept", "Channels kept")) %}{% endif %}
{% if optodes %}{% set _ = _sections.append(("Optodes", "Optodes")) %}{% endif %}
{% set nav_modules = [nav_bar(_sections, rated=false, summary="#Summary",
                              closing=[("Errors", "Errors & Warnings"), ("Versions", "Software Versions")])] %}
{% set nav_chip = title %}

{% block header %}
<div class="page-header">
  <h1>{{ page_heading }}</h1>
  <span class="subtitle">
    {%- for label, value in nav_meta or [] %}{{ label }}: <b>{{ value }}</b> &bull; {% endfor -%}
    {{ run_date }}
    {%- if tsv_name %} &bull; <a href="{{ tsv_name }}" download>&#8681; {{ tsv_name }}</a>{% endif %}
    {%- if channel_tsv_name %} &bull; <a href="{{ channel_tsv_name }}" download>&#8681; {{ channel_tsv_name }}</a>{% endif %}
  </span>
</div>
{% endblock %}

{% block content %}

{# printed under every panel whose statistic the cohort is too small to carry #}
{%- set small_caveat = section_note('group.small_cohort', n=n_rows) %}

{% if summary_meta or headline_rows %}
<h2 id="Summary">Summary</h2>
<div class="summary-box">
  <div class="summary-grid">
    <table>
      {%- for label, value in summary_meta or [] %}
      <tr><th>{{ label }}</th><td>{{ value }}</td></tr>
      {%- endfor %}
      <tr><th>Date</th><td>{{ run_date }}</td></tr>
      {%- if versions %}
      <tr><th>nirspipe</th><td>v{{ versions.get('nirspipe', 'n/a') }}</td></tr>
      <tr><th>Python</th><td>{{ versions.get('python', 'n/a') }}</td></tr>
      {%- endif %}
    </table>
  </div>
  {% if outliers is defined %}
  <p class="qm-note" style="margin-top:0.9rem">
    {% if outliers %}{{ section_note('group.outliers', count=outliers | length, n=n_rows,
        z=score_threshold,
        worst=' ' ~ section_note('group.outliers_worst', runs=worst_runs | join(', '))
              if worst_runs else '') }}
    {%- else %}{{ section_note('group.no_outliers', z=score_threshold) }}{% endif %}
  </p>
  {% endif %}
  {% if small_cohort %}<p class="qm-note">{{ small_caveat }}</p>{% endif %}
</div>
{% endif %}

{% if unfinished %}
<section id="Unfinished" class="step">
  <h3 class="step-title">Subjects that did not finish</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('group.unfinished') }}</p>
    <table class="qm-table qm-flat">
      <tr><th>Subject</th><th>Status</th><th>Started</th><th>Error</th></tr>
      {%- for row in unfinished %}
      <tr><td>{{ row.subject }}</td><td class="bad">{{ row.status }}</td>
          <td>{{ row.started or "&mdash;" }}</td><td>{{ row.error | e if row.error else "&mdash;" }}</td></tr>
      {%- endfor %}
    </table>
  </div>
</section>
{% endif %}

{% if figure_paths.strip %}
<section id="Overview" class="step">
  <h3 class="step-title">Overview</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('group.overview') }}</p>
    <iframe class="plot-frame" src="{{ figure_paths.strip.src }}"
            style="height:{{ figure_paths.strip.h }}px"></iframe>
  </div>
</section>
{% endif %}

{% if box_panels %}
<section id="Distributions" class="step">
  <h3 class="step-title">Distributions</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('group.distributions') }}</p>
    {% if small_cohort %}<p class="qm-note">{{ small_caveat }}</p>{% endif %}
    <div id="box-flow">
      {%- for p in box_panels %}
      <iframe class="box-frame" src="{{ p.src }}"
              style="width:{{ p.w }}px;height:{{ p.h }}px"></iframe>
      {%- endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if figure_paths.conditions %}
<section id="Conditions" class="step">
  <h3 class="step-title">By condition</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('group.conditions') }}</p>
    <iframe class="plot-frame" src="{{ figure_paths.conditions.src }}"
            style="height:{{ figure_paths.conditions.h }}px"></iframe>
  </div>
</section>
{% endif %}

{% if figure_paths.conditionmatrix %}
<section id="ConditionMatrix" class="step">
  <h3 class="step-title">Run &times; condition</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('group.condition_matrix') }}</p>
    <div class="tall-frame">
      <iframe src="{{ figure_paths.conditionmatrix.src }}"
              style="border:none;display:block;height:{{ figure_paths.conditionmatrix.h }}px;{% if figure_paths.conditionmatrix.w %}width:{{ figure_paths.conditionmatrix.w }}px{% else %}width:100%{% endif %}"></iframe>
    </div>
  </div>
</section>
{% endif %}

{% if figure_paths.windows %}
<section id="Windowed" class="step">
  <h3 class="step-title">Over time</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('group.windowed', smooth='%g'|format(smooth_s), sci_window='%g'|format(sci_window_s)) }}</p>
    <iframe class="plot-frame" src="{{ figure_paths.windows.src }}"
            style="height:{{ figure_paths.windows.h }}px"></iframe>
  </div>
</section>
{% endif %}

{% if outliers is defined %}
<section id="Outliers" class="step">
  <h3 class="step-title">Outliers</h3>
  <div class="details-body" id="outlier-list">
    <p class="step-desc">{{ section_note('group.outlier_rule', z=score_threshold) }}</p>
    {% if small_cohort %}<p class="qm-note">{{ small_caveat }}</p>{% endif %}
    {% if outliers %}
    <ul>
      {%- for sid, metrics in outliers.items() %}
      <li><b>{{ sid }}</b>:
        {% for m in metrics %}<span class="outlier-metric">{{ m }}</span>{% endfor %}
      </li>
      {%- endfor %}
    </ul>
    {% else %}
    <p class="no-out">No outliers flagged.</p>
    {% endif %}
  </div>
</section>
{% endif %}

{% if headline_rows or table_rows or kept or optodes or regions %}
<h2 id="Metrics">Quality Metrics</h2>
{% endif %}

{% if headline_rows %}
<section id="CohortSummary" class="step">
  <h3 class="step-title">Cohort summary</h3>
  <div class="details-body">
    <table class="qm-table headline">
      <tr><th>Metric</th><th>Median</th><th>Range</th></tr>
      {%- for row in headline_rows %}
      <tr><td>{{ row.label }}</td><td>{{ row.median }}</td><td>{{ row.range }}</td></tr>
      {%- endfor %}
    </table>
  </div>
</section>
{% endif %}

{% if regions %}
<section id="Regions" class="step">
  <h3 class="step-title">Regions</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('group.regions') }}</p>
    <table class="qm-table qm-flat">
      <tr><th>Region</th>
        {%- for task in regions.tasks %}<th>{{ task }}</th>{% endfor %}</tr>
      {%- for row in regions.rows %}
      <tr><td>{{ row.region }}</td>
        {%- for cell in row.cells %}<td{% if cell.runs %} title="{{ cell.runs | join(', ') }}"{% endif %}>{{ cell.text }}</td>{% endfor %}</tr>
      {%- endfor %}
    </table>
  </div>
</section>
{% endif %}

{% if kept %}
<section id="ChannelsKept" class="step">
  <h3 class="step-title">Channels kept</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('group.channels_kept') }}</p>
    <table class="qm-table qm-flat">
      <tr><th>Source-detector</th><th>Separation</th>
        {%- for task in kept.tasks %}<th>{{ task }}</th>{% endfor %}</tr>
      {%- for row in kept.rows %}
      <tr><td><code>{{ row.pair }}</code></td><td>{{ row.separation }}</td>
        {%- for cell in row.cells %}<td>{{ cell or "&mdash;" }}</td>{% endfor %}</tr>
      {%- endfor %}
    </table>
  </div>
</section>
{% endif %}

{% if optodes %}
<section id="Optodes" class="step">
  <h3 class="step-title">Optodes</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('group.optodes') }}</p>
    <table class="qm-table qm-flat">
      <tr><th>Optode</th>
        {%- for task in optodes.tasks %}<th>{{ task }}</th>{% endfor %}</tr>
      {%- for row in optodes.rows %}
      <tr><td><code>{{ row.optode }}</code></td>
        {%- for cell in row.cells %}<td>{{ cell or "&mdash;" }}</td>{% endfor %}</tr>
      {%- endfor %}
    </table>
  </div>
</section>
{% endif %}

{% if table_rows %}
<section id="Table" class="step">
  <h3 class="step-title">All metrics</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('group.table') }}</p>
    <div id="group-table-wrap">
      <table class="group-table" id="group-table">
        <thead><tr>
          {%- for c in table_columns %}
          <th data-col="{{ loop.index0 }}">{{ c }}<span class="sort-ind">&#8645;</span></th>
          {%- endfor %}
        </tr></thead>
        <tbody>
          {%- for row in table_rows %}
          <tr>
            {%- for v in row %}
            <td>{{ v if v is not none else "&mdash;" }}</td>
            {%- endfor %}
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% endif %}

{% endblock %}

{% block scripts %}
{% include "_sticky_head.html.j2" %}
<script>
(function() {
  var table = document.getElementById("group-table");
  if (table) {
    var thead = table.querySelector("thead");
    var tbody = table.querySelector("tbody");
    var asc = {};

    var cellValue = function(td) {
      var v = td.textContent.trim();
      if (v === "" || v === "—") return null;
      var n = Number(v);
      return Number.isFinite(n) ? n : v.toLowerCase();
    };

    thead.querySelectorAll("th").forEach(function(th) {
      th.addEventListener("click", function() {
        var col = +th.dataset.col;
        var direction = asc[col] = !asc[col];
        var rows = Array.from(tbody.querySelectorAll("tr"));
        rows.sort(function(a, b) {
          var va = cellValue(a.children[col]);
          var vb = cellValue(b.children[col]);
          if (va === null && vb === null) return 0;
          if (va === null) return 1;
          if (vb === null) return -1;
          if (va < vb) return direction ? -1 : 1;
          if (va > vb) return direction ? 1 : -1;
          return 0;
        });
        rows.forEach(function(r) { tbody.appendChild(r); });
        thead.querySelectorAll(".sort-ind").forEach(function(s) { s.textContent = "⇅"; });
        th.querySelector(".sort-ind").textContent = direction ? "▲" : "▼";
      });
    });
    stickyHead(table);
  }

  // iframe auto-resize listener (same protocol as figure_io.py)
  window.addEventListener("message", function(e) {
    if (!e.data || e.data.type !== "iframe-resize") return;
    var all = document.querySelectorAll("iframe");
    for (var i = 0; i < all.length; i++) {
      if (all[i].contentWindow === e.source) {
        all[i].style.height = e.data.h + "px";
        return;
      }
    }
  });
})();
</script>
{% endblock %}
