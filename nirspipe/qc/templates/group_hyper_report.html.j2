{% extends "_report_base.html.j2" %}
{# Cohort-level hyperscanning QC. Extends the shell every other report wears, so the
   only CSS here is the table, which is the group report's own and nothing else's. #}

{% block css %}
.plot-frame { width: 100%; border: none; display: block; }

.summary-grid table.headline th {
  width: auto; color: var(--muted); font-size: 0.8rem; font-weight: 600;
  border-bottom: 1px solid var(--faint);
}
.summary-grid table.headline td:not(:first-child),
.summary-grid table.headline th:not(:first-child) { text-align: right; }
.summary-grid table.headline td { font-variant-numeric: tabular-nums; border-bottom: 1px solid var(--rule-soft); }
.summary-grid table.headline td:first-child { color: var(--ink); font-weight: 600; }

/* sideways only. A scroll box captures a sticky header, so _sticky_head.html.j2 keeps a
   copy of it under the top bar */
#group-table-wrap { overflow-x: auto; margin-top: 0.5rem; }
table.group-table {
  width: 100%; border-collapse: collapse; font-size: 0.78rem;
  font-variant-numeric: tabular-nums;
}
table.group-table th, table.group-table td {
  padding: 0.25rem 0.55rem; text-align: right; white-space: nowrap;
}
table.group-table th {
  background: var(--surface); cursor: pointer; user-select: none;
  position: sticky; top: 0; font-size: 0.75rem;
}
table.group-table th:first-child, table.group-table td:first-child {
  text-align: left; position: sticky; left: 0; background: var(--surface);
}
table.group-table th:first-child { z-index: 2; }
table.group-table tbody tr:hover td { background: var(--surface-alt); }
table.group-table th .sort-ind { color: var(--faint); font-size: 0.7rem; margin-left: 0.3rem; }
{% endblock %}

{# Navigation only, as on the subject cohort page: a verdict on a dyad belongs on that
   dyad's own raw report. #}
{% set nav_modules = [nav_bar([
  ("Usable", "Usable time"),
  ("Where", "Where"),
  ("Table", "All dyads"),
], rated=false, summary="#Summary",
   closing=[("Errors", "Errors"), ("Versions", "Versions")])] %}
{% set nav_chip = "cohort" %}

{% block header %}
<div class="page-header">
  <h1>{{ page_heading }}</h1>
  <span class="subtitle">
    {%- for label, value in nav_meta or [] %}{{ label }}: <b>{{ value }}</b> &bull; {% endfor -%}
    {{ run_date }}
  </span>
</div>
{% endblock %}

{% block content %}

{%- set small_caveat = section_note('hyper_group.small_cohort', n=n_rows) %}

<h2 id="Summary">Summary</h2>
<div class="summary-box">
  <div class="summary-grid">
    <table>
      {%- for label, value in summary_meta %}
      <tr><th>{{ label }}</th><td>{{ value | safe }}</td></tr>
      {%- endfor %}
    </table>
    <table class="headline">
      <tr><th>Metric</th><th>Median</th><th>Range</th></tr>
      {%- for row in headline_rows %}
      <tr><td>{{ row.label }}</td><td>{{ row.median }}</td><td>{{ row.range }}</td></tr>
      {%- endfor %}
    </table>
  </div>
  <p class="qm-note" style="margin-top:0.9rem">{{ section_note('hyper_group.row_order') }}</p>
  {% if small_cohort %}<p class="qm-note">{{ small_caveat }}</p>{% endif %}
</div>

{% if figure_paths.usable_bars %}
<section id="Usable" class="step">
  <h3 class="step-title">Shared usable time</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_group.usable_read') }} {{ section_note('hyper_group.usable') }}</p>
    <iframe class="plot-frame" src="{{ figure_paths.usable_bars.src }}"
            style="height:{{ figure_paths.usable_bars.h }}px"></iframe>
  </div>
</section>
{% endif %}

{% if figure_paths.pair_field %}
<section id="Where" class="step">
  <h3 class="step-title">Where the time went</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_group.pair_field_read') }} {{ section_note('hyper_group.pair_field') }}</p>
    <iframe class="plot-frame" src="{{ figure_paths.pair_field.src }}"
            style="height:{{ figure_paths.pair_field.h }}px"></iframe>
    {% if figure_paths.condition_dials %}
    <p class="qm-note" style="margin-top:1rem">{{ section_note('hyper_group.condition_dials', n=n_dials) }}</p>
    <iframe class="plot-frame" src="{{ figure_paths.condition_dials.src }}"
            style="height:{{ figure_paths.condition_dials.h }}px"></iframe>
    {% endif %}
  </div>
</section>
{% elif no_shared_pairs %}
<section id="Where" class="step">
  <h3 class="step-title">Where the time went: not available for this cohort</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_group.no_shared_pairs') }}</p>
  </div>
</section>
{% endif %}

{% if table_rows %}
<section id="Table" class="step">
  <h3 class="step-title">All dyads</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('hyper_group.table') }}</p>
    <div id="group-table-wrap">
      <table class="group-table" id="group-table">
        <thead><tr>
          {%- for c in table_columns %}
          <th data-col="{{ loop.index0 }}">{{ c }}<span class="sort-ind">&#8645;</span></th>
          {%- endfor %}
        </tr></thead>
        <tbody>
          {%- for row in table_rows %}
          <tr>
            {%- for v in row %}
            <td>{{ v if v is not none else "&mdash;" }}</td>
            {%- endfor %}
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% endif %}

{% endblock %}

{% block scripts %}
{% include "_sticky_head.html.j2" %}
<script>
(function() {
  var table = document.getElementById("group-table");
  if (table) {
    var thead = table.querySelector("thead");
    var tbody = table.querySelector("tbody");
    var asc = {};
    var cellValue = function(td) {
      var v = td.textContent.trim().replace("%", "").replace(" s", "");
      if (v === "" || v === "—") return null;
      var n = Number(v);
      return Number.isFinite(n) ? n : v.toLowerCase();
    };
    thead.querySelectorAll("th").forEach(function(th) {
      th.addEventListener("click", function() {
        var col = +th.dataset.col;
        var direction = asc[col] = !asc[col];
        var rows = Array.from(tbody.querySelectorAll("tr"));
        rows.sort(function(a, b) {
          var va = cellValue(a.children[col]);
          var vb = cellValue(b.children[col]);
          if (va === null && vb === null) return 0;
          if (va === null) return 1;
          if (vb === null) return -1;
          if (va < vb) return direction ? -1 : 1;
          if (va > vb) return direction ? 1 : -1;
          return 0;
        });
        rows.forEach(function(r) { tbody.appendChild(r); });
        thead.querySelectorAll(".sort-ind").forEach(function(s) { s.textContent = "⇅"; });
        th.querySelector(".sort-ind").textContent = direction ? "▲" : "▼";
      });
    });
    stickyHead(table);
  }
  window.addEventListener("message", function(e) {
    if (!e.data || e.data.type !== "iframe-resize") return;
    var all = document.querySelectorAll("iframe");
    for (var i = 0; i < all.length; i++) {
      if (all[i].contentWindow === e.source) {
        all[i].style.height = e.data.h + "px";
        return;
      }
    }
  });
})();
</script>
{% endblock %}
