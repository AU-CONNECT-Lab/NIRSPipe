{% extends "_report_base.html.j2" %}
{# The cohort test page nirspipe-hyper-groupnull writes: one section per statistic, null and
   chromophore found for the task. Inference lives here, not on the cohort QC page. #}

{% set nav_modules = [nav_bar(nav_sections, rated=false, summary="#Summary",
   closing=[("Errors", "Errors & Warnings"), ("Versions", "Software Versions")])] %}
{% set nav_chip = "cohort" %}

{% block css %}
.plot-frame { width: 100%; border: none; display: block; }
table.groupnull-table { border-collapse: collapse; font-size: 0.8rem; margin-top: 0.6rem;
  font-variant-numeric: tabular-nums; }
table.groupnull-table th, table.groupnull-table td { padding: 0.2rem 0.6rem;
  border-bottom: 1px solid var(--rule-soft); text-align: right; }
table.groupnull-table th:first-child, table.groupnull-table td:first-child { text-align: left; }
table.groupnull-table th { color: var(--muted); font-weight: 600; }
{% endblock %}

{% block content %}
<h2 id="Summary">Summary</h2>
<div class="summary-box">
  <p class="step-desc">{{ section_note('groupnull.page') }}</p>
</div>

{% for s in sections %}
<section id="{{ s.anchor }}" class="step">
  <h3 class="step-title">{{ s.title }}</h3>
  <div class="details-body">
    <p class="step-desc">{{ section_note('groupnull.section', pairings=s.pairings, p_col=s.p_col) }}</p>
    {% if s.caveat %}<p class="qm-note">{{ s.caveat }}</p>{% endif %}
    {% if s.figures.occasions %}
    <p class="qm-note">{{ section_note('groupnull.occasions') }}</p>
    <iframe class="plot-frame" src="{{ s.figures.occasions.src }}"
            style="height:{{ s.figures.occasions.h }}px"></iframe>
    {% endif %}
    {% if s.figures.regions %}
    <p class="qm-note">{{ section_note('groupnull.regions', alpha=alpha, p_col=s.p_col) }}</p>
    <iframe class="plot-frame" src="{{ s.figures.regions.src }}"
            style="height:{{ s.figures.regions.h }}px"></iframe>
    {% endif %}
    {% if s.rows %}
    <table class="groupnull-table">
      <thead><tr>{% for c in table_columns %}<th>{{ s.p_col if c == "p" else c }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for r in s.rows %}
        <tr>{% for c in table_columns %}<td>{{ r[c] }}</td>{% endfor %}</tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
    {% if s.role_rows %}
    <p class="qm-note">{{ section_note('groupnull.rolepairs') }}</p>
    <table class="groupnull-table">
      <thead><tr>{% for c in role_columns %}<th>{{ s.p_col if c == "p" else c }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for r in s.role_rows %}
        <tr>{% for c in role_columns %}<td>{{ r[c] }}</td>{% endfor %}</tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
    <p class="fig-path"><a href="{{ s.byoccasion }}">{{ s.byoccasion }}</a>{% if s.cohort %} &bull; <a href="{{ s.cohort }}">{{ s.cohort }}</a>{% endif %}</p>
  </div>
</section>
{% endfor %}
{% endblock %}
