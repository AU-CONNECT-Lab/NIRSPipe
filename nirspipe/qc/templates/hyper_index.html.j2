{% extends "_report_base.html.j2" %}

{# Shares _index.css with the subject index: the two are the same kind of page, one over
   a subject's runs and one over a dyad's windows, and only what differs is here. #}
{% block css %}
{% include "_index.css" %}
/* the whole-run row is the average over every condition below it, so it reads as a
   heading for them rather than as one more window */
tr.whole td { background: var(--surface-alt); font-weight: 600; }
tr.whole td.num { font-weight: 600; }
.run-links { display: block; margin-top: 0.15rem; font-size: 0.75rem; }
.run-links a { color: var(--faint); font-weight: 400; margin-right: 0.55rem; }
{% endblock %}

{# Navigation only: a verdict on a dyad belongs on its raw report, not on the list of its
   windows. #}
{% set nav_modules = [nav_bar([("Windows", "Windows"), ("Rebuilt", "Rebuilt by")],
                              rated=false, summary="",
                              closing=[("Versions", "Versions")])] %}
{% set nav_chip = "group-" ~ group_id %}

{% block header %}
<div class="page-header">
  <h1>{{ page_heading }}</h1>
  <span class="subtitle">
    {{ rows | length }} window{{ "s" if rows | length != 1 }} over
    {{ n_tasks }} task{{ "s" if n_tasks != 1 }}
    {%- if subject_ids %} &bull; {{ subject_ids | join(" &times; ") }}{% endif %}
    {%- if band %} &bull; band {{ band }}{% endif %}
    &bull; v{{ versions.get('nirspipe', 'unknown') }} &bull; {{ run_date }}
  </span>
</div>
{% endblock %}

{% block content %}

<h2 id="Windows">Windows</h2>
<div class="scroll">
<table>
  <thead>
    <tr>
      <th>Window</th>
      {% if has_pairs %}<th>Pair</th>{% endif %}
      {% if has_sessions %}<th>Session</th>{% endif %}
      <th>Task</th>
      <th>Span</th>
      {% for c in chroma %}<th>WTC {{ chroma_labels[c] }}</th><th>WTC {{ chroma_labels[c] }} crossed</th>{% endfor %}
      {% if has_null %}
      {% for c in chroma %}<th>past null {{ chroma_labels[c] }}</th><th>past null {{ chroma_labels[c] }} crossed</th>{% endfor %}
      {% endif %}
      {% for c in chroma %}<th>outside COI {{ chroma_labels[c] }}</th>{% endfor %}
      {% for c in chroma %}<th>ISC {{ chroma_labels[c] }}</th><th>ISC {{ chroma_labels[c] }} crossed</th>{% endfor %}
    </tr>
  </thead>
  <tbody>
  {% for row in rows %}
    <tr{% if row.condition is none %} class="whole"{% endif %}>
      <td>
        {% if row.href %}
          <a href="{{ row.href }}">{{ row.condition or "whole run" }}</a>
        {% else %}
          {{ row.condition or "whole run" }} <span class="muted">(no page)</span>
        {% endif %}
        {% if row.links %}
        <span class="run-links">
          {% for link in row.links %}<a href="{{ link.href }}">{{ link.text }}</a>{% endfor %}
        </span>
        {% endif %}
      </td>
      {% if has_pairs %}<td>{{ row.pair or "" }}</td>{% endif %}
      {% if has_sessions %}<td>{{ row.session or "" }}</td>{% endif %}
      <td>{{ row.task }}</td>
      <td class="num">{% if row.window %}{{ row.window }}{% else %}<span class="muted">&mdash;</span>{% endif %}</td>
      {% for c in chroma %}
      {% for values, flags in ((row.coherence, row.flagged), (row.coherence_crossed, row.flagged_crossed)) %}
      <td class="num{% if flags.get(c) %} flag{% endif %}">
        {%- if c in values %}{{ "%.3f"|format(values[c]) }}
        {%- else %}<span class="muted">&mdash;</span>{% endif -%}
      </td>
      {% endfor %}
      {% endfor %}
      {% if has_null %}
      {% for c in chroma %}
      {% for counts in (row.past_null, row.past_null_crossed) %}
      <td class="num">
        {%- if c in counts %}{{ counts[c][0] }}/{{ counts[c][1] }}
        {%- else %}<span class="muted">&mdash;</span>{% endif -%}
      </td>
      {% endfor %}
      {% endfor %}
      {% endif %}
      {% for c in chroma %}
      <td class="num">
        {%- if c in row.valid_frac %}{{ "%.0f%%"|format(row.valid_frac[c] * 100) }}
        {%- else %}<span class="muted">n/a</span>{% endif -%}
      </td>
      {% endfor %}
      {% for c in chroma %}
      {% for values in (row.isc, row.isc_crossed) %}
      <td class="num">
        {%- if c in values %}{{ "%+.3f"|format(values[c]) }}
        {%- else %}<span class="muted">&mdash;</span>{% endif -%}
      </td>
      {% endfor %}
      {% endfor %}
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<p class="subtitle" style="margin-top:0.6rem;">
  {{ section_note('hyper_index.columns') }}
  {% if has_null %}
  {{ section_note('hyper_index.past_null', pct=null_percentile) }}
  {% endif %}
  {% if rows | length >= 4 %}
  {{ section_note('hyper_index.outlier', z=outlier_z) }}
  {% endif %}
</p>

<p class="subtitle">{{ section_note('hyper_index.whole_run') }}</p>

{% if run_command %}
<h2 id="Rebuilt">Rebuilt by</h2>
<p class="step-desc">{{ section_note('hyper_index.rebuilt') }}</p>
<pre>{{ run_command }}</pre>
{% endif %}

{% endblock %}
