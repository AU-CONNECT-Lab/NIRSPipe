{# Shared sticky top bar: navigation row above, rating row below, columns aligned.
   Included by _report_base.html.j2 whenever nav_modules is set; built by
   qc.report_shell.nav_bar, which owns the order the entries come in.
   Required:
     nav_modules:           list of groups; each group a list of entries, where an entry is
                            {id, name, href?, ratable?} or {sep: true} for a divider
   Optional:
     nav_chip:              text shown in the right-hand identity chip
     rating_subject:        identifier passed back to the save endpoint
     rating_save_endpoint:  POST URL for ratings (e.g. "/save_hyper_ratings")
     rating_load_endpoint:  GET URL for existing ratings (e.g. "/load_ratings")
     rating_pinned:         entries kept in a fixed block at the right edge (overall verdict)
   href defaults to "#<id>" and ratable to true, so callers that only pass {id, name}
   get a clickable anchor with a pill under it; href: false renders a plain label
   for pages with no matching anchor.
   Without the two endpoints the bar is navigation only: no pills are clickable, no state
   is fetched, and a page that summarises other pages carries it that way. With them, a
   failed fetch means the report was opened as a plain file, so the rating row is greyed
   out and a banner appears rather than the page pretending to save.
#}
<style>
{% if rating_save_endpoint %}
#rating-static-banner {
  display: none;
  background: var(--warn-soft);
  color: var(--warn);
  padding: 0.4rem 1rem;
  text-align: center;
  font-size: 0.82rem;
  border-bottom: 1px solid #e9d8a6;
}
body.rating-static-mode #rating-static-banner { display: block; }
body.rating-static-mode #qc-container .qc-module {
  pointer-events: none;
  opacity: 0.45;
  cursor: not-allowed;
}
{% endif %}

#qc-container {
  position: sticky;
  top: 0;
  z-index: 1000;
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--rule);
  user-select: none;
}
#qc-bar-scroll {
  flex: 1 1 auto;
  min-width: 0;
  overflow-x: auto;
  scrollbar-width: thin;
}
#qc-bar-scroll::-webkit-scrollbar { height: 7px; }
#qc-bar-scroll::-webkit-scrollbar-thumb { background: var(--rule); border-radius: 4px; }

/* two rows sharing one grid: nav cell and its pill always land in the same column */
.qc-grid {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: max-content;
  grid-template-rows: auto auto;
  column-gap: 4px;
  row-gap: 3px;
  padding: 5px 8px;
  width: max-content;
  min-width: 100%;
  box-sizing: border-box;
}
#qc-pinned {
  flex: 0 0 auto;
  min-width: 0;          /* .qc-grid's min-width:100% would claim the whole bar here */
  border-left: 1px solid var(--rule);
}
.qc-sep {
  grid-row: 1 / span 2;
  width: 1px;
  background: var(--rule);
  margin: 2px 7px;
}
.qc-nav-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.2rem 0.55rem;
  border-radius: 6px;
  color: var(--muted);
  font-size: 0.84rem;
  font-weight: 500;
  text-decoration: none;
  white-space: nowrap;
}
.qc-nav-cell:hover { background: var(--surface-alt); color: var(--ink); }
.qc-nav-plain { color: var(--faint); cursor: default; }
.qc-nav-plain:hover { background: none; }
.qc-pad { min-height: 1.35rem; }
.qc-module {
  display: flex;
  align-items: center;
  justify-content: center;
  justify-self: center;  /* uniform pill, centred under a label of any width */
  width: 70px;
  min-height: 1.35rem;
  border: 1px solid var(--rule);
  border-radius: 999px;
  background: var(--surface);
  cursor: pointer;
}
.qc-module .qc-icon {
  font-family: monospace;
  font-size: 15px;
  line-height: 1.1;
  color: var(--faint);
}
.qc-module.good  { background: var(--ok-soft); border-color: #a6d8b4; }
.qc-module.bad   { background: var(--bad-soft); border-color: #f1aeb5; }
.qc-module.other { background: var(--surface); border-color: var(--faint); }
.qc-module.good  .qc-icon { color: var(--ok); }
.qc-module.bad   .qc-icon { color: var(--bad); }
.qc-module.other .qc-icon { color: var(--ink); }
.qc-module.has-note { box-shadow: inset 0 -3px 0 #e3b341; }
.qc-chip {
  grid-row: 1 / span 2;
  display: flex;
  align-items: center;
  padding: 0 0.6rem;
  font-family: var(--mono);
  font-size: 0.8rem;
  color: var(--faint);
  white-space: nowrap;
}

/* ---- navigation only: one row, no pill row under it ---- */
#qc-container.qc-one-row .qc-grid { grid-template-rows: auto; padding-top: 0; padding-bottom: 0; }
#qc-container.qc-one-row .qc-nav-cell { padding: 0.75rem 0.6rem 0.7rem; }
#qc-container.qc-one-row .qc-sep { grid-row: auto; margin: 0.9rem 0.45rem; }
#qc-container.qc-one-row .qc-chip { grid-row: auto; }
#qc-container.qc-one-row .qc-pad { display: none; }

/* anchors land below the bar instead of under it */
h1[id], h2[id], h3[id], details[id] {
  scroll-margin-top: calc(var(--qc-topbar-h, 76px) + 8px);
}
</style>

{% if rating_save_endpoint %}
<div id="rating-static-banner">
  Static mode: launch via <code>nirspipe-rate</code> to load existing ratings and save changes.
</div>
{% endif %}

{# `group` marks the cells belonging to one run, for a page that holds several and shows
   one at a time. Absent on a one-run page, where there is nothing to switch between. #}
{% macro qc_cells(entries) %}
  {%- for e in entries %}
    {%- set g = (' data-qc-group="' ~ e.group ~ '"') if e.group is defined else '' %}
    {%- if e.sep %}
  <span class="qc-sep"{{ g }}></span>
    {%- else %}
    {%- if e.href is defined and not e.href %}
  <span class="qc-nav-cell qc-nav-plain"{{ g }}>{{ e.name }}</span>
    {%- else %}
  <a class="qc-nav-cell" href="{{ e.href | default('#' ~ e.id) }}"{{ g }}>{{ e.name }}</a>
    {%- endif %}
      {%- if e.ratable is not defined or e.ratable %}
  <div class="qc-module" data-mod-id="{{ e.id }}"{{ g }} title="click to rate &nbsp;+ &#8594; &#8722; &#8594; ? &nbsp;&bull;&nbsp; ctrl+click to comment"><span class="qc-icon">&#9723;</span></div>
      {%- else %}
  <div class="qc-pad"{{ g }}></div>
      {%- endif %}
    {%- endif %}
  {%- endfor %}
{% endmacro %}

{#- a page where no entry takes a pill gets a single row rather than an empty second one -#}
{%- set pills = namespace(any=false) %}
{%- for group in nav_modules %}{% for e in group %}
  {%- if not e.sep and (e.ratable is not defined or e.ratable) %}{% set pills.any = true %}{% endif %}
{%- endfor %}{% endfor %}
{%- for e in rating_pinned or [] %}
  {%- if not e.sep and (e.ratable is not defined or e.ratable) %}{% set pills.any = true %}{% endif %}
{%- endfor %}
<div id="qc-container"{% if not pills.any %} class="qc-one-row"{% endif %}>
  <div id="qc-bar-scroll">
    <div class="qc-grid">
      {%- for group in nav_modules %}
        {%- if not loop.first %}<span class="qc-sep"></span>{% endif %}
        {{ qc_cells(group) }}
      {%- endfor %}
    </div>
  </div>
  {%- if rating_pinned or nav_chip %}
  <div id="qc-pinned" class="qc-grid">
    {{ qc_cells(rating_pinned or []) }}
    {%- if nav_chip %}<span class="qc-chip">{{ nav_chip }}</span>{% endif %}
  </div>
  {%- endif %}
</div>

{% if rating_save_endpoint %}
<script>
(function() {
  var ratings       = {};
  var notes         = {};
  var participantId = {{ rating_subject | tojson }};
  var loadEndpoint  = {{ rating_load_endpoint | tojson }};
  var saveEndpoint  = {{ rating_save_endpoint | tojson }};

  var icons        = {NA: "◻", good: "+", bad: "−", other: "?"};
  var ratingStates = ["NA", "good", "bad", "other"];
  var cells = [].slice.call(document.querySelectorAll("#qc-container .qc-module"));

  function updateDisplay(el) {
    var id = el.dataset.modId;
    var s  = ratings[id] || "NA";
    el.classList.remove("good", "bad", "other");
    if (s !== "NA") el.classList.add(s);
    el.classList.toggle("has-note", !!notes[id]);
    el.querySelector(".qc-icon").textContent = icons[s];
  }

  cells.forEach(function(el) {
    el.addEventListener("click", function(e) {
      if (document.body.classList.contains("rating-static-mode")) return;
      var id = el.dataset.modId;
      if (e.ctrlKey) {
        var v = prompt('Comment for "' + id + '"', notes[id] || "");
        if (v === null) return;
        notes[id] = v.trim();
      } else {
        var idx = ratingStates.indexOf(ratings[id] || "NA");
        ratings[id] = ratingStates[(idx + 1) % ratingStates.length];
      }
      updateDisplay(el);
      save();
    });
  });

  // Existing ratings come from the rating server; a failed fetch means the report was
  // opened as a plain file, so the row is greyed out instead of pretending to save.
  fetch(loadEndpoint)
    .then(function(r) { if (!r.ok) throw new Error("load failed"); return r.json(); })
    .then(function(data) {
      Object.assign(ratings, data.ratings || {});
      Object.assign(notes,   data.notes   || {});
      cells.forEach(updateDisplay);
    })
    .catch(function() {
      document.body.classList.add("rating-static-mode");
    });

  function save() {
    fetch(saveEndpoint, {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({ratings: ratings, notes: notes, id: participantId}),
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.status !== "success") alert("Failed to save: " + (d.message || ""));
    })
    .catch(function() { alert("Network error while saving rating"); });
  }
})();
</script>
{% endif %}

<script>
(function() {
  // a page holding several runs shows one run's cells at a time; one with no groups is
  // untouched, every cell staying visible
  window.qcShowGroup = function(index) {
    var marked = document.querySelectorAll("#qc-container [data-qc-group]");
    if (!marked.length) return;
    [].forEach.call(marked, function(el) {
      el.style.display = (el.dataset.qcGroup === String(index)) ? "" : "none";
    });
    syncHeight();
  };

  function syncHeight() {
    var bar = document.getElementById("qc-container");
    document.documentElement.style.setProperty("--qc-topbar-h", bar.offsetHeight + "px");
  }
  syncHeight();
  window.addEventListener("resize", syncHeight);
})();
</script>

