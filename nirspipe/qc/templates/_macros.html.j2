{# Shared Jinja macros for QC report templates.
   Usage: {% from "_macros.html.j2" import subject_metrics %} #}

{# Per-subject quality metrics: one table, a metric per row and a member per column, with a
   block per channel set. Blocks come from hyper_report.subject_metric_tables.

   The shape and the markup are the subject report's own metrics section, down to the class
   names, so a reader moving between a subject page and a dyad page reads one table twice
   rather than two tables once.

   A set is its own measurement rather than a grouping of one, which is why it gets its own
   block: GVTD is an RMS across the channels of its set, and a long retention rate and a
   short one are fractions of different montages. A block whose `set` is empty is a page
   with nothing to split, and prints unheaded.

   Cells arrive formatted, with their colour class already chosen against the registry. No
   number is written here; see qc.boilerplate.vocabulary. #}
{% macro subject_metrics(tables) -%}
{%- set members = tables[0].members if tables else [] %}
<table class="qm-table qm-flat qm-unified">
  <colgroup><col class="lab">{% for _ in members %}<col>{% endfor %}</colgroup>
  <thead>
    <tr><th>Metric</th>{% for member in members %}<th>{{ member }}</th>{% endfor %}</tr>
  </thead>
  <tbody>
  {%- for table in tables %}
    {%- if table.set %}
    <tr class="qm-group"><td colspan="{{ members | length + 1 }}"><span class="qm-group-title">{{ table.set }} channels</span></td></tr>
    {%- endif %}
    {%- for metric in table.metrics %}
    <tr><td><span class="ql{% if metric.key_metric %} ql-key{% endif %}" title="{{ metric.summary }}"
        >{{ metric.label }}{% if metric.key_metric %}<span class="ql-dot" aria-hidden="true">&#9679;</span>{% endif %}</span></td>
      {%- for cell in metric.cells %}<td class="qv {{ cell.cls }}">{{ cell.text }}</td>{% endfor %}
    </tr>
    {%- endfor %}
  {%- endfor %}
  </tbody>
</table>
{%- endmacro %}
