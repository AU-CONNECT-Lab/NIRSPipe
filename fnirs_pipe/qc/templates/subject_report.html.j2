{% extends "_report_base.html.j2" %}

{# The sections this report actually drew, in body order; nav_bar wraps them in the
   skeleton every report shares. Rating ids carry the run label so a subject's runs do not
   file one verdict between them, and a per-condition page adds its own slug on top: it
   inherits the run's `run_label`, and without the slug a verdict on one condition
   overwrote the verdict on the page beside it. #}
{% set _rk = (("__" ~ run_label) if run_label else "")
             ~ (("__" ~ condition_slug) if condition_slug else "") %}
{% set _sections = [
  ("RawSignal", "Raw"),
  ("Signal", "SCI/PSP"),
  ("Motion", "Motion"),
  ("HbO_HbR", "HbO/HbR"),
] %}
{% if mode != 'rest' %}{% set _ = _sections.append(("Epoch", "Epoch")) %}{% endif %}
{# three independent conditions, matching the body: glm --fc and denoise --fc draw the
   FC panel too #}
{% if rest_alff_topo_path %}{% set _ = _sections.append(("RestALFF", "ALFF/fALFF")) %}{% endif %}
{% if rest_panel_path %}{% set _ = _sections.append(("RestFC", "FC")) %}{% endif %}
{% if glm_design_path or glm_activation_path %}
  {% set _ = _sections.append(("GLM", "GLM")) %}
{% endif %}
{% set _ = _sections.append(none) %}
{% set _ = _sections.append(("Metrics", "Metrics")) %}
{% if channel_summary_path %}
  {% set _ = _sections.append(("ChannelSummary", "Ch. Summary")) %}
{% endif %}
{% if trial_qc_path %}{% set _ = _sections.append(("TrialQC", "Per-trial")) %}{% endif %}
{% set _ = _sections.append(("Errors", "Errors")) %}

{# the run and its conditions are one set of pages, so each reaches any other in a click #}
{% set nav_modules = [nav_bar(_sections, key=_rk, siblings=nav_links or [],
                              index=index_href or "")] %}
{% set nav_chip = "sub-" ~ subject %}
{% set rating_subject = "sub-" ~ subject %}
{% set rating_pinned = [{"id": "Final" ~ _rk, "name": "FINAL", "href": "#Final"}] %}
{% set rating_save_endpoint = "/save_ratings" %}
{% set rating_load_endpoint = "/load_ratings/sub-" ~ subject %}

{# The subject report reads as a document, so its header is a titled band rather than the
   sticky nav bar the dashboard reports carry. #}
{% block header %}
<div class="page-header">
  <h1>{{ page_heading }}</h1>
  <span class="subtitle">v{{ versions.get('fnirs-pipe', 'unknown') }} &bull; {{ run_date }}
    {%- if run_entities %} &bull; {% for k, v in run_entities.items() %}{{ k }}-{{ v }}{{ ", " if not loop.last }}{% endfor %}{% endif %}</span>
</div>
{% endblock %}

{% block content %}

<!-- ============================================================== summary -->
<h2 id="Final">Summary</h2>
<div class="summary-box">
  <div class="summary-grid">
    <table>
      <tr><th>Subject</th><td>sub-{{ subject }}</td></tr>
      {% for key, val in (run_entities or {}).items() %}
      <tr><th>{{ {'ses': 'Session', 'task': 'Task', 'run': 'Run'}.get(key, key) }}</th><td>{{ val }}</td></tr>
      {% endfor %}
      {% if condition_label %}
      <tr><th>Scope</th><td>condition &ldquo;{{ condition_label }}&rdquo;</td></tr>
      {% endif %}
      <tr><th>Date</th><td>{{ run_date }}</td></tr>
      <tr><th>fnirs-pipe</th><td>v{{ versions.get('fnirs-pipe', 'n/a') }}</td></tr>
      <tr><th>MNE</th><td>v{{ versions.get('mne', 'n/a') }}</td></tr>
      <tr><th>Python</th><td>{{ versions.get('python', 'n/a') }}</td></tr>
    </table>
    <table>
      <tr>
        <th>Bad channels</th>
        <td><span class="{{ badge_class }}">{{ n_bad }}/{{ n_total }} ({{ "%.0f"|format(bad_rate) }}%)</span></td>
      </tr>
      <tr><th>SCI threshold</th><td>{{ config.sci_threshold }}</td></tr>
      <tr><th>Motion corr.</th><td>{{ config.motion_correction }}</td></tr>
      <tr><th>DPF</th><td>{{ config.dpf | join(', ') }}</td></tr>
    </table>
  </div>
  {% if bad_channels %}
  <p style="margin: 0.75rem 0 0; font-size:0.85rem;">
    <strong>Bad channels:</strong> {{ bad_channels | join(', ') }}
  </p>
  {% endif %}
  {% if condition_label %}
  {#- a per-condition page leaves several sections empty, and an empty section with no
      explanation reads as a broken report; it belongs to Summary rather than above it -#}
  <p class="qm-note" style="margin-top:0.75rem;">
    {{ section_note('summary.condition_scope') }}
    {% if epoch_preview_path %}{{ section_note('summary.condition_rebuilt') }}{% else %}{{ section_note('summary.condition_empty') }}{% endif %}
    {%- if not (trial_qc_path or trial_image_pairs or trial_image_roi_pairs) %}
    {{ section_note('summary.condition_no_trials',
                    reason=condition_trial_reason or section_note('summary.condition_few_trials')) }}
    {%- endif %}
    {% if index_href %}{{ section_note('summary.condition_run_link', href=index_href) }}{% endif %}
  </p>
  {% endif %}
  <h3 style="margin-top:1rem;">Run command</h3>
  <pre>{{ run_command }}</pre>
  {% if filled_by %}
  <p class="step-desc">Not on the command line:
    {% for source, items in filled_by -%}
    {{ source }} set {% for arg, val in items -%}
    <code>--{{ arg | replace('_', '-') }} {{ val }}</code>{{ ', ' if not loop.last }}
    {%- endfor %}{{ '; ' if not loop.last else '.' }}
    {% endfor -%}
  </p>
  {% endif %}
</div>

<!-- ======================================================= preprocessing -->
<h2>Preprocessing</h2>

<!-- step a: Raw Signal -->
<details id="RawSignal" open>
  <summary>a. Raw Signal</summary>
  <div class="details-body">
    <p class="step-desc">{{ section_note('steps.raw_signal', stage=channel_detail_stage or 'desc-sci',
        dpf=config.dpf | join(', '), motion=config.motion_correction) }}
      {%- if channel_detail_stage == 'desc-preproc' %} {{ section_note('steps.raw_signal_fallback') }}{% endif %}</p>

    {% if channel_pairs %}
    <h3>Per-channel HbO / HbR &amp; PSD</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">{{ section_note('channel_detail.picker') }}</p>
    <select class="ch-select"
            onchange="document.getElementById('ch-det-frame').src=this.value">
      {% for ch in channel_pairs %}
      <option value="{{ ch.path }}">{{ ch.label or ch.pair }}</option>
      {% endfor %}
    </select>
    <iframe id="ch-det-frame" class="plotly-frame"
            src="{{ channel_pairs[0].path }}"
            style="height:{{ channel_pairs[0].h + 20 }}px;"></iframe>
    {% else %}
    <div class="placeholder">Channel detail not available.</div>
    {% endif %}
  </div>
</details>

<!-- step b: SCI / PSP quality panels -->
<details id="Signal" open>
  <summary>b. Raw Signal Quality (SCI / PSP / CV / Short Channel)</summary>
  <div class="details-body">
    <p class="step-desc">{{ section_note('steps.raw_quality', cv='%.3f'|format(cv_threshold), sci=config.sci_threshold) }}</p>

    {% if sci_psp_panel_path %}
      <iframe class="plotly-frame" src="{{ sci_psp_panel_path }}" title="SCI/PSP panel"
              style="height:{{ sci_psp_panel_h }}px"></iframe>
      <p class="fig-path">{{ sci_psp_panel_path }}</p>
    {% else %}
      <div class="placeholder">SCI/PSP panel not available.</div>
    {% endif %}

    {% if brain_views_path %}
      <h3>Channel quality: 3D &amp; optode map</h3>
      <p style="font-size:0.82rem; color:#666; margin:0 0 0.3rem;">{{ section_note('quality.brain_views') }}
        {%- if condition_label %} {{ section_note('quality.brain_views_condition') }}{% endif %}</p>
      <img class="responsive" src="{{ brain_views_path }}" alt="Brain views + optode" />
      <p class="fig-path">{{ brain_views_path }}</p>
    {% endif %}

  </div>
</details>

<!-- step c: motion correction -->
<details id="Motion" open>
  <summary>c. Motion Correction</summary>
  <div class="details-body">
    <p class="step-desc">{{ section_note('steps.motion_correction', method=config.motion_correction, gvtd_set=gvtd_set or 'long') }}</p>
    {% if carpet_gvtd_path %}
      <h3>GVTD + Carpet plot</h3>
      <iframe class="plotly-frame" src="{{ carpet_gvtd_path }}" title="GVTD + Carpet plot"
              style="height:{{ carpet_gvtd_h }}px"></iframe>
      <p class="fig-path">{{ carpet_gvtd_path }}</p>
    {% else %}
      <div class="placeholder">GVTD + Carpet not available.</div>
    {% endif %}
    {% if bad_segment_zoom_path %}
      <h3>Bad segment zoom: top segments by duration</h3>
      <img src="{{ bad_segment_zoom_path }}" alt="Bad segment zoom" />
      <p class="fig-path">{{ bad_segment_zoom_path }}</p>
    {% endif %}

    {% if motion_detail_pairs %}
    <h3>Per-channel before / after motion correction</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">{{ section_note('motion_detail.picker') }}
      {%- if condition_label %} {{ section_note('motion_detail.condition') }}{% endif %}</p>
    <select class="ch-select"
            onchange="document.getElementById('mot-det-frame').src=this.value">
      {% for ch in motion_detail_pairs %}
      <option value="{{ ch.path }}">{{ ch.pair }}</option>
      {% endfor %}
    </select>
    <iframe id="mot-det-frame" class="plotly-frame"
            src="{{ motion_detail_pairs[0].path }}"
            style="height:{{ motion_detail_pairs[0].h + 20 }}px;"></iframe>
    {% endif %}
  </div>
</details>

<!-- step d: HbO / HbR -->
<details id="HbO_HbR" open>
  <summary>d. HbO / HbR (Beer-Lambert)</summary>
  <div class="details-body">
    <p class="step-desc">{{ section_note('steps.beer_lambert', dpf=config.dpf | join(', ')) }}</p>
    <h3>HbO–HbR Correlation</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">{{ section_note('haemo.hbo_hbr_corr') }}</p>
    {% if mode == 'glm' %}
      <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">{{ section_note('haemo.glm_residual') }}</p>
    {% endif %}
    {% if hbo_hbr_path %}
      <iframe class="plotly-frame" src="{{ hbo_hbr_path }}" title="HbO–HbR correlation panel, before and after denoising"
              style="height:{{ hbo_hbr_h }}px"></iframe>
      <p class="fig-path">{{ hbo_hbr_path }}</p>
    {% else %}
      <div class="placeholder">Figure generation failed; see Errors section.</div>
    {% endif %}


    {% if carpet_panels %}
      <h3>Carpet after denoising</h3>
      <p class="step-desc">{{ section_note('carpet.after',
        stage=('<code>' ~ carpet_stage_labels[0] ~ '</code>') if carpet_stage_labels
              else section_note('carpet.last_stage')) }}
        {%- if mode == 'glm' %} {{ section_note('carpet.glm') }}{% endif %}
        {%- if condition_label %} {{ section_note('carpet.condition') }}{% endif %}</p>
      {% for panel in carpet_panels %}
        <iframe class="plotly-frame" src="{{ panel.path }}"
                title="Carpet after denoising"
                style="height:{{ panel.h }}px"></iframe>
        <p class="fig-path">{{ panel.path }}</p>
      {% endfor %}
    {% endif %}
  </div>
</details>

<!-- step e: PSD -->
<details open>
  <summary>e. Power Spectral Density by stage</summary>
  <div class="details-body">
    {#- Mayer alone is a fixed visual reference with no metric behind it; the other two bands
    are the configured ones the shading and the band scalars both use -#}
    <p class="step-desc">{{ section_note('psd.stages', bands=
        (section_note('psd.band_resp', lo='%g'|format(psd_resp_band[0]), hi='%g'|format(psd_resp_band[1]))
         if psd_resp_band else '')
        ~ (section_note('psd.band_cardiac', lo='%g'|format(psd_cardiac_band[0]), hi='%g'|format(psd_cardiac_band[1]))
           if psd_cardiac_band else '')) }}
      {% if psd_stage_labels %}
        {{ section_note('psd.stage_list', stages='<code>' ~ psd_stage_labels | join('</code>, <code>') ~ '</code>') }}
        {% if 'desc-errts' in psd_stage_labels %}{{ section_note('psd.errts') }}{% endif %}
      {% else %}
        {{ section_note('psd.simulated') }}
      {% endif %}
    </p>
    {% if psd_panel_path %}
      <iframe class="plotly-frame" src="{{ psd_panel_path }}" title="PSD panel" style="height:{{ psd_panel_h }}px"></iframe>
      <p class="fig-path">{{ psd_panel_path }}</p>
    {% elif psd_too_short %}
      <div class="placeholder">{{ section_note('psd.too_short',
        holder=('&ldquo;' ~ condition_label ~ '&rdquo;') if condition_label
               else section_note('psd.this_cut')) }}</div>
    {% else %}
      <div class="placeholder">Figure generation failed; see Errors section.</div>
    {% endif %}

    {% if psd_detail_pairs %}
    <h3>Per-channel PSD by stage</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">{{ section_note('psd_detail.picker') }}</p>
    <select class="ch-select"
            onchange="document.getElementById('psd-det-frame').src=this.value">
      {% for ch in psd_detail_pairs %}
      <option value="{{ ch.path }}">{{ ch.pair }}</option>
      {% endfor %}
    </select>
    <iframe id="psd-det-frame" class="plotly-frame"
            src="{{ psd_detail_pairs[0].path }}"
            style="height:{{ psd_detail_pairs[0].h + 20 }}px;"></iframe>
    {% endif %}
  </div>
</details>

<!-- step f: Epoch / HRF preview (task/GLM mode only) -->
{% if mode != 'rest' %}
<details id="Epoch" open>
  <summary>f. Epoch / HRF Preview (grand mean)</summary>
  <div class="details-body">
    {% if trigger_timeline_path %}
    <h3>Event timeline</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">{{ section_note('epoch.timeline') }}
      {%- if condition_label %} {{ section_note('epoch.timeline_condition', label=condition_label) }}{% endif %}</p>
    <iframe class="plotly-frame" src="{{ trigger_timeline_path }}" title="Event timeline"
            style="height:{{ trigger_timeline_h }}px"></iframe>
    <p class="fig-path">{{ trigger_timeline_path }}</p>
    <h3>Grand mean</h3>
    {% endif %}
    <p class="step-desc">{{ section_note('epoch.grand_mean') }}</p>
    {% if epoch_preview_path %}
      <iframe class="plotly-frame" src="{{ epoch_preview_path }}" title="Epoch preview" style="height:{{ epoch_preview_h }}px"></iframe>
      <p class="fig-path">{{ epoch_preview_path }}</p>
    {% else %}
      <div class="placeholder">No stimulus events found, so the epoch preview is not available.</div>
    {% endif %}

    {% if evoked_topomap_path %}
    <h3>Channel maps</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">{{ section_note('epoch.channel_maps') }}</p>
    <iframe class="plotly-frame" src="{{ evoked_topomap_path }}" title="Evoked channel maps"
            style="height:{{ evoked_topomap_h }}px"></iframe>
    <p class="fig-path">{{ evoked_topomap_path }}</p>
    {% endif %}

    {% if trial_image_roi_pairs %}
    <h3>Trial image: ROI (channel-averaged)</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">{{ section_note('epoch.trial_image_roi') }}</p>
    <select class="ch-select"
            onchange="document.getElementById('trialimg-roi-frame').src=this.value">
      {% for roi in trial_image_roi_pairs %}
      <option value="{{ roi.path }}">{{ roi.pair }}</option>
      {% endfor %}
    </select>
    <iframe id="trialimg-roi-frame" class="plotly-frame"
            src="{{ trial_image_roi_pairs[0].path }}"
            style="height:{{ trial_image_roi_pairs[0].h + 20 }}px;"></iframe>
    {% endif %}

    {% if trial_image_pairs %}
    <h3>Trial image: single-channel trials</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">{{ section_note('epoch.trial_image_single') }}</p>
    <select class="ch-select"
            onchange="document.getElementById('trialimg-frame').src=this.value">
      {% for ch in trial_image_pairs %}
      <option value="{{ ch.path }}">{{ ch.pair }}</option>
      {% endfor %}
    </select>
    <iframe id="trialimg-frame" class="plotly-frame"
            src="{{ trial_image_pairs[0].path }}"
            style="height:{{ trial_image_pairs[0].h + 20 }}px;"></iframe>
    {% endif %}
  </div>
</details>
{% endif %}

<!-- ======================================================= postprocessing -->
<h2 id="Postprocessing">Postprocessing</h2>

{% if mode == 'rest' %}
<!-- Resting-state results -->
<details id="RestALFF" {% if rest_alff_topo_path %}open{% endif %}>
  <summary>ALFF / fALFF</summary>
  <div class="details-body">
    <p class="step-desc">{{ section_note('rest.alff') }}</p>
    {% if rest_alff_topo_path %}
      <p class="step-desc">{{ section_note('rest.alff_layout') }}</p>
      <iframe class="plotly-frame" src="{{ rest_alff_topo_path }}" title="ALFF / fALFF topography"
              style="height:{{ rest_alff_topo_h }}px"></iframe>
      <p class="fig-path">{{ rest_alff_topo_path }}</p>
    {% else %}
      <div class="placeholder">ALFF not computed: --high-pass and --low-pass are required.</div>
    {% endif %}
  </div>
</details>
{% endif %}

{% if mode == 'rest' or rest_panel_path %}
<details id="RestFC" {% if rest_panel_path %}open{% endif %}>
  <summary>Functional Connectivity</summary>
  <div class="details-body">
    <p class="step-desc">{{ section_note('fc.channel_matrix') }}</p>
    {% if rest_panel_path %}
      <iframe class="plotly-frame" src="{{ rest_panel_path }}"
              title="Connectivity, amplitude and spectral share per channel"
              style="height:{{ rest_panel_h }}px"></iframe>
      <p class="fig-path">{{ rest_panel_path }}</p>
    {% else %}
      <div class="placeholder">FC matrix not available.</div>
    {% endif %}
    {% if rest_fc_roi_path %}
      <h3>ROI to ROI</h3>
      <p class="step-desc">{{ section_note('fc.roi_matrix') }}</p>
      <iframe class="plotly-frame" src="{{ rest_fc_roi_path }}" title="ROI-to-ROI connectivity matrix"
              style="height:{{ rest_fc_roi_h }}px"></iframe>
      <p class="fig-path">{{ rest_fc_roi_path }}</p>
    {% endif %}
    {% if rest_fc_seed_path %}
      <h3>Seed topography</h3>
      <p class="step-desc">{{ section_note('fc.seed_topography') }}</p>
      <iframe class="plotly-frame" src="{{ rest_fc_seed_path }}" title="Seed-to-whole-brain topography"
              style="height:{{ rest_fc_seed_h }}px"></iframe>
      <p class="fig-path">{{ rest_fc_seed_path }}</p>
    {% endif %}
  </div>
</details>
{% endif %}

{% if mode != 'rest' %}
<details id="GLM" {% if glm_design_path or glm_betas_html or glm_activation_path %}open{% endif %}>
  <summary>GLM</summary>
  <div class="details-body">
    {% if glm_design_path or glm_design_heatmap_path %}
      <h3>Design matrix</h3>
      {% if glm_design_path %}
        <img class="responsive" src="{{ glm_design_path }}" alt="Design matrix: regressor time series" />
        <p class="fig-path">{{ glm_design_path }}</p>
      {% endif %}
      {% if glm_design_heatmap_path %}
        <img class="responsive" src="{{ glm_design_heatmap_path }}" alt="Design matrix: heatmap" style="margin-top:0.5rem;" />
        <p class="fig-path">{{ glm_design_heatmap_path }}</p>
      {% endif %}
    {% else %}
      <div class="placeholder">Design matrix not available: pass design_matrix to build_subject_report.</div>
    {% endif %}

    {% if glm_activation_conditions %}
      <h3>Activation by condition</h3>
      <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">{{ section_note('glm.activation') }}</p>
      {% if glm_activation_conditions | length > 1 %}
      <select class="ch-select"
              onchange="document.getElementById('glm-activation-img').src=this.value;
                        document.getElementById('glm-activation-path').textContent=this.value;">
        {% for cond in glm_activation_conditions %}
        <option value="{{ cond.path }}">{{ cond.label }}</option>
        {% endfor %}
      </select>
      {% endif %}
      <img id="glm-activation-img" src="{{ glm_activation_conditions[0].path }}"
           alt="Activation by condition" style="max-width:100%;display:block;" />
      <p class="fig-path" id="glm-activation-path">{{ glm_activation_conditions[0].path }}</p>
    {% elif glm_activation_path %}
      <h3>Activation by condition</h3>
      <img src="{{ glm_activation_path }}" alt="Activation by condition" style="max-width:100%;" />
      <p class="fig-path">{{ glm_activation_path }}</p>
    {% endif %}

  </div>
</details>

{% endif %}

<!-- ================================================= quantitative metrics -->
{#- Number formats, colour cutoffs and tooltips all come from the metric registry in
    fnirs_pipe.qc.boilerplate.vocabulary, which the raw viewer and the GUI read as well, so
    a threshold moves in one place instead of once per renderer. Only the labels are
    written here, where a header has room to say more than a registry default can. -#}
{#- label + hover text from the metric registry; a marker on the ones that decide usability -#}
{% macro ql(key, text) %}<span class="ql{% if is_key_metric(key) %} ql-key{% endif %}"
      title="{{ metric_summary(key) }}">{{ text }}{% if is_key_metric(key) %}<span class="ql-dot" aria-hidden="true">&#9679;</span>{% endif %}</span>{% endmacro %}

{% macro mv(key, v, fmt=none) %}{% if v is not none %}{{ format_metric(key, v, fmt) }}{% else %}<span style="color:#aaa">n/a</span>{% endif %}{% endmacro %}

{#- One metric as a list row. ``suffix`` names the second half of a before → after pair
    (``_post``, ``_errts``); the colour is read off whichever value is the later one, since
    a metric's verdict is what the run ended up with, and comes back empty for the metrics
    the registry has no cutoff for. -#}
{% macro qm_li(key, text, suffix='', note='') %}
    {%- set after = sqm.get(key ~ suffix) if suffix else none -%}
    <li>{{ ql(key, text ~ (note if after is not none else '')) }}
        <span class="qv {{ metric_class(key, after if after is not none else sqm.get(key)) }}">
          {%- if after is not none %}{{ mv(key, sqm.get(key)) }} &rarr; {{ mv(key, after) }}{% else %}{{ mv(key, sqm.get(key)) }}{% endif -%}
        </span></li>
{%- endmacro %}

{#- The same row as table cells. ``suffix`` names the second half of a before -> after pair;
    a metric that has no pair gets one cell across both value columns, so a lone number is
    never read as the after side of something that was not measured twice. -#}
{% macro qm_tr_pair(key, text, suffix='', note='') %}
    {%- set after = sqm.get(key ~ suffix) if suffix else none -%}
    <tr><td>{{ ql(key, text ~ (note if after is not none else '')) }}</td>
    {%- if after is not none -%}
      <td class="qv">{{ mv(key, sqm.get(key)) }}</td><td class="qv {{ metric_class(key, after) }}">{{ mv(key, after) }}</td>
    {%- else -%}
      <td class="qv {{ metric_class(key, sqm.get(key)) }}" colspan="2">{{ mv(key, sqm.get(key)) }}</td>
    {%- endif -%}
    </tr>
{%- endmacro %}

{% macro qm_tr(key, text) %}
    <tr><td>{{ ql(key, text) }}</td>
        <td class="qv {{ metric_class(key, sqm.get(key)) }}">{{ mv(key, sqm.get(key)) }}</td></tr>
{%- endmacro %}

<h2 id="Metrics">Quantitative Metrics</h2>
<div class="qm-box">
  {#- Everything that is per-metric is in the hover text, which comes from the registry; the
      notes here carry only what a single metric's tooltip cannot say. -#}
  <p class="qm-note">{{ section_note('metrics.intro') }}</p>
  {% if sqm_long and not sqm_split %}
  <p class="qm-note">{{ section_note('metrics.long_only') }}</p>
  {% endif %}

  {% if sqm_split %}
  {#- this help is about the Channel set column rather than about any one metric, so it
      hangs off that column's header -#}
  {%- set set_help = section_note('metrics.set_help')
      ~ (' ' ~ section_note('metrics.set_help_condition') if condition_label else '') %}

  {#- one column per metric, one row per channel set. Both halves are measured before
      denoising, so they share one table; the domain changes at the divider, and the two
      halves come from different records, hence the two dicts per row. -#}
  {#- the OD columns come from fnirs_pipe.qc.channel_table, so this table and the raw
      viewer's cannot end up listing different metrics for the same recording -#}
  {%- set od_cols = od_split_columns %}
  {%- set hb_cols = [('hbo_hbr_corr_mean', 'HbO&ndash;HbR corr'),
                     ('gcor_hbo', 'Global corr HbO'),
                     ('gcor_hbr', 'Global corr HbR')]
                    + ([('cnr_hbo_mean', 'CNR HbO'), ('cnr_hbr_mean', 'CNR HbR')]
                       if hb_split and hb_all.get('cnr_hbo_mean') is not none else [])
                    + [('cardiac_band_frac_hbo', 'Cardiac band (HbO)')]
                    + ([] if condition_label
                       else [('lowfreq_drift_amplitude_hbo', 'Low-freq drift (HbO)')]) %}
  {#- colour is read off the long channels alone, and only where the registry has a cutoff -#}
  {%- macro cell_class(key, v, is_long) %}{% if is_long %}{{ metric_class(key, v) }}{% endif %}{% endmacro -%}
  {%- macro qm_cells(d, cols, is_long) %}{% for key, text in cols %}{% set v = d.get(key) %}<td class="qv {{ cell_class(key, v, is_long) }}">{{ mv(key, v) }}</td>{% endfor %}{% endmacro -%}
  {#- ``lead`` is the channel count, which only the optical-density table carries -#}
  {%- macro qm_row(name, d, cols, is_long, lead=none) %}<tr><td>{{ name }}</td>{% if lead is not none %}<td>{{ lead }}</td>{% endif %}{{ qm_cells(d, cols, is_long) }}</tr>{% endmacro -%}
  {#- one table per signal domain, so a reader has no join to find and each table gets the
      column spacing of its own content -#}
  <h3 class="qm-sub">Original recording: optical density</h3>
  <div style="overflow-x:auto;">
  <table class="qm-table qm-split qm-flat">
    <thead>
      <tr><th><span class="ql" title="{{ set_help }}">Channel set</span></th><th>Channels</th>
          {%- for key, text in od_cols %}<th>{{ ql(key, text) }}</th>{% endfor %}</tr>
    </thead>
    <tbody>
      {{ qm_row('All', sqm_all, od_cols, false, channel_rows | length) }}
      {{ qm_row('Long', sqm_long, od_cols, true, sqm.get('n_long_channels') if sqm.get('n_long_channels') is not none else '—') }}
      {{ qm_row('Short', sqm_short, od_cols, false, sqm.get('n_short_channels') if sqm.get('n_short_channels') is not none else '—') }}
    </tbody>
  </table>
  </div>
  {% if hb_split %}
  <h3 class="qm-sub">Haemoglobin: before denoising</h3>
  <div style="overflow-x:auto;">
  <table class="qm-table qm-split qm-flat">
    <thead>
      <tr><th><span class="ql" title="{{ set_help }}">Channel set</span></th>
          {%- for key, text in hb_cols %}<th>{{ ql(key, text) }}</th>{% endfor %}</tr>
    </thead>
    <tbody>
      {{ qm_row('All', hb_all, hb_cols, false) }}
      {{ qm_row('Long', hb_long, hb_cols, true) }}
      {{ qm_row('Short', hb_short, hb_cols, false) }}
    </tbody>
  </table>
  </div>
  {% endif %}
  {% else %}
  <ul class="qm-list">
    {{ qm_li('channel_retention_rate', 'Channel retention') }}
    {{ qm_li('sci_win_mean', 'Mean SCI (10 s windows)') }}
    {{ qm_li('sci_mean', 'Mean SCI (whole run)') }}
    {{ qm_li('good_frac_mean', 'Coupled windows') }}
    {{ qm_li('psp_mean', 'Mean PSP (10 s windows)') }}
    {{ qm_li('snr_mean', 'Mean SNR (intensity, 10 s)') }}
    {{ qm_li('cv_mean', 'Mean CV (intensity, 10 s)') }}
  </ul>
  {% endif %}

  {% if stage_metrics_path %}
  <h3 class="qm-sub">What each denoising step did</h3>
  <p class="qm-note">
    {{ section_note('metrics.stages') }}
    {% if stage_banded %}{{ section_note('metrics.stages_banded') }}{% else %}{{ section_note('metrics.stages_unbanded') }}{% endif %}
    {{ section_note('metrics.stages_greyed') }}
  </p>
  <iframe class="plotly-frame" src="{{ stage_metrics_path }}"
          title="Metrics by denoising stage"
          style="height:{{ stage_metrics_h }}px"></iframe>
  <p class="fig-path">{{ stage_metrics_path }}</p>
  {% endif %}

  <h3 class="qm-sub">Motion and spikes</h3>
  <p class="qm-note">{% if motion_split %}{{ section_note('metrics.motion_split') }}
     {%- else %}{{ section_note('metrics.motion_unsplit',
         channels=section_note('channels.long_only') if gvtd_channel_set == 'long'
                  else section_note('channels.every')) }}{% endif %}</p>
  {%- set motion_note = ' (motion before&rarr;after)' %}
  {#- the GVTD threshold is explained by the gvtd_thresh tooltip, not a paragraph here -#}
  {#- A condition has one side of the motion step rather than both, and the two sides are
      not the same side for every row: the GVTD series is stored off the corrected file and
      the spike and footprint spans off the uncorrected one. So each row says which stage it
      is, where the run's page says it once with an arrow. -#}
  {%- set after_note  = ' (after correction)' if condition_label else '' %}
  {%- set before_note = ' (before correction)' if condition_label else '' %}
  {% if condition_label %}
  <p class="qm-note">{{ section_note('metrics.motion_one_side') }}</p>
  {% endif %}

  {#- The motion families over the three channel sets. Nearly all of these measure a set
      rather than regroup per-channel numbers, which is why they are here rather than as
      columns of the table above: that table's rows are groupings of per-channel numbers. -#}
  {% if motion_split %}
  <p class="qm-note">{{ section_note('metrics.gvtd_sets') }}</p>
  {%- set gvtd_set_help = section_note('metrics.gvtd_set_help') %}
  {#- from fnirs_pipe.qc.channel_table, so this table and the raw viewer's cannot end up
      listing different metrics for the same recording -#}
  {%- set motion_rows = motion_split_columns %}
  {%- macro motion_cell(d, key, is_long) %}
    {%- set before = d.get(key) %}{% set after = d.get(key ~ '_post') -%}
    <td class="qv {{ metric_class(key, after if after is not none else before) if is_long }}">
      {%- if before is none and after is none %}<span style="color:#aaa">&mdash;</span>
      {%- elif after is none %}{{ mv(key, before) }}
      {%- else %}{{ mv(key, before) }} &rarr; {{ mv(key, after) }}{% endif -%}
    </td>
  {%- endmacro %}
  {#- channel set per row and metric per column, the way the two tables above read. The
      threshold is dropped as a column on a condition page, where it has no value -#}
  {%- set motion_cols = [] %}
  {%- for key, text in motion_rows %}
  {%- if not (condition_label and key == 'gvtd_thresh') %}{{ motion_cols.append((key, text)) or '' }}{% endif %}
  {%- endfor %}
  <div style="overflow-x:auto;">
  <table class="qm-table qm-split qm-flat">
    <thead><tr><th><span class="ql" title="{{ gvtd_set_help }}">Channel set</span>{% if not condition_label %} (before&nbsp;&rarr;&nbsp;after){% endif %}</th>
      {%- for key, text in motion_cols %}<th>{{ ql(key, text) }}</th>{% endfor %}</tr></thead>
    <tbody>
      {% for name, set_key, is_long in [('All', 'all', false), ('Long', 'long', true),
                                        ('Short', 'short', false)] %}
      <tr><td>{{ name }}</td>
          {%- for key, text in motion_cols %}{{ motion_cell(motion_sets.get(set_key) or {}, key, is_long) }}{% endfor %}</tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <ul class="qm-list">
    {{ qm_li('gvtd_mean', 'GVTD mean' ~ after_note, '_post', motion_note) }}
    {{ qm_li('gvtd_p95', 'GVTD p95' ~ after_note, '_post', motion_note) }}
    {{ qm_li('gvtd_filt_mean', 'GVTD mean 0.01-0.5 Hz' ~ after_note, '_post', motion_note) }}
    {{ qm_li('gvtd_filt_p95', 'GVTD p95 0.01-0.5 Hz' ~ after_note, '_post', motion_note) }}
    {{ qm_li('gvtd_pct_above_thresh', 'GVTD % motion' ~ after_note, '_post', motion_note) }}
    {{ qm_li('gvtd_num_above_thresh', 'GVTD motion frames' ~ after_note, '_post', motion_note) }}
    {% if not condition_label %}
    {{ qm_li('gvtd_thresh', 'GVTD threshold', '_post', motion_note) }}
    {% endif %}
  </ul>
  {% endif %}

  {#- What the table above has no column for. Everything with a channel-set meaning moved
      into it; what is left is censoring, which names its own set, and `spike_count`, a sum
      over channels that would only track how many a set has. A montage that did not split
      has no table, so the whole list stays here. -#}
  {%- set flat_censor = sqm.get('gvtd_censor_pct') is not none %}
  {% if flat_censor or not motion_split or not condition_label %}
  <p class="qm-note">
     {%- if motion_split %}{{ section_note('metrics.motion_extra_split') }}
     {%- else %}{{ section_note('metrics.motion_extra_unsplit',
         channels='<b>' ~ section_note('channels.long') ~ '</b>' if gvtd_channel_set == 'long'
                  else section_note('channels.every')) }}{% endif %}</p>
  <table class="qm-table qm-split qm-narrow qm-flat">
    <thead><tr><th>Metric</th><th>Value</th></tr></thead>
    <tbody>
    {% if flat_censor %}
    {#- censoring names its own set: `--gvtd-censor` picks it, so it need not be the long one -#}
    {{ qm_tr('gvtd_censor_pct', 'GVTD censored % (' ~ (sqm.get('gvtd_censor_channel_set') or 'long')
                                ~ ' channels, n_std ' ~ sqm.get('gvtd_censor_n_std') ~ ')') }}
    {{ qm_tr('gvtd_censor_retained_s', 'GVTD retained (s in ' ~ sqm.get('gvtd_censor_n_epochs') ~ ' epoch(s))') }}
    {% endif %}
    {% if not motion_split and sqm.get('motion_corrected_pct') is not none %}
    {{ qm_tr('motion_corrected_pct', 'Motion corrected % (exp.)') }}
    {{ qm_tr('motion_corrected_num', 'Motion corrected frames') }}
    {{ qm_tr('motion_corrected_n_segments', 'Motion corrected segments') }}
    {% endif %}
    {% if not condition_label %}
    {{ qm_tr('spike_count', 'Spike count') }}
    {% endif %}
    {% if not motion_split %}
    {{ qm_tr('spike_pct_frames', 'Spike % frames' ~ before_note) }}
    {{ qm_tr('spike_num_frames', 'Spike frames' ~ before_note) }}
    {% endif %}
    {% if not sqm_split and sqm.get('spike_pct') is not none %}
    {{ qm_tr('spike_pct', 'Spike % (exp.)') }}
    {% endif %}
    </tbody>
  </table>
  {% endif %}

  <h3 class="qm-sub">Haemoglobin and timing</h3>
  <p class="qm-note">{{ section_note('metrics.haemo_timing',
     channels=section_note('channels.long') if hb_split else section_note('channels.every')) }}</p>
  {#- the parenthetical on a row names which step its two columns straddle, since the
      global correlations straddle the confound regression and the rest the denoising -#}
  <table class="qm-table qm-split qm-narrow qm-flat">
    <thead><tr><th>Metric</th><th>Before</th><th>After</th></tr></thead>
    <tbody>
    {{ qm_tr_pair('hbo_hbr_corr_mean', 'Mean HbO&ndash;HbR corr', '_errts', ' (denoising)') }}
    {% if sqm.get('cnr_hbo_mean') is not none or sqm.get('cnr_hbo_mean_errts') is not none %}
    {% for chroma, key in [('HbO', 'cnr_hbo_mean'), ('HbR', 'cnr_hbr_mean')] %}
    {{ qm_tr_pair(key, 'CNR ' ~ chroma
                  ~ (', %d epochs'|format(sqm.get('cnr_n_epochs')) if sqm.get('cnr_n_epochs') else ''),
                  '_errts', ' (denoising)') }}
    {% endfor %}
    {% endif %}
    {#- the regression's own before/after, which is stored under its own two keys rather
        than as a suffix on gcor_hbo, so it does not go through qm_tr_pair -#}
    {% for chroma, key in [('HbO', 'gcor_hbo'), ('HbR', 'gcor_hbr')] %}
    {% set reg_after = sqm.get(key ~ '_postreg') %}
    <tr><td>{{ ql(key, 'Global corr ' ~ chroma ~ (' (regression)' if reg_after is not none else '')) }}</td>
      {%- if reg_after is not none -%}
        <td class="qv">{{ mv(key, sqm.get(key ~ '_prereg')) }}</td><td class="qv">{{ mv(key, reg_after) }}</td>
      {%- else -%}
        <td class="qv" colspan="2">{{ mv(key, sqm.get(key)) }}</td>
      {%- endif -%}
    </tr>
    {% endfor %}
    {{ qm_tr_pair('pct_data_retained', '% data retained') }}
    {{ qm_tr_pair('cardiac_band_power_hbo', 'Cardiac band power (HbO)') }}
    {{ qm_tr_pair('cardiac_band_frac_hbo', 'Cardiac band fraction (HbO)') }}
    {% if not condition_label %}
    {{ qm_tr_pair('lowfreq_drift_amplitude_hbo', 'Low-freq drift (HbO)') }}
    {% endif %}
    </tbody>
  </table>
  {% if condition_label %}
  <p class="qm-note">{{ section_note('metrics.no_drift') }}</p>
  {% endif %}

</div>

{% if channel_rows %}
<!-- ------------------------------------------ per-channel, its own panel -->
<h3 class="qm-sub qm-panel-title">Per-channel metrics</h3>
<div class="qm-box">
  {#- columns, values and cell classes all come pre-formatted from
      fnirs_pipe.qc.channel_table, so this table, the raw viewer's and the GUI's list the
      same things left to right and print one number one way, and the SCI column is marked
      against the run's own --sci-threshold rather than a copy of it -#}
  {% macro ch_row(row) %}
      <tr>
        {%- for key, _label in channel_columns %}
        <td class="{{ row.get(key ~ '_cls', '') }}">{{ row[key] }}</td>
        {%- endfor %}
      </tr>
  {% endmacro %}
  {#- the montage split, long first, grouped by fnirs_pipe.qc.channel_table so this table
      and the raw views block their channels the same way. An unsplit record comes back as
      one block, which is what a montage of one kind looks like. -#}
  {% set n_blocks = channel_blocks | length %}
  {% if n_blocks > 1 %}
  <p class="qm-note">{{ section_note('metrics.per_channel') }}</p>
  {% endif %}
  <div style="overflow-x:auto;">
    <table class="qm-table">
      <thead>
        <tr>
          {%- for _key, label in channel_columns %}<th>{{ label }}</th>{% endfor %}
        </tr>
      </thead>
      {% if n_blocks > 1 %}
      {% for title, rows in channel_blocks %}
      <tbody>
        <tr><td colspan="{{ channel_columns | length }}" class="ch-group">{{ title }} ({{ rows | length }})</td></tr>
        {% for row in rows %}{{ ch_row(row) }}{% endfor %}
      </tbody>
      {% endfor %}
      {% else %}
      <tbody>
        {% for row in channel_cells %}{{ ch_row(row) }}{% endfor %}
      </tbody>
      {% endif %}
    </table>
  </div>
</div>
{% endif %}

{% if channel_summary_path %}
<!-- ===================================================== channel summary -->
<h2 id="ChannelSummary">Channel Quality Summary</h2>
<p class="qm-note">{{ section_note('channel_summary', sci="%.2f"|format(config.sci_threshold)) }}</p>
<div style="overflow-x:auto;">
  <iframe src="{{ channel_summary_path }}"
          width="100%" height="{{ channel_summary_h + 20 }}px"
          style="border:none;min-width:500px;display:block;"></iframe>
</div>
{% endif %}

{% if trial_qc_path %}
<!-- ==================================================== per-trial quality -->
<h2 id="TrialQC">Per-trial Quality</h2>
<p class="qm-note">{{ section_note('trial_qc', window=trial_qc_window) }}</p>
<div style="overflow-x:auto;">
  <iframe class="plotly-frame" src="{{ trial_qc_path }}" title="Per-trial quality"
          style="height:{{ trial_qc_h }}px;min-width:500px;"></iframe>
</div>
<p class="fig-path">{{ trial_qc_path }}</p>
{% endif %}

{% endblock %}
