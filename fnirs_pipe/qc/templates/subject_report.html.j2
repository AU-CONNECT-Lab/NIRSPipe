<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>fnirs-pipe QC — sub-{{ subject }}</title>
  <style>
    /* ---- base ---- */
    *, *::before, *::after { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 14px; line-height: 1.5; color: #2c3e50;
      padding: 1.5rem 2rem 4rem;
    }
    h1 { font-size: 1.5rem; margin: 0 0 0.25rem; }
    h2 { font-size: 1.1rem; font-weight: 600; color: #34495e;
         border-left: 4px solid #2980b9; padding-left: 0.6rem;
         margin: 2rem 0 0.75rem; }
    h3 { font-size: 0.95rem; margin: 1rem 0 0.4rem; color: #555; }
    pre { background: #f4f4f4; padding: 0.75rem 1rem; border-radius: 4px;
          overflow-x: auto; font-size: 0.82rem; white-space: pre-wrap;
          word-break: break-all; }
    img { max-width: 100%; border: 1px solid #ddd; border-radius: 4px;
          display: block; margin-top: 0.5rem; }
    table { border-collapse: collapse; width: 100%; font-size: 0.85rem; }
    th, td { border: 1px solid #ddd; padding: 0.35rem 0.7rem; text-align: left; }
    th { background: #f0f3f6; font-weight: 600; }

    /* ---- top nav ---- */
    #report-nav {
      position: sticky; top: 0; z-index: 100;
      background: #fff; border-bottom: 2px solid #2980b9;
      padding: 0.4rem 2rem; display: flex; align-items: center;
      gap: 0.25rem; flex-wrap: wrap; font-size: 0.85rem;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }
    #report-nav a {
      color: #2980b9; text-decoration: none; font-weight: 600;
      padding: 0.2rem 0.55rem; border-radius: 3px;
    }
    #report-nav a:hover { background: #eaf3fb; }
    .nav-sep { color: #ccc; padding: 0 0.2rem; }

    /* ---- header bar ---- */
    .page-header {
      display: flex; align-items: baseline; justify-content: space-between;
      padding-bottom: 0.5rem; margin-bottom: 1.5rem;
    }
    .page-header .subtitle { font-size: 0.85rem; color: #888; }

    /* ---- summary box ---- */
    .summary-box {
      background: #f8fafc; border: 1px solid #d0dae6;
      border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem;
    }
    .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; }
    .summary-grid table { font-size: 0.88rem; border: none; }
    .summary-grid td, .summary-grid th { border: none; padding: 0.2rem 0.5rem 0.2rem 0; }
    .summary-grid th { background: none; width: 140px; color: #666; font-weight: 500; }

    /* ---- badges ---- */
    .badge-green  { color: #27ae60; font-weight: 700; }
    .badge-yellow { color: #e67e22; font-weight: 700; }
    .badge-red    { color: #c0392b; font-weight: 700; }

    /* ---- collapsible steps ---- */
    details { border: 1px solid #dde3ea; border-radius: 5px;
              margin-bottom: 0.75rem; }
    details > summary {
      padding: 0.6rem 1rem; cursor: pointer; font-weight: 600;
      background: #f0f3f6; border-radius: 4px; list-style: none;
      display: flex; align-items: center; gap: 0.5rem;
      user-select: none;
    }
    details > summary::-webkit-details-marker { display: none; }
    details > summary::before {
      content: "▶"; font-size: 0.65rem; transition: transform 0.15s;
    }
    details[open] > summary::before { transform: rotate(90deg); }
    .details-body { padding: 0.75rem 1rem 1rem; }
    .step-desc { color: #555; margin: 0 0 0.75rem; }
    .fig-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
               margin-top: 0.5rem; }
    .fig-row.single { grid-template-columns: 1fr; }

    /* ---- SCI table ---- */
    .sci-table td.bad  { background: #fde8e8; color: #c0392b; }
    .sci-table td.good { background: #e8f8ee; color: #1e8449; }

    /* ---- placeholder ---- */
    .placeholder {
      background: repeating-linear-gradient(
        45deg, #f9f9f9, #f9f9f9 10px, #f1f1f1 10px, #f1f1f1 20px
      );
      border: 1px dashed #ccc; border-radius: 4px;
      padding: 1.5rem; text-align: center; color: #aaa;
      font-style: italic; font-size: 0.85rem; margin-top: 0.5rem;
    }

    /* ---- errors ---- */
    .error-list { background: #fff3f3; border: 1px solid #f5c6cb;
                  border-radius: 4px; padding: 0.75rem 1rem; }
    .error-list li { color: #c0392b; font-size: 0.85rem; }
    .no-errors { color: #27ae60; font-weight: 600; }

    /* ---- methods tabs ---- */
    .tab-bar { display: flex; gap: 0; margin-bottom: -1px; }
    .tab-btn {
      padding: 0.35rem 0.9rem; border: 1px solid #ccc; background: #f5f5f5;
      cursor: pointer; font-size: 0.82rem; border-bottom: none;
      border-radius: 4px 4px 0 0;
    }
    .tab-btn.active { background: #fff; font-weight: 600; color: #2980b9; }
    .tab-content { display: none; border: 1px solid #ccc; border-radius: 0 4px 4px 4px; }
    .tab-content.active { display: block; }
    .tab-content pre { border: none; border-radius: 0 4px 4px 4px; margin: 0; }

    /* ---- boilerplate (Methods) HTML rendering ---- */
    .boilerplate-html {
      font-family: "Bitstream Charter", Georgia, Times, serif;
      background: #f8f9fa; padding: 1rem 1.25rem;
      border-radius: 0 4px 4px 4px;
      font-size: 0.9rem; line-height: 1.55;
    }
    .boilerplate-para { margin: 0 0 0.6rem; }
    .boilerplate-cite { color: #555; }
    .boilerplate-refs-title { font-size: 0.95rem; margin: 0.8rem 0 0.3rem; }
    .boilerplate-refs { font-size: 0.82rem; padding-left: 1.3rem; }
    .boilerplate-refs li { margin-bottom: 0.3rem; }

    /* ---- plotly figures ---- */
    .plotly-fig { margin-top: 0.5rem; overflow: hidden; }

    /* ---- channel / detail selectors ---- */
    .ch-select {
      font-size: 0.82rem; border: 1px solid #ced4da; border-radius: 4px;
      padding: 0.2rem 0.5rem; background: #f8f9fa;
      margin: 0.6rem 0 0.3rem; display: block;
    }

    /* ---- two-column panel grid (e.g. heatmap + optode) ---- */
    .panel-grid-2 {
      display: grid; grid-template-columns: 2fr 1fr; gap: 0.75rem; margin-top: 0.75rem;
    }
    @media (max-width: 900px) { .panel-grid-2 { grid-template-columns: 1fr; } }

    /* ---- full-width responsive images ---- */
    img.responsive { width: 100%; height: auto; display: block; border: none; }

    /* ---- quantitative metrics ---- */
    .qm-box { background: #f8fafc; border: 1px solid #d0dae6; border-radius: 6px;
              padding: 0.75rem 1.25rem 0.75rem; margin-bottom: 1.5rem; }
    .qm-list { font-size: 0.88rem; column-count: 2; column-gap: 2.5rem;
               margin: 0; padding: 0; list-style: none; }
    .qm-list li { display: flex; justify-content: space-between; padding: 0.18rem 0;
                  border-bottom: 1px solid #eef0f3; break-inside: avoid; gap: 1rem; }
    .qm-list .ql { color: #666; white-space: nowrap; }
    /* dotted underline is the only cue that a native title tooltip is there */
    .qm-list .ql[title]:not([title=""]) { cursor: help; border-bottom: 1px dotted #b8c2cc; }
    .qm-list .ql-key { color: #34495e; font-weight: 600; }
    .ql-dot { color: #2980b9; font-size: 0.62em; vertical-align: 0.35em; margin-left: 0.3rem; }
    .qm-note { font-size: 0.78rem; color: #8a949e; margin: 0 0 0.55rem; }
    .qm-list .qv { font-weight: 600; white-space: nowrap; }
    .qm-ok   { color: #27ae60; }
    .qm-warn { color: #e67e22; }
    .qm-bad  { color: #c0392b; }
    .qm-table { font-size: 0.82rem; margin-top: 0.5rem; }
    .qm-table td.bad  { color: #c0392b; }
    .qm-table td.good { color: #27ae60; }
    .qm-table td.neg  { color: #27ae60; }
    .qm-table td.pos  { color: #c0392b; }

    /* ---- GLM beta table ---- */
    .glm-beta-table { font-size: 0.80rem; border-collapse: collapse; margin-top: 0.25rem; }
    .glm-beta-table th, .glm-beta-table td { border: 1px solid #ddd; padding: 0.22rem 0.55rem; text-align: right; }
    .glm-beta-table th { background: #f0f3f6; text-align: center; }
    .glm-beta-table td:first-child, .glm-beta-table td:nth-child(2) { text-align: left; }
    .glm-beta-table td.pos { color: #c0392b; }
    .glm-beta-table td.neg { color: #27ae60; }
    .glm-beta-table td.chroma-hbo { color: #c0392b; font-weight: 600; }
    .glm-beta-table td.chroma-hbr { color: #2471a3; font-weight: 600; }

    /* ---- figure path caption ---- */
    .fig-path {
      font-size: 0.75rem; color: #888; margin: 0.3rem 0 0;
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    }
    .fig-path::before { content: "file: "; }

    /* ---- plotly iframes ---- */
    .plotly-frame {
      width: 100%; border: none; display: block; margin-top: 0.5rem;
    }
  </style>
</head>
<body>

{# Fallback modules: used in static mode and overridden by /load_ratings/<pid> when Flask serves. #}
{% set _glm_module = [{"id": "GLM", "name": "GLM"}] if (mode == "glm") else [] %}
{% set rating_subject = "sub-" ~ subject %}
{% set rating_modules = [[
  {"id": "Signal", "name": "Signal"},
  {"id": "Motion", "name": "Motion"},
  {"id": "HbO_HbR", "name": "HbO HbR"},
] + _glm_module + [
  {"id": "Final", "name": "Final"},
]] %}
{% set rating_save_endpoint = "/save_ratings" %}
{% set rating_load_endpoint = "/load_ratings/sub-" ~ subject %}
{% include "_rating_bar.html.j2" %}

<!-- ================================================================ top nav -->
<nav id="report-nav">
  <a href="#Final">Summary</a>
  <a href="#Metrics">Metrics</a>
  <span class="nav-sep">|</span>
  <a href="#RawSignal">Raw Signal</a>
  <a href="#Signal">SCI/PSP</a>
  <a href="#Motion">Motion</a>
  <a href="#HbO_HbR">HbO/HbR</a>
  {% if mode != 'rest' %}<a href="#Epoch">Epoch</a>{% endif %}
  {# three independent conditions, matching the body: glm --fc and denoise --fc draw the
     FC panel too, and used to reach it with no nav entry #}
  {% if rest_alff_path %}<a href="#RestALFF">ALFF/fALFF</a>{% endif %}
  {% if rest_fc_path %}<a href="#RestFC">FC</a>{% endif %}
  {% if glm_design_path or glm_activation_path %}<a href="#GLM">GLM</a>{% endif %}
  <span class="nav-sep">|</span>
  <a href="#Metrics">Metrics</a>
  {% if channel_summary_path %}<a href="#ChannelSummary">Ch. Summary</a>{% endif %}
  <a href="#Errors">Errors</a>
  <a href="#Provenance">Provenance</a>
  <a href="#Methods">Methods</a>
</nav>

<!-- ================================================================ header -->
<div class="page-header">
  <h1>fnirs-pipe QC Report &mdash; sub-{{ subject }}</h1>
  <span class="subtitle">v{{ versions.get('fnirs-pipe', 'unknown') }} &bull; {{ run_date }}</span>
</div>

<!-- ============================================================== summary -->
<h2 id="Final">Summary</h2>
<div class="summary-box">
  <div class="summary-grid">
    <table>
      <tr><th>Subject</th><td>sub-{{ subject }}</td></tr>
      <tr><th>Date</th><td>{{ run_date }}</td></tr>
      <tr><th>fnirs-pipe</th><td>v{{ versions.get('fnirs-pipe', 'n/a') }}</td></tr>
      <tr><th>MNE</th><td>v{{ versions.get('mne', 'n/a') }}</td></tr>
      <tr><th>Python</th><td>{{ versions.get('python', 'n/a') }}</td></tr>
    </table>
    <table>
      <tr>
        <th>Bad channels</th>
        <td><span class="{{ badge_class }}">{{ n_bad }}/{{ n_total }} ({{ "%.0f"|format(bad_rate) }}%)</span></td>
      </tr>
      <tr><th>SCI threshold</th><td>{{ config.sci_threshold }}</td></tr>
      <tr><th>Motion corr.</th><td>{{ config.motion_correction }}</td></tr>
      <tr><th>DPF</th><td>{{ config.dpf | join(', ') }}</td></tr>
    </table>
  </div>
  {% if bad_channels %}
  <p style="margin: 0.75rem 0 0; font-size:0.85rem;">
    <strong>Bad channels:</strong> {{ bad_channels | join(', ') }}
  </p>
  {% endif %}
  <h3 style="margin-top:1rem;">Run command</h3>
  <pre>{{ run_command }}</pre>
</div>

<!-- ======================================================= preprocessing -->
<h2>Preprocessing</h2>

<!-- step a: Raw Signal -->
<details id="RawSignal" open>
  <summary>a. Raw Signal</summary>
  <div class="details-body">
    <p class="step-desc">
      Per-channel HbO/HbR timeseries, PSD, and epoch-averaged response.
    </p>

    {% if channel_pairs %}
    <h3>Per-channel HbO / HbR &amp; PSD &amp; Epoch</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">
      Select a channel to view its HbO/HbR timeseries, PSD, and epoch-averaged response.
    </p>
    <select class="ch-select"
            onchange="document.getElementById('ch-det-frame').src=this.value">
      {% for ch in channel_pairs %}
      <option value="{{ ch.path }}">{{ ch.pair }}</option>
      {% endfor %}
    </select>
    <iframe id="ch-det-frame" class="plotly-frame"
            src="{{ channel_pairs[0].path }}"
            style="height:{{ channel_pairs[0].h + 20 }}px;"></iframe>
    {% else %}
    <div class="placeholder">Channel detail not available.</div>
    {% endif %}
  </div>
</details>

<!-- step b: SCI / PSP quality panels -->
<details id="Signal" open>
  <summary>b. Raw Signal Quality (SCI / PSP / Short Channel)</summary>
  <div class="details-body">
    <p class="step-desc">
      Scalp coupling index (SCI) and peak spectral power (PSP) computed per channel.
      SCI threshold: <strong>{{ config.sci_threshold }}</strong>.
    </p>

    {% if sci_psp_panel_path %}
      <iframe class="plotly-frame" src="{{ sci_psp_panel_path }}" title="SCI/PSP panel"
              style="height:{{ sci_psp_panel_h }}px"></iframe>
      <p class="fig-path">{{ sci_psp_panel_path }}</p>
    {% else %}
      <div class="placeholder">SCI/PSP panel not available.</div>
    {% endif %}

    {% if brain_views_path %}
      <h3>Channel quality — 3D &amp; optode map</h3>
      <p style="font-size:0.82rem; color:#666; margin:0 0 0.3rem;">Green = good, red = below threshold.</p>
      <img class="responsive" src="{{ brain_views_path }}" alt="Brain views + optode" />
      <p class="fig-path">{{ brain_views_path }}</p>
    {% endif %}

  </div>
</details>

<!-- step c: motion correction -->
<details id="Motion" open>
  <summary>c. Motion Correction</summary>
  <div class="details-body">
    <p class="step-desc">
      Motion correction method: <strong>{{ config.motion_correction }}</strong>.
    </p>
    {% if carpet_gvtd_path %}
      <h3>GVTD + Carpet plot</h3>
      <img class="responsive" src="{{ carpet_gvtd_path }}" alt="GVTD + Carpet plot" />
      <p class="fig-path">{{ carpet_gvtd_path }}</p>
    {% else %}
      <div class="placeholder">GVTD + Carpet not available.</div>
    {% endif %}
    {% if bad_segment_zoom_path %}
      <h3>Bad segment zoom — top segments by duration</h3>
      <img src="{{ bad_segment_zoom_path }}" alt="Bad segment zoom" />
      <p class="fig-path">{{ bad_segment_zoom_path }}</p>
    {% endif %}

    {% if motion_detail_pairs %}
    <h3>Per-channel before / after motion correction</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">
      Select a channel to compare the OD signal before and after motion correction.
    </p>
    <select class="ch-select"
            onchange="document.getElementById('mot-det-frame').src=this.value">
      {% for ch in motion_detail_pairs %}
      <option value="{{ ch.path }}">{{ ch.pair }}</option>
      {% endfor %}
    </select>
    <iframe id="mot-det-frame" class="plotly-frame"
            src="{{ motion_detail_pairs[0].path }}"
            style="height:{{ motion_detail_pairs[0].h + 20 }}px;"></iframe>
    {% endif %}
  </div>
</details>

<!-- step d: HbO / HbR -->
<details id="HbO_HbR" open>
  <summary>d. HbO / HbR (Beer-Lambert)</summary>
  <div class="details-body">
    <p class="step-desc">
      Modified Beer-Lambert law applied with DPF = {{ config.dpf | join(', ') }}.
    </p>
    <h3>HbO–HbR Correlation</h3>
    {% if hbo_hbr_path %}
      <img class="responsive" src="{{ hbo_hbr_path }}" alt="HbO–HbR correlation panel" />
      <p class="fig-path">{{ hbo_hbr_path }}</p>
    {% else %}
      <div class="placeholder">Figure generation failed — see Errors section.</div>
    {% endif %}


    {% if denoise_carpet_path %}
      <h3>Denoising carpet — before / after</h3>
      <p class="step-desc">
        Per-channel z-scored haemoglobin carpet, both stages scaled by the before SD:
        reduced fluctuation after denoising renders paler. HbO and HbR shown separately.
      </p>
      <img class="responsive" src="{{ denoise_carpet_path }}" alt="Denoising before/after carpet" />
      <p class="fig-path">{{ denoise_carpet_path }}</p>
    {% endif %}
  </div>
</details>

<!-- step e: PSD -->
<details open>
  <summary>e. Power Spectral Density (before / after bandpass)</summary>
  <div class="details-body">
    <p class="step-desc">
      PSD before and after bandpass filter. Coloured bands: Mayer wave (~0.1&thinsp;Hz),
      respiration (0.1–0.5&thinsp;Hz), cardiac (0.7–1.5&thinsp;Hz).
      HbO = red, HbR = blue; thin lines = individual channels, thick = mean.
    </p>
    {% if psd_panel_path %}
      <iframe class="plotly-frame" src="{{ psd_panel_path }}" title="PSD panel" style="height:{{ psd_panel_h }}px"></iframe>
      <p class="fig-path">{{ psd_panel_path }}</p>
    {% else %}
      <div class="placeholder">Figure generation failed — see Errors section.</div>
    {% endif %}

    {% if psd_detail_pairs %}
    <h3>Per-channel PSD (before / after bandpass)</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">
      Select a channel to compare its PSD before and after bandpass filtering.
    </p>
    <select class="ch-select"
            onchange="document.getElementById('psd-det-frame').src=this.value">
      {% for ch in psd_detail_pairs %}
      <option value="{{ ch.path }}">{{ ch.pair }}</option>
      {% endfor %}
    </select>
    <iframe id="psd-det-frame" class="plotly-frame"
            src="{{ psd_detail_pairs[0].path }}"
            style="height:{{ psd_detail_pairs[0].h + 20 }}px;"></iframe>
    {% endif %}
  </div>
</details>

<!-- step f: Epoch / HRF preview (task/GLM mode only) -->
{% if mode != 'rest' %}
<details id="Epoch" open>
  <summary>f. Epoch / HRF Preview (grand mean)</summary>
  <div class="details-body">
    <p class="step-desc">
      Grand-mean HbO and HbR responses averaged across good channels, baseline-corrected
      to the pre-stimulus window (−5 to 0&thinsp;s). Each condition is shown separately.
    </p>
    {% if epoch_preview_path %}
      <iframe class="plotly-frame" src="{{ epoch_preview_path }}" title="Epoch preview" style="height:{{ epoch_preview_h }}px"></iframe>
      <p class="fig-path">{{ epoch_preview_path }}</p>
    {% else %}
      <div class="placeholder">No stimulus events found — epoch preview not available.</div>
    {% endif %}

    {% if evoked_topomap_path %}
    <h3>Topographic maps</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">
      The condition-averaged response interpolated across the montage, at time points after
      onset. One row per condition and chromophore; the colour scale is shared across the
      conditions of a chromophore. Interpolation stays inside the optode coverage, so bare
      scalp is left blank rather than painted.
    </p>
    <img src="{{ evoked_topomap_path }}" alt="Evoked topomaps" style="max-width:100%;" />
    <p class="fig-path">{{ evoked_topomap_path }}</p>
    {% endif %}

    {% if trial_image_roi_pairs %}
    <h3>Trial image — ROI (channel-averaged)</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">
      Per ROI, HbO channels averaged first (higher SNR), then each trial stacked as a row.
      Denoised signal; smoothed across adjacent trials. One panel per condition, pooled
      panel first. Select an ROI.
    </p>
    <select class="ch-select"
            onchange="document.getElementById('trialimg-roi-frame').src=this.value">
      {% for roi in trial_image_roi_pairs %}
      <option value="{{ roi.path }}">{{ roi.pair }}</option>
      {% endfor %}
    </select>
    <iframe id="trialimg-roi-frame" class="plotly-frame"
            src="{{ trial_image_roi_pairs[0].path }}"
            style="height:{{ trial_image_roi_pairs[0].h + 20 }}px;"></iframe>
    {% endif %}

    {% if trial_image_pairs %}
    <h3>Trial image — single-channel trials</h3>
    <p style="font-size:0.82rem;color:#666;margin:0 0 0.3rem;">
      Each stimulus repetition is a row (trial × time from onset), coloured by HbO — the
      un-averaged view of the response (denoised, trial-smoothed). One panel per condition,
      pooled panel first. Select a channel.
    </p>
    <select class="ch-select"
            onchange="document.getElementById('trialimg-frame').src=this.value">
      {% for ch in trial_image_pairs %}
      <option value="{{ ch.path }}">{{ ch.pair }}</option>
      {% endfor %}
    </select>
    <iframe id="trialimg-frame" class="plotly-frame"
            src="{{ trial_image_pairs[0].path }}"
            style="height:{{ trial_image_pairs[0].h + 20 }}px;"></iframe>
    {% endif %}
  </div>
</details>
{% endif %}

<!-- ======================================================= postprocessing -->
<h2 id="Postprocessing">Postprocessing</h2>

{% if mode == 'rest' %}
<!-- Resting-state results -->
<details id="RestALFF" {% if rest_alff_path %}open{% endif %}>
  <summary>ALFF / fALFF</summary>
  <div class="details-body">
    <p class="step-desc">
      Amplitude of Low-Frequency Fluctuations (ALFF) and fractional ALFF (fALFF) per channel,
      computed from the denoised residual time series. HbO in red, HbR in blue.
      Dashed lines mark per-group means.
    </p>
    {% if rest_alff_path %}
      <img class="responsive" src="{{ rest_alff_path }}" alt="ALFF / fALFF per channel" />
      <p class="fig-path">{{ rest_alff_path }}</p>
    {% else %}
      <div class="placeholder">ALFF not computed — --high-pass and --low-pass are required.</div>
    {% endif %}
    {% if rest_alff_topo_path %}
      <h3>On the optode layout</h3>
      <p class="step-desc">
        The same two measures drawn where the channels are, each channel its source-to-detector
        segment. Each panel is scaled to its own values, so colours compare within a panel and
        not across them. Faded channels were rejected. Short channels are not drawn.
      </p>
      <img class="responsive" src="{{ rest_alff_topo_path }}" alt="ALFF / fALFF topography" />
      <p class="fig-path">{{ rest_alff_topo_path }}</p>
    {% endif %}
  </div>
</details>
{% endif %}

{% if mode == 'rest' or rest_fc_path %}
<details id="RestFC" {% if rest_fc_path %}open{% endif %}>
  <summary>Functional Connectivity</summary>
  <div class="details-body">
    <p class="step-desc">
      Channel-level Pearson correlation matrix computed from the denoised residual time series.
      HbO and HbR are shown as separate heatmaps.
    </p>
    {% if rest_fc_path %}
      <img class="responsive" src="{{ rest_fc_path }}" alt="Functional connectivity matrix" />
      <p class="fig-path">{{ rest_fc_path }}</p>
    {% else %}
      <div class="placeholder">FC matrix not available.</div>
    {% endif %}
    {% if rest_fc_roi_path %}
      <h3>ROI to ROI</h3>
      <p class="step-desc">
        The same correlations between ROI-averaged signals rather than between channels, on the
        same scale. Channels are averaged before correlating, so this is not the mean of the
        cells above. Needs --roi-mapping.
      </p>
      <img class="responsive" src="{{ rest_fc_roi_path }}" alt="ROI-to-ROI connectivity matrix" />
      <p class="fig-path">{{ rest_fc_roi_path }}</p>
    {% endif %}
    {% if rest_fc_circle_path %}
      <h3>Connectogram (threshold |r| ≥ 0.3)</h3>
      <p class="step-desc">HbO and HbR channels together, nodes colour-coded by source. Only connections above threshold are drawn.</p>
      <img class="responsive" src="{{ rest_fc_circle_path }}" alt="FC connectogram" />
      <p class="fig-path">{{ rest_fc_circle_path }}</p>
    {% endif %}
    {% if rest_fc_seed_path %}
      <h3>Seed topography</h3>
      <p class="step-desc">
        One flat map per seed ROI, each channel coloured by its correlation with that seed's mean
        signal, on the same scale as the matrix above. Grey channels are inside the seed: their
        value is undefined, not zero. Faded channels were rejected. Short channels are not drawn.
      </p>
      <img class="responsive" src="{{ rest_fc_seed_path }}" alt="Seed-to-whole-brain topography" />
      <p class="fig-path">{{ rest_fc_seed_path }}</p>
    {% endif %}
  </div>
</details>
{% endif %}

{% if mode != 'rest' %}
<details id="GLM" {% if glm_design_path or glm_betas_html or glm_activation_path %}open{% endif %}>
  <summary>GLM</summary>
  <div class="details-body">
    {% if glm_design_path or glm_design_heatmap_path %}
      <h3>Design matrix</h3>
      {% if glm_design_path %}
        <img class="responsive" src="{{ glm_design_path }}" alt="Design matrix — regressor time series" />
        <p class="fig-path">{{ glm_design_path }}</p>
      {% endif %}
      {% if glm_design_heatmap_path %}
        <img class="responsive" src="{{ glm_design_heatmap_path }}" alt="Design matrix — heatmap" style="margin-top:0.5rem;" />
        <p class="fig-path">{{ glm_design_heatmap_path }}</p>
      {% endif %}
    {% else %}
      <div class="placeholder">Design matrix not available — pass design_matrix to build_subject_report.</div>
    {% endif %}

    {% if glm_activation_path %}
      <h3>Activation by condition</h3>
      <img src="{{ glm_activation_path }}" alt="Activation by condition" style="max-width:100%;" />
      <p class="fig-path">{{ glm_activation_path }}</p>
    {% endif %}

  </div>
</details>

{% endif %}

<!-- ================================================= quantitative metrics -->
{% macro qm_val(v, fmt='.3f') %}{% if v is not none %}{{ ('%' ~ fmt) | format(v) }}{% else %}<span style="color:#aaa">n/a</span>{% endif %}{% endmacro %}
{% macro pct(v) %}{% if v is not none %}{{ "%.1f"|format(v * 100) }}%{% else %}<span style="color:#aaa">n/a</span>{% endif %}{% endmacro %}

<h2 id="Metrics">Quantitative Metrics</h2>
<div class="qm-box">
  {% macro qv_class(v, ok_test, warn_test) %}{% if v is not none %}{% if ok_test %}qm-ok{% elif warn_test %}qm-warn{% else %}qm-bad{% endif %}{% endif %}{% endmacro %}
  {#- label + hover text from the metric registry; a marker on the ones that decide usability -#}
  {% macro ql(key, text) %}<span class="ql{% if is_key_metric(key) %} ql-key{% endif %}"
        title="{{ metric_summary(key) }}">{{ text }}{% if is_key_metric(key) %}<span class="ql-dot" aria-hidden="true">&#9679;</span>{% endif %}</span>{% endmacro %}
  <p class="qm-note">Hover a metric for what it means and which way is good.
     <span class="ql-dot" aria-hidden="true">&#9679;</span> marks the ones that decide whether the run is usable.</p>
  <ul class="qm-list">
    {% set ret  = sqm.get('channel_retention_rate') %}
    {% set sci  = sqm.get('sci_mean') %}
    {% set corr = sqm.get('hbo_hbr_corr_mean') %}
    {% set ret_pct = sqm.get('pct_data_retained') %}
    {% set snr  = sqm.get('snr_mean') %}
    {% set spk  = sqm.get('spike_count') %}
    <li>{{ ql('channel_retention_rate', 'Channel retention') }}
        <span class="qv {{ qv_class(ret, ret >= 0.9, ret >= 0.7) }}">{{ pct(ret) }}</span></li>
    <li>{{ ql('sci_mean', 'Mean SCI') }}
        <span class="qv {{ qv_class(sci, sci >= 0.75, sci >= 0.5) }}">{{ qm_val(sci) }}</span></li>
    <li>{{ ql('psp_mean', 'Mean PSP (10 s windows)') }}
        <span class="qv">{{ qm_val(sqm.get('psp_mean')) }}</span></li>
    <li>{{ ql('snr_mean', 'Mean SNR (intensity)') }}
        <span class="qv {{ qv_class(snr, snr >= 100, snr >= 20) }}">{{ qm_val(snr, '.1f') }}</span></li>
    <li>{{ ql('hbo_hbr_corr_mean', 'Mean HbO–HbR corr') }}
        <span class="qv {{ qv_class(corr, corr < -0.3, corr < 0) }}">{{ qm_val(corr) }}</span></li>
    <li>{{ ql('gcor_hbo', 'Global corr HbO' ~ (' (reg before→after)' if sqm.get('gcor_hbo_postreg') is not none else '')) }}
        <span class="qv">{% if sqm.get('gcor_hbo_postreg') is not none %}{{ qm_val(sqm.get('gcor_hbo_prereg')) }} → {{ qm_val(sqm.get('gcor_hbo_postreg')) }}{% else %}{{ qm_val(sqm.get('gcor_hbo')) }}{% endif %}</span></li>
    <li>{{ ql('gcor_hbr', 'Global corr HbR' ~ (' (reg before→after)' if sqm.get('gcor_hbr_postreg') is not none else '')) }}
        <span class="qv">{% if sqm.get('gcor_hbr_postreg') is not none %}{{ qm_val(sqm.get('gcor_hbr_prereg')) }} → {{ qm_val(sqm.get('gcor_hbr_postreg')) }}{% else %}{{ qm_val(sqm.get('gcor_hbr')) }}{% endif %}</span></li>
    <li>{{ ql('pct_data_retained', '% data retained') }}
        <span class="qv {{ qv_class(ret_pct, ret_pct >= 0.8, ret_pct >= 0.6) }}">{{ pct(ret_pct) }}</span></li>
    <li>{{ ql('gvtd_mean', 'GVTD mean') }}
        <span class="qv">{{ qm_val(sqm.get('gvtd_mean'), '.3e') }}</span></li>
    <li>{{ ql('gvtd_p95', 'GVTD p95') }}
        <span class="qv">{{ qm_val(sqm.get('gvtd_p95'), '.3e') }}</span></li>
    <li>{{ ql('gvtd_pct_above_thresh', 'GVTD % motion') }}
        <span class="qv">{{ pct(sqm.get('gvtd_pct_above_thresh')) }}</span></li>
    <li>{{ ql('gvtd_num_above_thresh', 'GVTD motion frames') }}
        <span class="qv">{{ qm_val(sqm.get('gvtd_num_above_thresh'), 'd') }}</span></li>
    <li>{{ ql('gvtd_thresh', 'GVTD threshold') }}
        <span class="qv">{{ qm_val(sqm.get('gvtd_thresh'), '.3e') }}</span></li>
    {% if sqm.get('motion_corrected_pct') is not none %}
    <li>{{ ql('motion_corrected_pct', 'Motion corrected % (exp.)') }}
        <span class="qv">{{ pct(sqm.get('motion_corrected_pct')) }}</span></li>
    <li>{{ ql('motion_corrected_num', 'Motion corrected frames') }}
        <span class="qv">{{ qm_val(sqm.get('motion_corrected_num'), 'd') }}</span></li>
    <li>{{ ql('motion_corrected_n_segments', 'Motion corrected segments') }}
        <span class="qv">{{ qm_val(sqm.get('motion_corrected_n_segments'), 'd') }}</span></li>
    {% endif %}
    <li>{{ ql('spike_count', 'Spike count') }}
        <span class="qv {{ qv_class(spk, spk == 0, spk < 10) }}">{% if spk is not none %}{{ spk }}{% else %}<span style="color:#aaa">n/a</span>{% endif %}</span></li>
    {% if sqm.get('spike_pct') is not none %}
    <li>{{ ql('spike_pct', 'Spike % (exp.)') }}
        <span class="qv">{{ pct(sqm.get('spike_pct')) }}</span></li>
    <li>{{ ql('spike_pct_frames', 'Spike % frames') }}
        <span class="qv">{{ pct(sqm.get('spike_pct_frames')) }}</span></li>
    {% endif %}
    <li>{{ ql('cardiac_band_power_hbo', 'Cardiac band power (HbO)') }}
        <span class="qv">{{ qm_val(sqm.get('cardiac_band_power_hbo'), '.3e') }}</span></li>
    <li>{{ ql('cardiac_band_frac_hbo', 'Cardiac band fraction (HbO)') }}
        <span class="qv">{{ pct(sqm.get('cardiac_band_frac_hbo')) }}</span></li>
    <li>{{ ql('lowfreq_drift_amplitude_hbo', 'Low-freq drift (HbO)') }}
        <span class="qv">{{ qm_val(sqm.get('lowfreq_drift_amplitude_hbo'), '.3e') }}</span></li>
  </ul>

  {% if channel_rows %}
  <details>
    <summary style="font-weight:500; font-size:0.88rem; cursor:pointer;">Per-channel metrics</summary>
    <div style="overflow-x:auto; margin-top:0.5rem;">
      <table class="qm-table">
        <thead>
          <tr>
            <th>Channel</th><th>Status</th><th>SCI</th>
            <th>SNR (intensity)</th><th>CV</th><th>HbO–HbR corr</th>
          </tr>
        </thead>
        <tbody>
        {% for row in channel_rows %}
          <tr>
            <td>{{ row.name }}</td>
            <td class="{{ 'bad' if row.is_bad else 'good' }}">{{ 'BAD' if row.is_bad else 'OK' }}</td>
            <td class="{{ 'bad' if row.sci is not none and row.sci < 0.75 else '' }}">
              {% if row.sci is not none %}{{ "%.3f"|format(row.sci) }}{% else %}—{% endif %}
            </td>
            <td>{% if row.snr is not none %}{{ "%.1f"|format(row.snr) }}{% else %}—{% endif %}</td>
            <td>{% if row.cv is not none %}{{ "%.3f"|format(row.cv) }}{% else %}—{% endif %}</td>
            <td class="{{ 'neg' if row.corr is not none and row.corr < 0 else ('pos' if row.corr is not none else '') }}">
              {% if row.corr is not none %}{{ "%.3f"|format(row.corr) }}{% else %}—{% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </details>
  {% endif %}
</div>

{% if channel_summary_path %}
<!-- ===================================================== channel summary -->
<h2 id="ChannelSummary">Channel Quality Summary</h2>
<p style="font-size:0.82rem;color:#666;margin:0 0 0.6rem;">
  Per-channel pass/fail for Status, SCI, CV, PSP, and SNR.
  Green&nbsp;=&nbsp;pass, red&nbsp;=&nbsp;fail, white&nbsp;=&nbsp;missing data.
</p>
<div style="overflow-x:auto;">
  <iframe src="{{ channel_summary_path }}"
          width="100%" height="{{ channel_summary_h + 20 }}px"
          style="border:none;min-width:500px;display:block;"></iframe>
</div>
{% endif %}

<!-- =========================================================== errors -->
<h2 id="Errors">Errors &amp; Warnings</h2>
{% if errors %}
  <ul class="error-list">
    {% for e in errors %}<li>{{ e }}</li>{% endfor %}
  </ul>
{% else %}
  <p class="no-errors">No errors or warnings.</p>
{% endif %}

<!-- ========================================================== provenance -->
<h2 id="Provenance">Provenance</h2>
<p style="font-size:0.85rem; color:#666;">
  Every file this run wrote, the step that produced it, the settings that step used, and
  the channels / sampling rate / duration left behind at each point. Rebuilt from the JSON
  sidecars in <code>nirs/</code>, so it reports what ran, not what was requested.
</p>
{% if provenance_path %}
  <img class="responsive" src="{{ provenance_path }}" alt="File provenance graph" />
  <p class="fig-path">{{ provenance_path }} &bull; mermaid source: figures/provenance.mmd</p>
{% else %}
  <div class="placeholder">
    Diagram not rendered. Regenerate with <code>fnirs-qc provenance OUTPUT_DIR</code>.
  </div>
{% endif %}

{% if provenance_rows %}
<table>
  <tr><th>Output</th><th>Step</th><th>What it did</th><th>Settings</th></tr>
  {% for row in provenance_rows %}
  <tr>
    <td><code>{{ row.name }}</code></td>
    <td><code>{{ row.step }}</code></td>
    <td>{{ row.what }}</td>
    <td>{% if row.metrics %}{{ row.metrics | join(', ') }}{% else %}{{ row.settings }}{% endif %}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<!-- ============================================================= methods -->
<h2 id="Methods">Methods</h2>
<p style="font-size:0.85rem; color:#666;">
  Auto-generated from the pipeline configuration. Citations follow APA 7;
  switch tabs to copy as Markdown or LaTeX.
</p>

<div class="tab-bar">
  <button class="tab-btn active" onclick="showTab(event,'tab-rendered')">Rendered</button>
  <button class="tab-btn" onclick="showTab(event,'tab-plain')">Plain text</button>
  <button class="tab-btn" onclick="showTab(event,'tab-md')">Markdown</button>
  <button class="tab-btn" onclick="showTab(event,'tab-latex')">LaTeX</button>
</div>
<div id="tab-rendered" class="tab-content active"><div class="boilerplate-html">{{ methods.html }}</div></div>
<div id="tab-plain"    class="tab-content"><pre>{{ methods.plain }}</pre></div>
<div id="tab-md"       class="tab-content"><pre>{{ methods.markdown }}</pre></div>
<div id="tab-latex"    class="tab-content"><pre>{{ methods.latex }}</pre></div>

<!-- ========================================================== versions -->
<h2>Software Versions</h2>
<table style="max-width:400px;">
  <tr><th>Package</th><th>Version</th></tr>
  {% for pkg, ver in versions.items() %}
  <tr><td>{{ pkg }}</td><td>{{ ver }}</td></tr>
  {% endfor %}
</table>

<script>
function showTab(event, id) {
  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  event.target.classList.add('active');
}

</script>

</body>
</html>
