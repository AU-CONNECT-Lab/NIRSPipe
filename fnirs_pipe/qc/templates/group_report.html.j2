{% extends "_report_base.html.j2" %}

{% block css %}
/* The document look, the one every report wears: a section is a heading with a disclosure
   triangle rather than a card, and the page is read top to bottom. document.css owns the
   summary grid, the details and the metric tables; only the group report's own panels
   belong here. */

.plot-frame { width: 100%; border: none; display: block; }

#box-flow { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-start; }
.box-frame { border: none; display: block; }

/* the right-hand summary table reports three columns rather than a label and a value, so it
   does not want the label column the grid gives the left one */
.summary-grid table.headline th {
  width: auto; color: #8a949e; font-size: 0.75rem; text-transform: uppercase;
  letter-spacing: 0.04em; border-bottom: 1px solid #d8dee5;
}
.summary-grid table.headline td:not(:first-child),
.summary-grid table.headline th:not(:first-child) { text-align: right; }
.summary-grid table.headline td { font-variant-numeric: tabular-nums; }
.summary-grid table.headline td:first-child { color: #34495e; font-weight: 600; }

/* a panel with one row per run is as tall as the cohort is long; it scrolls in its own
   box so the page does not grow with the cohort */
.tall-frame { max-height: 700px; overflow: auto; margin-top: 0.5rem; }

#group-table-wrap { overflow: auto; max-height: 600px; margin-top: 0.5rem; }
table.group-table {
  width: 100%; border-collapse: collapse; font-size: 0.78rem;
  font-variant-numeric: tabular-nums;
}
/* no cell grid: a row is separated by a hairline and a column by being right-aligned, the way
   every other metric table on the document look reads */
table.group-table th, table.group-table td {
  border: none; border-bottom: 1px solid #eef0f3;
  padding: 0.25rem 0.55rem; text-align: right; white-space: nowrap;
}
table.group-table th {
  background: #fff; cursor: pointer; user-select: none;
  position: sticky; top: 0; font-weight: 600; color: #8a949e;
  font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em;
  border-bottom: 1px solid #d8dee5;
}
table.group-table th:first-child, table.group-table td:first-child {
  text-align: left; position: sticky; left: 0; background: #fff;
}
table.group-table th:first-child { z-index: 2; }
table.group-table tbody tr:hover td { background: #f5fbff; }
table.group-table th .sort-ind { color: #ccd2d8; font-size: 0.7rem; margin-left: 0.3rem; }

#outlier-list ul { margin: 0; padding-left: 1.2rem; font-size: 0.85rem; }
#outlier-list li { padding: 0.18rem 0; border-bottom: 1px solid #eef0f3; }
#outlier-list li b { color: #c0392b; }
#outlier-list .no-out { color: #27ae60; font-weight: 600; }
.outlier-metric {
  display: inline-block; background: #fff3cd; color: #856404;
  padding: 0.05rem 0.4rem; margin: 0 0.15rem; border-radius: 3px; font-size: 0.78rem;
}
{% endblock %}

{# Navigation only: this page reads a cohort out of the runs' own records, and a verdict
   belongs on the run it is about. The sections follow the body, so a cohort with no
   conditions is not offered an entry for them. #}
{% set _sections = [("Overview", "Overview"), ("Distributions", "Distributions")] %}
{% if conditions %}
  {% set _ = _sections.append(("Conditions", "By condition")) %}
  {% set _ = _sections.append(("ConditionMatrix", "Run × cond.")) %}
{% endif %}
{% set _ = _sections.append(("Windowed", "Over time")) %}
{% set _ = _sections.append(("Outliers", "Outliers")) %}
{% set _ = _sections.append(("Table", "All metrics")) %}
{% set nav_modules = [nav_bar(_sections, rated=false, summary="#Summary",
                              closing=[("Errors", "Errors"), ("Versions", "Versions")])] %}
{% set nav_chip = title %}

{% block header %}
<div class="page-header">
  <h1>{{ page_heading }}</h1>
  <span class="subtitle">
    {%- for label, value in nav_meta or [] %}{{ label }}: <b>{{ value }}</b> &bull; {% endfor -%}
    {{ run_date }}
    {%- if tsv_name %} &bull; <a href="{{ tsv_name }}" download>&#8681; {{ tsv_name }}</a>{% endif %}
  </span>
</div>
{% endblock %}

{% block content %}

{# printed under every panel whose statistic the cohort is too small to carry #}
{%- set small_caveat = section_note('group.small_cohort', n=n_rows) %}

{% if summary_meta or headline_rows %}
<h2 id="Summary">Summary</h2>
<div class="summary-box">
  <div class="summary-grid">
    <table>
      {%- for label, value in summary_meta or [] %}
      <tr><th>{{ label }}</th><td>{{ value }}</td></tr>
      {%- endfor %}
      <tr><th>Date</th><td>{{ run_date }}</td></tr>
      {%- if versions %}
      <tr><th>fnirs-pipe</th><td>v{{ versions.get('fnirs-pipe', 'n/a') }}</td></tr>
      <tr><th>Python</th><td>{{ versions.get('python', 'n/a') }}</td></tr>
      {%- endif %}
    </table>
    {% if headline_rows %}
    <table class="headline">
      <tr><th>Metric</th><th>Median</th><th>Range</th></tr>
      {%- for row in headline_rows %}
      <tr><td>{{ row.label }}</td><td>{{ row.median }}</td><td>{{ row.range }}</td></tr>
      {%- endfor %}
    </table>
    {% endif %}
  </div>
  {% if outliers is defined %}
  <p class="qm-note" style="margin-top:0.9rem">
    {% if outliers %}{{ section_note('group.outliers', count=outliers | length, n=n_rows,
        z=score_threshold,
        worst=' ' ~ section_note('group.outliers_worst', runs=worst_runs | join(', '))
              if worst_runs else '') }}
    {%- else %}{{ section_note('group.no_outliers', z=score_threshold) }}{% endif %}
  </p>
  {% endif %}
  {% if small_cohort %}<p class="qm-note">{{ small_caveat }}</p>{% endif %}
</div>
{% endif %}

{% if figure_paths.strip %}
<details id="Overview" open>
  <summary>Overview <span class="hint">one row per metric &bull; one dot per run at its robust z &bull; colour = channel set &bull; the band is |z| &lt; 2</span></summary>
  <div class="details-body">
    {% if small_cohort %}<p class="qm-note">{{ small_caveat }}</p>{% endif %}
    <iframe class="plot-frame" src="{{ figure_paths.strip.src }}"
            style="height:{{ figure_paths.strip.h }}px"></iframe>
  </div>
</details>
{% endif %}

{% if box_panels %}
<details id="Distributions" open>
  <summary>Distributions <span class="hint">real values &bull; one chart per same-scale group &bull; colour = channel set &bull; click a point to open its report</span></summary>
  <div class="details-body">
    {% if small_cohort %}<p class="qm-note">{{ small_caveat }}</p>{% endif %}
    <div id="box-flow">
      {%- for p in box_panels %}
      <iframe class="box-frame" src="{{ p.src }}"
              style="width:{{ p.w }}px;height:{{ p.h }}px"></iframe>
      {%- endfor %}
    </div>
  </div>
</details>
{% endif %}

{% if figure_paths.conditions %}
<details id="Conditions" open>
  <summary>By condition <span class="hint">each run's windows collapsed into its own blocks &bull; one line per run &bull; the cohort median over them</span></summary>
  <div class="details-body">
    <iframe class="plot-frame" src="{{ figure_paths.conditions.src }}"
            style="height:{{ figure_paths.conditions.h }}px"></iframe>
  </div>
</details>
{% endif %}

{% if figure_paths.conditionmatrix %}
<details id="ConditionMatrix" open>
  <summary>Run &times; condition <span class="hint">colour is the robust z inside that condition &bull; sorted worst first &bull; run names on the left edge</span></summary>
  <div class="details-body">
    <div class="tall-frame">
      <iframe src="{{ figure_paths.conditionmatrix.src }}"
              style="border:none;display:block;height:{{ figure_paths.conditionmatrix.h }}px;{% if figure_paths.conditionmatrix.w %}width:{{ figure_paths.conditionmatrix.w }}px{% else %}width:100%{% endif %}"></iframe>
    </div>
  </div>
</details>
{% endif %}

{% if figure_paths.windows %}
<details id="Windowed" open>
  <summary>Over time <span class="hint">rows are metrics, columns are channel sets &bull; every run pale, the cohort's interquartile band and median over them &bull; smoothed over 60 s &bull; SCI here follows the QC window, while the table's <code>sci_win_mean</code> is pinned to 10 s and its <code>sci_mean</code> is the whole run</span></summary>
  <div class="details-body">
    <iframe class="plot-frame" src="{{ figure_paths.windows.src }}"
            style="height:{{ figure_paths.windows.h }}px"></iframe>
  </div>
</details>
{% endif %}

{% if outliers is defined %}
<details id="Outliers" open>
  <summary>Outliers <span class="hint">runs whose mean |z| over every metric is past {{ score_threshold }} &bull; one test per run, not one per metric</span></summary>
  <div class="details-body" id="outlier-list">
    {% if small_cohort %}<p class="qm-note">{{ small_caveat }}</p>{% endif %}
    {% if outliers %}
    <ul>
      {%- for sid, metrics in outliers.items() %}
      <li><b>{{ sid }}</b>:
        {% for m in metrics %}<span class="outlier-metric">{{ m }}</span>{% endfor %}
      </li>
      {%- endfor %}
    </ul>
    {% else %}
    <p class="no-out">No outliers flagged.</p>
    {% endif %}
  </div>
</details>
{% endif %}

{% if table_rows %}
<details id="Table" open>
  <summary>All metrics <span class="hint">every scalar the records carry &bull; click a column header to sort &bull; first column sticky</span></summary>
  <div class="details-body">
    <div id="group-table-wrap">
      <table class="group-table" id="group-table">
        <thead><tr>
          {%- for c in table_columns %}
          <th data-col="{{ loop.index0 }}">{{ c }}<span class="sort-ind">&#8645;</span></th>
          {%- endfor %}
        </tr></thead>
        <tbody>
          {%- for row in table_rows %}
          <tr>
            {%- for v in row %}
            <td>{{ v if v is not none else "&mdash;" }}</td>
            {%- endfor %}
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </div>
</details>
{% endif %}

{% endblock %}

{% block scripts %}
<script>
(function() {
  var table = document.getElementById("group-table");
  if (table) {
    var thead = table.querySelector("thead");
    var tbody = table.querySelector("tbody");
    var asc = {};

    var cellValue = function(td) {
      var v = td.textContent.trim();
      if (v === "" || v === "—") return null;
      var n = Number(v);
      return Number.isFinite(n) ? n : v.toLowerCase();
    };

    thead.querySelectorAll("th").forEach(function(th) {
      th.addEventListener("click", function() {
        var col = +th.dataset.col;
        var direction = asc[col] = !asc[col];
        var rows = Array.from(tbody.querySelectorAll("tr"));
        rows.sort(function(a, b) {
          var va = cellValue(a.children[col]);
          var vb = cellValue(b.children[col]);
          if (va === null && vb === null) return 0;
          if (va === null) return 1;
          if (vb === null) return -1;
          if (va < vb) return direction ? -1 : 1;
          if (va > vb) return direction ? 1 : -1;
          return 0;
        });
        rows.forEach(function(r) { tbody.appendChild(r); });
        thead.querySelectorAll(".sort-ind").forEach(function(s) { s.textContent = "⇅"; });
        th.querySelector(".sort-ind").textContent = direction ? "▲" : "▼";
      });
    });
  }

  // iframe auto-resize listener (same protocol as figure_io.py)
  window.addEventListener("message", function(e) {
    if (!e.data || e.data.type !== "iframe-resize") return;
    var all = document.querySelectorAll("iframe");
    for (var i = 0; i < all.length; i++) {
      if (all[i].contentWindow === e.source) {
        all[i].style.height = e.data.h + "px";
        return;
      }
    }
  });
})();
</script>
{% endblock %}
