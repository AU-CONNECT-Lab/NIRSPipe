{# Shared Jinja macros for QC report templates.
   Usage: {% from "_macros.html.j2" import card %} #}

{# Simple card with title bar. Use {% call card(...) %}body{% endcall %}.
   For panels needing extra controls (e.g. a <select>) inside the title row,
   keep the inline HTML version instead of using this macro. #}
{% macro card(title, hint=None, id=None) -%}
<div class="card"{% if id %} id="{{ id }}"{% endif %}>
  <div class="panel-title">
    {{ title }}
    {%- if hint %} <span class="panel-hint">{{ hint }}</span>{% endif %}
  </div>
  {{ caller() }}
</div>
{%- endmacro %}

{# Per-subject quality metrics: one row per metric, one column per subject.
   Rows come from hyper_report.subject_metric_rows. #}
{% macro subject_metrics(rows, subject_ids) -%}
<table class="subj-metrics">
  <thead>
    <tr><th>Metric</th>{% for sid in subject_ids %}<th>{{ sid }}</th>{% endfor %}</tr>
  </thead>
  <tbody>
    {%- for row in rows %}
    <tr>
      <td{% if row.summary %} title="{{ row.summary }}"{% endif %}>{{ row.label }} <span class="dir">{{ row.direction }}</span></td>
      {%- for cell in row.cells %}
      <td class="{{ cell.cls }}">{{ cell.text }}</td>
      {%- endfor %}
    </tr>
    {%- endfor %}
  </tbody>
</table>
{%- endmacro %}
