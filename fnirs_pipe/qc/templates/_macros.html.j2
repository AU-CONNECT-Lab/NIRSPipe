{# Shared Jinja macros for QC report templates.
   Usage: {% from "_macros.html.j2" import subject_metrics %}

   The `card` macro lived here until every report took the document look, where a section is
   a heading with a disclosure triangle and a filled panel around it is chrome. It is gone
   rather than left unused: the only thing it was good for was building the look back. #}

{# Per-subject quality metrics: one table per channel set, one row per metric, one column
   per subject. Tables come from hyper_report.subject_metric_tables.

   A set is its own measurement rather than a grouping of one, which is why it gets its own
   table: GVTD is an RMS across the channels of its set, and a long retention rate and a
   short one are fractions of different montages. An entry whose `set` is empty is a page
   with nothing to split, and prints unheaded. #}
{% macro subject_metrics(tables, subject_ids) -%}
{%- for table in tables %}
{% if table.set %}<h4 class="subj-set">{{ table.set }} channels</h4>{% endif %}
<table class="subj-metrics">
  <thead>
    <tr><th>Metric</th>{% for sid in subject_ids %}<th>{{ sid }}</th>{% endfor %}</tr>
  </thead>
  <tbody>
    {%- for row in table.rows %}
    <tr>
      <td{% if row.summary %} title="{{ row.summary }}"{% endif %}>{{ row.label }} <span class="dir">{{ row.direction }}</span></td>
      {%- for cell in row.cells %}
      <td class="{{ cell.cls }}">{{ cell.text }}</td>
      {%- endfor %}
    </tr>
    {%- endfor %}
  </tbody>
</table>
{%- endfor %}
{%- endmacro %}
