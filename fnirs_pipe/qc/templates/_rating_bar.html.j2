{# Shared sticky top bar: navigation row above, rating row below, columns aligned.
   Required variables (set by the parent template):
     rating_subject:        identifier passed back to the save endpoint
     rating_modules:        list of groups; each group a list of entries, where an entry is
                            {id, name, href?, ratable?} or {sep: true} for a divider
     rating_save_endpoint:  POST URL for ratings (e.g. "/save_hyper_ratings")
     rating_load_endpoint:  GET URL for existing ratings (e.g. "/load_ratings")
   Optional:
     rating_pinned:         entries kept in a fixed block at the right edge (overall verdict)
     rating_chip:           text shown in the right-hand identity chip
   href defaults to "#<id>" and ratable to true, so callers that only pass {id, name}
   get a clickable anchor with a pill under it; href: false renders a plain label
   for pages with no matching anchor.
   In static mode (fetch fails) the rating row is greyed out and a banner appears. #}

<style>
#rating-static-banner {
  display: none;
  background: #fff3cd;
  color: #856404;
  padding: 0.4rem 1rem;
  text-align: center;
  font-size: 0.82rem;
  border-bottom: 1px solid #ffc107;
  font-family: Arial, sans-serif;
}
body.rating-static-mode #rating-static-banner { display: block; }
body.rating-static-mode #qc-container .qc-module {
  pointer-events: none;
  opacity: 0.45;
  cursor: not-allowed;
}

#qc-container {
  position: sticky;
  top: 0;
  z-index: 1000;
  display: flex;
  align-items: stretch;
  background: #fff;
  border-bottom: 2px solid #2980b9;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  user-select: none;
}
#qc-bar-scroll {
  flex: 1 1 auto;
  overflow-x: auto;
  scrollbar-width: thin;
}
#qc-bar-scroll::-webkit-scrollbar { height: 7px; }
#qc-bar-scroll::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }

/* two rows sharing one grid: nav cell and its pill always land in the same column */
.qc-grid {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: max-content;
  grid-template-rows: auto auto;
  column-gap: 4px;
  row-gap: 3px;
  padding: 5px 8px;
  width: max-content;
  min-width: 100%;
  box-sizing: border-box;
}
#qc-pinned {
  flex: 0 0 auto;
  border-left: 1px solid #dde3ea;
  background: #fbfcfd;
}
.qc-sep {
  grid-row: 1 / span 2;
  width: 1px;
  background: #dde3ea;
  margin: 2px 7px;
}
.qc-nav-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.2rem 0.55rem;
  border-radius: 3px;
  color: #2980b9;
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
}
.qc-nav-cell:hover { background: #eaf3fb; }
.qc-nav-plain { color: #495057; cursor: default; }
.qc-nav-plain:hover { background: none; }
.qc-pad { min-height: 1.35rem; }
.qc-module {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 1.35rem;
  padding: 1px 8px;
  border: 1.5px solid #ccd3da;
  border-radius: 8px;
  background: #f7f8fa;
  cursor: pointer;
}
.qc-module .qc-icon {
  font-family: monospace;
  font-size: 15px;
  line-height: 1.1;
  color: #8a939c;
}
.qc-module.good  { background: #d4edda; border-color: #28a745; }
.qc-module.bad   { background: #f8d7da; border-color: #dc3545; }
.qc-module.other { background: #fff; border-color: #6c757d; }
.qc-module.good  .qc-icon { color: #155724; }
.qc-module.bad   .qc-icon { color: #721c24; }
.qc-module.other .qc-icon { color: #343a40; }
.qc-module.has-note { box-shadow: inset 0 -3px 0 #f0ad4e; }
.qc-chip {
  grid-row: 1 / span 2;
  display: flex;
  align-items: center;
  padding: 0 0.6rem;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 0.82rem;
  color: #495057;
  white-space: nowrap;
}

/* anchors land below the bar instead of under it */
h1[id], h2[id], h3[id], details[id] {
  scroll-margin-top: calc(var(--qc-topbar-h, 76px) + 8px);
}
</style>

<div id="rating-static-banner">
  Static mode &mdash; launch via <code>fnirs-rate</code> to load existing ratings and save changes.
</div>

{% macro qc_cells(entries) %}
  {%- for e in entries %}
    {%- if e.sep %}
  <span class="qc-sep"></span>
    {%- else %}
    {%- if e.href is defined and not e.href %}
  <span class="qc-nav-cell qc-nav-plain">{{ e.name }}</span>
    {%- else %}
  <a class="qc-nav-cell" href="{{ e.href | default('#' ~ e.id) }}">{{ e.name }}</a>
    {%- endif %}
      {%- if e.ratable is not defined or e.ratable %}
  <div class="qc-module" data-mod-id="{{ e.id }}" title="click to rate &nbsp;+ &#8594; &#8722; &#8594; ? &nbsp;&bull;&nbsp; ctrl+click to comment"><span class="qc-icon">&#9723;</span></div>
      {%- else %}
  <div class="qc-pad"></div>
      {%- endif %}
    {%- endif %}
  {%- endfor %}
{% endmacro %}

<div id="qc-container">
  <div id="qc-bar-scroll">
    <div class="qc-grid">
      {%- for group in rating_modules %}
        {%- if not loop.first %}<span class="qc-sep"></span>{% endif %}
        {{ qc_cells(group) }}
      {%- endfor %}
    </div>
  </div>
  {%- if rating_pinned or rating_chip %}
  <div id="qc-pinned" class="qc-grid">
    {{ qc_cells(rating_pinned or []) }}
    {%- if rating_chip %}<span class="qc-chip">{{ rating_chip }}</span>{% endif %}
  </div>
  {%- endif %}
</div>

<script>
(function() {
  var ratings       = {};
  var notes         = {};
  var participantId = {{ rating_subject | tojson }};
  var loadEndpoint  = {{ rating_load_endpoint | tojson }};
  var saveEndpoint  = {{ rating_save_endpoint | tojson }};

  var icons        = {NA: "◻", good: "+", bad: "−", other: "?"};
  var ratingStates = ["NA", "good", "bad", "other"];
  var cells = [].slice.call(document.querySelectorAll("#qc-container .qc-module"));

  function updateDisplay(el) {
    var id = el.dataset.modId;
    var s  = ratings[id] || "NA";
    el.classList.remove("good", "bad", "other");
    if (s !== "NA") el.classList.add(s);
    el.classList.toggle("has-note", !!notes[id]);
    el.querySelector(".qc-icon").textContent = icons[s];
  }

  cells.forEach(function(el) {
    el.addEventListener("click", function(e) {
      if (document.body.classList.contains("rating-static-mode")) return;
      var id = el.dataset.modId;
      if (e.ctrlKey) {
        var v = prompt('Comment for "' + id + '"', notes[id] || "");
        if (v === null) return;
        notes[id] = v.trim();
      } else {
        var idx = ratingStates.indexOf(ratings[id] || "NA");
        ratings[id] = ratingStates[(idx + 1) % ratingStates.length];
      }
      updateDisplay(el);
      save();
    });
  });

  // Existing ratings come from the rating server; a failed fetch means the report was
  // opened as a plain file, so the row is greyed out instead of pretending to save.
  fetch(loadEndpoint)
    .then(function(r) { if (!r.ok) throw new Error("load failed"); return r.json(); })
    .then(function(data) {
      Object.assign(ratings, data.ratings || {});
      Object.assign(notes,   data.notes   || {});
      cells.forEach(updateDisplay);
    })
    .catch(function() {
      document.body.classList.add("rating-static-mode");
    });

  function save() {
    fetch(saveEndpoint, {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({ratings: ratings, notes: notes, id: participantId}),
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.status !== "success") alert("Failed to save: " + (d.message || ""));
    })
    .catch(function() { alert("Network error while saving rating"); });
  }

  function syncHeight() {
    var bar = document.getElementById("qc-container");
    document.documentElement.style.setProperty("--qc-topbar-h", bar.offsetHeight + "px");
  }
  syncHeight();
  window.addEventListener("resize", syncHeight);
})();
</script>
