{% extends "_report_base.html.j2" %}

{# The index shares the subject report's stylesheet: both are documents, not dashboards.
   Only what differs is here, so the two stay one look as long as this block stays short. #}
{% block css %}
.subtitle { color: #7f8c8d; font-size: 0.85rem; }
.page-header {
  display: block;
  border-bottom: 2px solid #2980b9; padding-bottom: 0.6rem; margin-bottom: 1.2rem;
}
.page-header .subtitle { color: #7f8c8d; }
th, td { padding: 0.4rem 0.7rem; white-space: nowrap; }
tbody tr:hover { background: #f8fafc; }
td a { color: #2980b9; font-weight: 600; text-decoration: none; }
td a:hover { text-decoration: underline; }
.muted { color: #95a5a6; }
.run-links { display: block; margin-top: 0.15rem; font-size: 0.75rem; }
.run-links a { color: #7f8c8d; font-weight: 400; margin-right: 0.55rem; }
td.flag { background: #fdf0e3; font-weight: 600; color: #b9591a; }
td.flag::after { content: " *"; color: #e08b3f; }
td.ch-bad { background: #fadbd8; color: #922b21; font-weight: 600; text-align: center; }
td.ch-ok  { color: #cfd8dc; text-align: center; }
td.ch-n   { text-align: right; }
tr.ch-clean td { color: #b0bec5; }
.scroll { overflow-x: auto; }
/* the run the conditions were cut from reads as a heading for them, not as a sixth window */
tr.cond-whole td { background: #f4f6f8; font-weight: 600; }
.num { text-align: right; font-variant-numeric: tabular-nums; }
{% endblock %}

{% block header %}
<div class="page-header">
  <h1>{{ page_heading }}</h1>
  <span class="subtitle">
    {{ rows | length }} run{{ "s" if rows | length != 1 }}
    {%- if mode %} &bull; mode: {{ mode }}{% endif %}
    &bull; v{{ versions.get('fnirs-pipe', 'unknown') }} &bull; {{ run_date }}
  </span>
</div>
{% endblock %}

{% block content %}

<h2>Runs</h2>
<div class="scroll">
<table>
  <thead>
    <tr>
      <th>Run</th>
      <th>Channels</th>
      <th>Length</th>
      <th>Rate</th>
      {% for col in columns %}<th>{{ col }}</th>{% endfor %}
    </tr>
  </thead>
  <tbody>
  {% for row in rows %}
    <tr>
      <td>
        {% if row.href %}<a href="{{ row.href }}">{{ row.label }}</a>
        {% else %}{{ row.label }} <span class="muted">(no report)</span>{% endif %}
        {% if row.links %}
        <span class="run-links">
          {% for link in row.links %}<a href="{{ link.href }}">{{ link.text }}</a>{% endfor %}
        </span>
        {% endif %}
      </td>
      <td>
        {%- if row.n_channels is not none -%}
          {{ row.n_channels - (row.n_bad or 0) }}/{{ row.n_channels }}
        {%- else -%}<span class="muted">n/a</span>{%- endif -%}
      </td>
      <td>{% if row.duration_s %}{{ "%.0f"|format(row.duration_s) }} s{% else %}<span class="muted">n/a</span>{% endif %}</td>
      <td>{% if row.sfreq %}{{ "%.2f"|format(row.sfreq) }} Hz{% else %}<span class="muted">n/a</span>{% endif %}</td>
      {% for cell in row.metrics %}
      <td{% if cell.flagged %} class="flag"{% endif %}>{{ cell.value }}</td>
      {% endfor %}
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<p class="subtitle" style="margin-top:0.6rem;">
  Metrics are read from each run's <code>desc-sqm</code> record. Open a run for its figures,
  provenance and full metric table.
  {% if rows | length >= 4 %}
  A marked cell sits more than {{ outlier_z }} median absolute deviations from this subject's
  other runs on that metric. It says the run differs from its neighbours, not that it failed:
  conditions of different length or difficulty are expected to differ.
  {% endif %}
</p>

{% if condition_groups %}
<h2>Conditions</h2>
{% for group in condition_groups %}
{% if condition_groups | length > 1 %}<h3>{{ group.label }}</h3>{% endif %}
<div class="scroll">
<table>
  <thead>
    <tr>
      <th>Window</th>
      <th>Kind</th>
      <th>Span</th>
      <th>Channels kept</th>
      {% for col in condition_columns %}<th>{{ col }}</th>{% endfor %}
    </tr>
  </thead>
  <tbody>
  {% for row in group.rows %}
    <tr{% if row.kind == 'run' %} class="cond-whole"{% endif %}>
      <td>
        {% if row.href %}<a href="{{ row.href }}">{{ row.name }}</a>
        {% else %}{{ row.name }} <span class="muted">(no page)</span>{% endif %}
      </td>
      <td>{{ row.kind }}</td>
      <td class="num">{{ row.span or '&mdash;' }}</td>
      <td class="num">{% if row.kept %}{{ row.kept }}{% else %}<span class="muted">n/a</span>{% endif %}</td>
      {% for cell in row.metrics %}
      <td class="num{% if cell.flagged %} flag{% endif %}">{{ cell.value }}</td>
      {% endfor %}
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endfor %}

<p class="subtitle" style="margin-top:0.6rem;">
  A condition is a window selection out of the whole-run pass, not a cut of the recording,
  so these rows are comparable with each other and with the run they open on. Long channels
  throughout, and every share in the whole-run row is counted over the full recording the
  same way a condition counts it over its own window. A tree cropped per condition before
  preprocessing is listed under <b>Runs</b> instead: each piece there is filtered against
  its own two edges and lands on its own window grid, so the two kinds do not share a table.
</p>

{% if condition_figures.profile %}
<h2>Condition profile
  <span class="hint">each metric across the conditions, one line per run</span></h2>
<iframe class="plotly-frame" src="{{ condition_figures.profile.src }}"
        title="Metrics by condition"
        style="height:{{ condition_figures.profile.h }}px"></iframe>
{% endif %}

{% if condition_figures.per_run | selectattr('channels') | list %}
<h2>Channel &times; condition
  <span class="hint">which channel moved, and in which block</span></h2>
{% for run in condition_figures.per_run if run.channels %}
{% if condition_figures.per_run | length > 1 %}<h3>{{ run.label }}</h3>{% endif %}
<div class="scroll">
  <iframe src="{{ run.channels.src }}" title="Channel by condition"
          style="border:none;display:block;height:{{ run.channels.h }}px;{% if run.channels.w %}width:{{ run.channels.w }}px{% else %}width:100%{% endif %}"></iframe>
</div>
{% endfor %}
<p class="subtitle" style="margin-top:0.6rem;">
  Colour is the robust z inside one condition, so a cell says how far that channel sat from
  the others in that block rather than how the blocks rank; hover gives the value. The
  panels are the profile's, dropped to the ones with a per-channel form: GVTD is an RMS
  across channels and has none. <b>Coupled windows</b> is added at the end because it is the
  line a channel is rejected on, which is what the kept count above counts. One channel
  order over every panel, the widest mover first.
</p>
{% endif %}

{% if condition_figures.per_run | selectattr('timeline') | list %}
<h2>Metrics over time
  <span class="hint">the conditions shaded behind the windowed metrics</span></h2>
{% for run in condition_figures.per_run if run.timeline %}
{% if condition_figures.per_run | length > 1 %}<h3>{{ run.label }}</h3>{% endif %}
<iframe class="plotly-frame" src="{{ run.timeline.src }}" title="Windowed metrics over time"
        style="height:{{ run.timeline.h }}px"></iframe>
{% endfor %}
<p class="subtitle" style="margin-top:0.6rem;">
  Smoothed over 60 s and sampled at that step, the trend being slower than one QC window.
  Long and short only: <code>all</code> is a blend of the two and lands between them. Each
  band is the colour its condition wears on the run's own report.
</p>
{% endif %}
{% endif %}

{% if channels %}
<h2>Channel rejections</h2>
{% if channels.rejected %}
<div class="scroll">
<table>
  <thead>
    <tr>
      <th>Source-detector</th>
      {% for row in rows %}<th>{{ row.entities.get('task', row.label) }}</th>{% endfor %}
      <th>Runs</th>
    </tr>
  </thead>
  <tbody>
  {% for ch in channels.rejected %}
    <tr>
      <td><code>{{ ch.pair }}</code></td>
      {% for bad in ch.bad_in %}
      <td class="{{ 'ch-bad' if bad else 'ch-ok' }}">{{ "bad" if bad else "&middot;" }}</td>
      {% endfor %}
      <td class="ch-n">{{ ch.n_bad }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}
<p class="subtitle" style="margin-top:0.6rem;">
  {{ channels.n_clean }} of {{ channels.n_pairs }} source-detector pairs survived every run.
  Both wavelengths of a pair are collapsed into one row: rejecting either rejects the optode.
  Read from each run's <code>_channel_metrics.csv</code>; this is the set
  <code>--bads-scope subject</code> takes the union of.
  {% if channels.clean %}
  <br /><span class="muted">Kept everywhere: {{ channels.clean | join(', ') }}</span>
  {% endif %}
</p>
{% endif %}

<h2>Rebuilt by</h2>
<p class="step-desc">This page is assembled from the records under <code>nirs/</code> each
   time either command runs, so it lists whatever is on disk rather than what one command
   produced. The command below is the one that last rebuilt it.</p>
<pre>{{ run_command }}</pre>

{% endblock %}
