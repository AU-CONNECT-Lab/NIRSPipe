{% extends "_report_base.html.j2" %}
{# Cohort-level hyperscanning QC. Extends the shell every other report wears, so the
   only CSS here is the table, which is the group report's own and nothing else's. #}

{% block css %}
.plot-frame { width: 100%; border: none; display: block; }

.summary-grid table.headline th {
  width: auto; color: #8a949e; font-size: 0.75rem; text-transform: uppercase;
  letter-spacing: 0.04em; border-bottom: 1px solid #d8dee5;
}
.summary-grid table.headline td:not(:first-child),
.summary-grid table.headline th:not(:first-child) { text-align: right; }
.summary-grid table.headline td { font-variant-numeric: tabular-nums; }
.summary-grid table.headline td:first-child { color: #34495e; font-weight: 600; }

#group-table-wrap { overflow: auto; max-height: 600px; margin-top: 0.5rem; }
table.group-table {
  width: 100%; border-collapse: collapse; font-size: 0.78rem;
  font-variant-numeric: tabular-nums;
}
table.group-table th, table.group-table td {
  border: none; border-bottom: 1px solid #eef0f3;
  padding: 0.25rem 0.55rem; text-align: right; white-space: nowrap;
}
table.group-table th {
  background: #fff; cursor: pointer; user-select: none;
  position: sticky; top: 0; font-weight: 600; color: #8a949e;
  font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em;
  border-bottom: 1px solid #d8dee5;
}
table.group-table th:first-child, table.group-table td:first-child {
  text-align: left; position: sticky; left: 0; background: #fff;
}
table.group-table th:first-child { z-index: 2; }
table.group-table tbody tr:hover td { background: #f5fbff; }
table.group-table th .sort-ind { color: #ccd2d8; font-size: 0.7rem; margin-left: 0.3rem; }
{% endblock %}

{% block header %}
<div class="page-header">
  <h1>{{ page_heading }}</h1>
  <span class="subtitle">
    {%- for label, value in nav_meta or [] %}{{ label }}: <b>{{ value }}</b> &bull; {% endfor -%}
    {{ run_date }}
  </span>
</div>
{% endblock %}

{% block content %}

{%- set small_caveat %}Only {{ n_rows }} dyads: the cohort median and the outlier rule each
measure how far a dyad sits from the middle of its cohort, and this cohort has no middle to
measure from. Read the panels as the dyads' own values side by side.{% endset %}

<h2 id="Summary">Summary</h2>
<div class="summary-box">
  <div class="summary-grid">
    <table>
      {%- for label, value in summary_meta %}
      <tr><th>{{ label }}</th><td>{{ value | safe }}</td></tr>
      {%- endfor %}
    </table>
    <table class="headline">
      <tr><th>Metric</th><th>Median</th><th>Range</th></tr>
      {%- for row in headline_rows %}
      <tr><td>{{ row.label }}</td><td>{{ row.median }}</td><td>{{ row.range }}</td></tr>
      {%- endfor %}
    </table>
  </div>
  <p class="qm-note" style="margin-top:0.9rem">
    Every panel keeps one row order, the dyads sorted by their shared usable time, so a dyad
    is read across the page rather than looked up in each panel.
  </p>
  {% if small_cohort %}<p class="qm-note">{{ small_caveat }}</p>{% endif %}
</div>

{% if figure_paths.usable_bars %}
<details id="Usable" open>
  <summary>Shared usable time
    <span class="hint">one bar per dyad &bull; a cell is one channel pair in one window
      &bull; usable means coupled in both members at the same moment</span></summary>
  <div class="details-body">
    <p class="step-desc">The intersection, not the smaller of the two members: two members
      can each keep 13 of 14 pairs and share only 12, if the pair they each lose is a
      different one. The middle band is an asymmetric loss, one cap or one electrode, and
      the right band a shared one, both members out at the same moment. Two dyads with the
      same usable share and different middles are two different problems.</p>
    {% if small_cohort %}<p class="qm-note">{{ small_caveat }}</p>{% endif %}
    <iframe class="plot-frame" src="{{ figure_paths.usable_bars.src }}"
            style="height:{{ figure_paths.usable_bars.h }}px"></iframe>
  </div>
</details>
{% endif %}

{% if figure_paths.pair_field %}
<details id="Where" open>
  <summary>Where the time went
    <span class="hint">one dot per cell &bull; dark is usable, pale is lost &bull; pair
      columns ordered worst first</span></summary>
  <div class="details-body">
    <p class="step-desc">A column pale down the whole cohort is the cap or the optode rather
      than the dyad, which is the one finding no single dyad page can carry. The ramp runs
      pale for a lost pair on purpose: nearly every cell is high, so the rare low one should
      be the bright dot in a dark field rather than one shade among many.</p>
    <iframe class="plot-frame" src="{{ figure_paths.pair_field.src }}"
            style="height:{{ figure_paths.pair_field.h }}px"></iframe>
    {% if figure_paths.condition_dials %}
    <p class="qm-note" style="margin-top:1rem">The same share cut by condition on the left,
      comparable across dyads in a way absolute seconds are not; on the right the six dyads
      that lost the most, a ring per condition with the dyad's overall share innermost. The
      field says which dyads are worth opening, the dials what happened inside them.</p>
    <iframe class="plot-frame" src="{{ figure_paths.condition_dials.src }}"
            style="height:{{ figure_paths.condition_dials.h }}px"></iframe>
    {% endif %}
  </div>
</details>
{% elif no_shared_pairs %}
<details id="Where" open>
  <summary>Where the time went &mdash; not available for this cohort</summary>
  <div class="details-body">
    <p class="step-desc">The dyads share no channel pair, so a column of this panel would
      not be the same pair down the page.</p>
  </div>
</details>
{% endif %}

{% if figure_paths.null_strip %}
<details id="Null" open>
  <summary>Coherence against its own null
    <span class="hint">one row per dyad &bull; one marker per window &bull; the band is the
      top {{ "%.0f"|format(100 - alpha) }}%</span></summary>
  <div class="details-body">
    <p class="step-desc">Raw coherence cannot share an axis across windows: the estimator's
      floor moves with the window length, so 0.03 is unremarkable in one window and out of
      reach in another. The rank inside that window's own surrogate null is what is
      comparable, and it is the channel mean's rank, the channels pooled before the
      comparison rather than a hundred draws ranked one channel at a time.</p>
    <iframe class="plot-frame" src="{{ figure_paths.null_strip.src }}"
            style="height:{{ figure_paths.null_strip.h }}px"></iframe>
  </div>
</details>
{% endif %}

{% if table_rows %}
<details id="Table" open>
  <summary>All dyads
    <span class="hint">click a column header to sort &bull; first column sticky &bull;
      the dyad name opens its own report</span></summary>
  <div class="details-body">
    <div id="group-table-wrap">
      <table class="group-table" id="group-table">
        <thead><tr>
          {%- for c in table_columns %}
          <th data-col="{{ loop.index0 }}">{{ c }}<span class="sort-ind">&#8645;</span></th>
          {%- endfor %}
        </tr></thead>
        <tbody>
          {%- for row in table_rows %}
          <tr>
            {%- for v in row %}
            <td>{{ v if v is not none else "&mdash;" }}</td>
            {%- endfor %}
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </div>
</details>
{% endif %}

{% endblock %}

{% block scripts %}
<script>
(function() {
  var table = document.getElementById("group-table");
  if (table) {
    var thead = table.querySelector("thead");
    var tbody = table.querySelector("tbody");
    var asc = {};
    var cellValue = function(td) {
      var v = td.textContent.trim().replace("%", "").replace(" s", "");
      if (v === "" || v === "—") return null;
      var n = Number(v);
      return Number.isFinite(n) ? n : v.toLowerCase();
    };
    thead.querySelectorAll("th").forEach(function(th) {
      th.addEventListener("click", function() {
        var col = +th.dataset.col;
        var direction = asc[col] = !asc[col];
        var rows = Array.from(tbody.querySelectorAll("tr"));
        rows.sort(function(a, b) {
          var va = cellValue(a.children[col]);
          var vb = cellValue(b.children[col]);
          if (va === null && vb === null) return 0;
          if (va === null) return 1;
          if (vb === null) return -1;
          if (va < vb) return direction ? -1 : 1;
          if (va > vb) return direction ? 1 : -1;
          return 0;
        });
        rows.forEach(function(r) { tbody.appendChild(r); });
        thead.querySelectorAll(".sort-ind").forEach(function(s) { s.textContent = "⇅"; });
        th.querySelector(".sort-ind").textContent = direction ? "▲" : "▼";
      });
    });
  }
  window.addEventListener("message", function(e) {
    if (!e.data || e.data.type !== "iframe-resize") return;
    var all = document.querySelectorAll("iframe");
    for (var i = 0; i < all.length; i++) {
      if (all[i].contentWindow === e.source) {
        all[i].style.height = e.data.h + "px";
        return;
      }
    }
  });
})();
</script>
{% endblock %}
