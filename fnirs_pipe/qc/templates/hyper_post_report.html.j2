<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<title>fnirs-pipe Hyper Post Report — {{ group_id }} / {{ task }}</title>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
<style>
*, *::before, *::after { box-sizing: border-box; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 13px; color: #2c3e50;
  margin: 0; padding: 0.6rem 0.8rem 2rem;
  background: #f5f7fa;
}
h1 { font-size: 1.05rem; margin: 0; }

#qc-nav {
  position: sticky; top: 0; z-index: 100;
  background: #fff; border-bottom: 1px solid #dde3ea;
  padding: 0.4rem 0.8rem;
  display: flex; align-items: center; gap: 1rem;
  box-shadow: 0 1px 6px rgba(0,0,0,0.07);
  margin: -0.6rem -0.8rem 0.6rem;
  flex-wrap: wrap;
}
.nav-meta { font-size: 0.78rem; color: #6c757d; }

.card {
  background: #fff; border: 1px solid #dde3ea; border-radius: 6px;
  overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  margin-bottom: 0.5rem;
}

.panel-title {
  font-size: 0.78rem; font-weight: 600; color: #6c757d;
  padding: 0.3rem 0.6rem; border-bottom: 1px solid #dde3ea;
  background: #f8f9fa; display: flex; align-items: center; gap: 0.5rem;
  flex-wrap: wrap;
}
.panel-hint { font-weight: 400; color: #aaa; }

select#ch-select-post {
  font-size: 0.78rem; border: 1px solid #ced4da; border-radius: 4px;
  padding: 0.15rem 0.35rem; background: #fff; margin-left: auto; max-width: 220px;
}

#align-table { border-collapse: collapse; width: 100%; font-size: 0.82rem; }
#align-table th, #align-table td {
  border: 1px solid #dde3ea; padding: 0.28rem 0.55rem; text-align: left;
}
#align-table th { background: #f1f3f5; font-weight: 600; }
#align-table tbody tr:hover { background: #f8f9fa; }
.align-wrap { padding: 0.5rem 0.8rem; }
</style>
</head>
<body>

<nav id="qc-nav">
  <h1>fnirs&#8209;pipe &nbsp; Hyper Post Report</h1>
  <span class="nav-meta">group: <b>{{ group_id }}</b></span>
  <span class="nav-meta">task: <b>{{ task }}</b></span>
  <span class="nav-meta">subjects: <b>{{ subject_ids | join(", ") }}</b></span>
  <span class="nav-meta" style="margin-left:auto">
    WTC: {{ "%.3f"|format(wtc_fmin) }}–{{ "%.3f"|format(wtc_fmax) }} Hz
  </span>
</nav>

<!-- Alignment table -->
<div class="card">
  <div class="panel-title">Time Alignment
    <span class="panel-hint">crop offset from first shared trigger &bull; all recordings trimmed to shortest</span>
  </div>
  <div class="align-wrap">
    <table id="align-table">
      <thead><tr><th>Subject</th><th>Offset (s)</th><th>Aligned duration (s)</th></tr></thead>
      <tbody id="align-tbody"></tbody>
    </table>
  </div>
</div>

<!-- Per-channel WTC -->
<div class="card">
  <div class="panel-title">
    Wavelet Transform Coherence (per channel)
    <span class="panel-hint">
      Morlet wavelet &bull; white dashed = COI boundary &bull;
      regions below COI may be affected by edge effects
    </span>
    <select id="ch-select-post"></select>
  </div>
  <div id="wtc-plot"></div>
</div>

<!-- ISC panel — HbO -->
{% if isc_panel_hbo_b64 %}
<div class="card">
  <div class="panel-title">
    Inter-brain Synchrony — HbO
    <span class="panel-hint">
      topomap (per-channel ISC) &bull; ISC matrix (channel &times; channel Pearson r) &bull;
      connectogram (|ISC| &ge; {{ "%.2f"|format(isc_threshold) }}) &bull;
      <span style="color:#8e44ad">&#9632;</span> {{ subject_ids[0] }}
      <span style="color:#27ae60">&#9632;</span> {{ subject_ids[1] }}
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    <img src="data:image/png;base64,{{ isc_panel_hbo_b64 }}" style="max-width:100%"/>
  </div>
</div>
{% endif %}

<!-- ISC panel — HbR -->
{% if isc_panel_hbr_b64 %}
<div class="card">
  <div class="panel-title">
    Inter-brain Synchrony — HbR
    <span class="panel-hint">
      topomap (per-channel ISC) &bull; ISC matrix (channel &times; channel Pearson r) &bull;
      connectogram (|ISC| &ge; {{ "%.2f"|format(isc_threshold) }}) &bull;
      <span style="color:#8e44ad">&#9632;</span> {{ subject_ids[0] }}
      <span style="color:#27ae60">&#9632;</span> {{ subject_ids[1] }}
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    <img src="data:image/png;base64,{{ isc_panel_hbr_b64 }}" style="max-width:100%"/>
  </div>
</div>
{% endif %}

<script>
var _PER_CH   = {{ per_channel_post_json | safe }};
var _CH_PAIRS = {{ ch_pairs_post_json | safe }};
var _ALIGN    = {{ alignment_json | safe }};
var _cfg = { responsive: true, displayModeBar: true };

// alignment table
(function() {
  var tbody = document.getElementById("align-tbody");
  _ALIGN.forEach(function(row) {
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + row.subject_id + "</td>" +
      "<td>" + (row.offset_s   !== null ? row.offset_s.toFixed(3)   : "—") + "</td>" +
      "<td>" + (row.duration_s !== null ? row.duration_s.toFixed(1) : "—") + "</td>";
    tbody.appendChild(tr);
  });
})();

// channel selector
(function() {
  var sel = document.getElementById("ch-select-post");
  _CH_PAIRS.forEach(function(pair, i) {
    var opt = document.createElement("option");
    opt.value = i; opt.textContent = pair;
    sel.appendChild(opt);
  });
  sel.addEventListener("change", function() { _selectCh(parseInt(this.value)); });
})();

function _selectCh(idx) {
  var pair = _CH_PAIRS[idx];
  var ch   = _PER_CH[pair] || {};
  if (ch.wtc) Plotly.react("wtc-plot", ch.wtc.data, ch.wtc.layout, _cfg);
  else        Plotly.purge("wtc-plot");
}

window.addEventListener("DOMContentLoaded", function() {
  if (_CH_PAIRS.length > 0) _selectCh(0);
});
</script>
</body>
</html>
