{% extends "_report_base.html.j2" %}
{% from "_macros.html.j2" import subject_metrics %}

{# The height every coherence map on this page is read at, still or live. One number, so a
   channel panel and the ROI panel under it cannot drift apart. #}
{% set MAP_FRAME_H = 600 %}

{% block css %}
.map-pick { display: flex; align-items: center; gap: 0.3rem; margin: 0.2rem 0 0.4rem; }
.map-pick select {
  font-size: 0.8rem; border: 1px solid #ced4da; border-radius: 4px;
  padding: 0.15rem 0.35rem; background: #fff; max-width: 220px;
}
/* The two sides of a crossed pairing read left to right, so the separator has to say
   which member each selector belongs to rather than just sitting between them. */
.map-pick .pick-x { font-size: 0.8rem; color: #868e96; }
/* Both chromophores are on the page at once, stacked, so nothing is behind a control and
   a reader cannot be comparing an HbO channel against an HbR region without noticing. */
.chroma-stack + .chroma-stack { border-top: 1px solid #e9ecef; margin-top: 0.6rem;
                                padding-top: 0.5rem; }
.chroma-stack > .chroma-name {
  display: inline-block; font-size: 0.8rem; font-weight: 600; color: #495057;
  letter-spacing: 0.03em; margin: 0 0 0.1rem 0.1rem;
}
/* The channel map is a still drawn at 100% of a page that has no maximum width, so on a
   wide monitor it grew past the live ROI map stacked under it and the two panels of one
   section read at two different sizes. Capped at that map's height ({{ MAP_FRAME_H }}px,
   the iframes below), after which it keeps its aspect and centres instead of growing. */
.chroma-stack > img.responsive {
  max-height: {{ MAP_FRAME_H }}px; width: auto; max-width: 100%; margin: 0 auto;
}
/* The one block-level warning this page can raise. Everything else that used to be an
   orange panel is a .qm-note, the grey aside the subject report explains itself with:
   a caveat printed on every page stops being read as a caveat. */
.too-short { color: var(--warn); font-size: 0.8rem; border-left: 3px solid var(--warn);
             padding: 0.3rem 0.7rem; margin: 0.6rem 0; }
{% endblock %}

{# One entry per rated section, anchored to the heading it names, the way a subject report's
   bar is built. The id carries this page's own stem so the run and each of its conditions
   are rated separately rather than sharing one verdict. #}
{% set _rk = "__" ~ page_stem %}
{% set _bar = [
  {"id": "Summary", "name": "Summary", "href": "#Final", "ratable": false},
  {"sep": true},
  {"id": "Alignment" ~ _rk, "name": "Alignment", "href": "#Alignment"},
  {"id": "Coherence" ~ _rk, "name": "Coherence", "href": "#Coherence"},
  {"id": "ISC" ~ _rk,       "name": "ISC",       "href": "#ISC"},
  {"id": "Numbers" ~ _rk,   "name": "Numbers",   "href": "#Numbers", "ratable": false},
  {"id": "Quality" ~ _rk,   "name": "Quality",   "href": "#Quality"},
] %}
{% set _ = _bar.append({"sep": true}) %}
{% set _ = _bar.append({"id": "Provenance", "name": "Provenance", "href": "#Provenance",
                        "ratable": false}) %}
{% set _ = _bar.append({"id": "Methods", "name": "Methods", "href": "#Methods",
                        "ratable": false}) %}
{% if nav_links %}
  {% set _ = _bar.append({"sep": true}) %}
  {% for link in nav_links %}
    {% set _ = _bar.append({"id": "page" ~ loop.index, "name": link.label,
                            "href": false if link.current else link.href,
                            "ratable": false}) %}
  {% endfor %}
{% endif %}

{% set rating_subject = page_stem %}
{% set rating_modules = [_bar] %}
{% set rating_pinned = [{"id": "Final" ~ _rk, "name": "FINAL", "href": "#Final"}] %}
{% set rating_chip = "group-" ~ group_id %}
{% set rating_save_endpoint = "/save_hyper_ratings" %}
{% set rating_load_endpoint = "/load_hyper_ratings/" ~ page_stem %}

{# The dyad report reads as a document, so its header is a titled band rather than the
   sticky nav bar the dashboard reports carry. #}
{% block header %}
<div class="page-header">
  <h1>{{ page_heading }}</h1>
  <span class="subtitle">dyad post QC &bull;
    v{{ versions.get('fnirs-pipe', 'unknown') }} &bull; {{ run_date }}</span>
</div>
{% endblock %}

{% block content %}

<!-- ============================================================== summary -->
<h2 id="Final">Summary</h2>
<div class="summary-box">
  <div class="summary-grid">
    <table>
      <tr><th>Group</th><td>group-{{ group_id }}</td></tr>
      <tr><th>Task</th><td>{{ task }}</td></tr>
      <tr><th>Members</th><td>{{ subject_ids | join(' &times; ') | safe }}</td></tr>
      <tr>
        <th>Scope</th>
        <td>
          {%- if condition_label %}condition &ldquo;{{ condition_label }}&rdquo;
            {%- if condition_window %}, {{ condition_window }}{% endif %}
          {%- elif analysis_window %}whole run, restricted to {{ analysis_window }}
          {%- else %}whole run{% endif %}
        </td>
      </tr>
      <tr><th>Date</th><td>{{ run_date }}</td></tr>
      <tr><th>fnirs-pipe</th><td>v{{ versions.get('fnirs-pipe', 'n/a') }}</td></tr>
      <tr><th>MNE</th><td>v{{ versions.get('mne', 'n/a') }}</td></tr>
      <tr><th>Python</th><td>{{ versions.get('python', 'n/a') }}</td></tr>
    </table>
    <table>
      <tr><th>WTC range</th>
          <td>{{ "%.3f"|format(wtc_fmin) }}&ndash;{{ "%.3f"|format(wtc_fmax) }}&thinsp;Hz</td></tr>
      <tr><th>Band mean over</th>
          <td>{{ "%.3f"|format(wtc_band_fmin) }}&ndash;{{ "%.3f"|format(wtc_band_fmax) }}&thinsp;Hz
            {%- if window_cycles %} &bull; {{ "%.0f"|format(window_cycles) }} cycles of the slowest
            band frequency{% endif %}</td></tr>
      <tr><th>Chromophores</th><td>{{ wtc_chroma_labels | join(' + ') }}</td></tr>
      <tr><th>Arrow threshold</th><td>{{ "%g"|format(arrow_min) }}</td></tr>
      <tr><th>Outside the COI</th><td>{{ "masked out of every band mean" if mask_coi
                                        else "kept in the band means" }}</td></tr>
      <tr><th>ISC chords</th><td>{{ isc_arc_rule }}</td></tr>
      <tr><th>SCI threshold</th><td>{{ "%.2f"|format(sci_threshold) }}</td></tr>
      <tr><th>Aligned duration</th>
          <td>{% if align_duration_s %}{{ "%.1f"|format(align_duration_s) }}&thinsp;s
              {%- else %}&mdash;{% endif %}</td></tr>
      <tr><th>Max crop offset</th>
          <td>{{ "%.3f"|format(align_max_offset_s) }}&thinsp;s</td></tr>
    </table>
  </div>

  <p class="qm-note" style="margin-top:0.75rem;">
    {%- if condition_label %}
    Every panel below is this window read out of the whole-run transform, so it carries the
    recording&rsquo;s cone of influence and not two edges of its own.
    {%- elif analysis_window %}
    Restricted to {{ analysis_window }} by <code>--tstart</code>/<code>--tend</code>, taken
    out of the transform of the whole recording rather than cut from it. The coherence is
    averaged across every condition inside that window.
    {%- else %}
    The coherence over the whole recording, averaged across every condition in it. The
    per-condition pages are the ones to read for a block design.
    {%- endif %}
  </p>

  {% if window_cycles and window_cycles < min_band_cycles %}
  <div class="too-short">
    This window holds only {{ "%.1f"|format(window_cycles) }} cycles of
    <code>--wtc-band-fmin</code>, the slowest frequency being averaged. A coherence there is
    a statement about a phase relationship this window has seen about that many times, so
    the low-frequency end of every number below rests on very few independent looks at it.
    Four to six cycles is the usual minimum. Raise <code>--wtc-band-fmin</code>, or read
    that end as indicative. Nothing is masked or dropped on account of this.
  </div>
  {% endif %}

  {#- Both of these are what the rest of the page is read against rather than findings of
      their own: the clocks convert a dyad window to a member's own record, and the ROI map
      says what every per-ROI panel below was averaged over. The raw dyad report carries its
      clocks the same way. -#}
  <div class="summary-grid" style="margin-top:1.1rem;">
    <div id="Alignment">
      <h3 style="margin:0 0 0.3rem;">The two clocks</h3>
      <p class="qm-note">Crop offset from the first shared trigger; all recordings are then
        trimmed to the shortest. A dyad window is on the aligned clock and a member&rsquo;s
        own record is on its own, and this table is what converts between them.</p>
      <table class="qm-table qm-flat" id="align-table">
        <thead><tr><th>Member</th><th>Offset (s)</th><th>Aligned duration (s)</th></tr></thead>
        <tbody id="align-tbody"></tbody>
      </table>
    </div>
    {% if roi_rows %}
    <div id="ROI">
      <h3 style="margin:0 0 0.3rem;">ROI grouping</h3>
      <p class="qm-note">The channel-to-region mapping from <code>--roi-mapping</code>, which
        is what the per-ROI panels below are averaged over.</p>
      <table class="qm-table qm-flat" id="roi-table">
        <thead><tr><th>ROI</th><th>Channels</th></tr></thead>
        <tbody>
        {% for row in roi_rows %}
          <tr><td><b>{{ row.roi }}</b></td><td>{{ row.channels | join(", ") }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </div>

  <h3 style="margin-top:1rem;">Run command</h3>
  <pre>{{ run_command }}</pre>
</div>

<!-- =========================================================== coherence -->
<h2 id="Coherence">Wavelet Transform Coherence</h2>

{#- the chromophore note: about every panel in this section rather than about any one of
    them, so it opens the section instead of standing as a panel of its own -#}
<p class="step-desc">
  Every panel below shows {{ wtc_chroma_labels | join(" above ") }}, stacked and labelled,
  and <code>hyper-wtc.tsv</code> carries {{ wtc_chroma_labels | join(" and ") }} in a
  <code>chromophore</code> column. <b>HbO and HbR are two parallel passes, never mixed and
  never averaged.</b> The reason to have both is a consistency check, not two results: HbO
  has the larger amplitude and the better SNR, HbR is the less contaminated by scalp and
  systemic circulation, so a coupling that shows in HbO and not in HbR is a caution flag. It
  is not a quantitative test &mdash; coherence is unsigned and bounded, so there is no
  expected relationship between an HbO value and an HbR one. Read it as present or absent.
  The maps are the panels that stack: a map is one pairing and there is nothing to compare
  inside it. The two matrix panels put the chromophores side by side on one colour scale
  instead, which is that check in one figure, and the inter-brain correlation panels below
  do the same.
</p>

<details id="WTCChannel" open>
  <summary>a. Per channel</summary>
  <div class="details-body">
    <p class="step-desc">Morlet wavelet. Arrows are relative phase, right in phase and up
      {{ subject_ids[0] }} leading; the washed-out band below the white dash sits outside the
      cone of influence.
      {%- if chan_crossed %} The left selector is {{ subject_ids[0] }} and the right
      {{ subject_ids[1] }}, the order the map title reads in.{% endif %}</p>
    <div class="map-pick">
      <select id="ch-select-post" aria-label="{{ subject_ids[0] }} channel"></select>
      {% if chan_crossed %}
      <span class="pick-x">&times;</span>
      <select id="ch-select-post-2" aria-label="{{ subject_ids[1] }} channel"></select>
      {% endif %}
    </div>
    {% for c in wtc_chroma_labels %}
    <div class="chroma-stack">
      <span class="chroma-name">{{ c }}</span>
      <img class="responsive" id="wtc-chan-img-{{ loop.index0 }}"
           alt="channel coherence map ({{ c }})" />
    </div>
    {% endfor %}
  </div>
</details>

{% if roi_rows %}
<details id="WTCRoi" open>
  <summary>b. Per ROI</summary>
  <div class="details-body">
    <p class="step-desc">The member channels&rsquo; maps averaged cell by cell, bad channels
      excluded; arrows and cone as above. <b>These ones are live</b>: hover for the time,
      frequency and coherence under the pointer, and drag to zoom. The per-channel maps
      above stay stills because there are an order of magnitude more of them.
      {%- if roi_crossed %} The left selector is {{ subject_ids[0] }} and the right
      {{ subject_ids[1] }}, so an off-diagonal pairing reads at the size of a homologous
      one.{% endif %}</p>
    <div class="map-pick">
      <select id="roi-select-post" aria-label="{{ subject_ids[0] }} region"></select>
      {% if roi_crossed %}
      <span class="pick-x">&times;</span>
      <select id="roi-select-post-2" aria-label="{{ subject_ids[1] }} region"></select>
      {% endif %}
    </div>
    {% for c in wtc_chroma_labels %}
    <div class="chroma-stack">
      <span class="chroma-name">{{ c }}</span>
      <iframe class="plotly-frame" id="wtc-roi-frame-{{ loop.index0 }}"
              title="ROI coherence map ({{ c }})"
              style="height:{{ MAP_FRAME_H }}px"></iframe>
    </div>
    {% endfor %}
  </div>
</details>

{% if wtc_roi_matrix.wtc %}
<details id="wtc-roi-matrix-card" open>
  <summary>c. ROI &times; ROI</summary>
  <div class="details-body">
    <p class="step-desc">Band mean per ROI pair, inside the COI: one number per map the
      selectors above reach, and the rows of <code>hyper-wtc-roichan.tsv</code>.
      {%- if wtc_chroma_labels | length > 1 %} {{ wtc_chroma_labels | join(" left, ") }}
      right, on one colour scale: reading them side by side is the consistency check the two
      chromophores are run for.{% endif %} Live, so hover names the pairing and prints its
      value.</p>
    <iframe class="plotly-frame" src="{{ wtc_roi_matrix.wtc }}"
            title="ROI by ROI coherence"
            style="height:{{ wtc_roi_matrix.h or 720 }}px"></iframe>
    <p class="fig-path">{{ wtc_roi_matrix.wtc }}</p>
  </div>
</details>
{% endif %}
{% endif %}

{% if wtc_chan_matrix.wtc %}
<details id="wtc-chan-matrix-card" open>
  <summary>{{ "d" if roi_rows else "b" }}. Channel &times; channel</summary>
  <div class="details-body">
    <p class="step-desc">Band mean per channel pair, row = {{ subject_ids[0] }} and column =
      {{ subject_ids[1] }}: one number per map the selectors above reach, and the rows of
      <code>hyper-wtc.tsv</code>. There is no within-brain cell anywhere in it. Hover a cell
      to see which pairing it is.</p>
    <iframe class="plotly-frame" src="{{ wtc_chan_matrix.wtc }}"
            title="channel by channel coherence"
            style="height:{{ wtc_chan_matrix.h or 720 }}px"></iframe>
    <p class="fig-path">{{ wtc_chan_matrix.wtc }}</p>
  </div>
</details>
{% endif %}

<!-- ================================================= inter-brain synchrony -->
{% if isc_panel_hbo.wtc or isc_panel_hbr.wtc %}
<h2 id="ISC">Inter-brain Synchrony</h2>
<p class="step-desc">
  Pearson r between the two members' time courses, every site of one against every site of
  the other, {% if condition_label %}over this window only, z-scored inside it
  {%- else %}over the whole recording{% endif %}. The channel panels pair their matrix with
  a connectogram ({{ isc_arc_rule }}); the ROI matrix has no null to rank pairings by and
  draws none.
  <span style="color:#8e44ad">&#9632;</span> {{ subject_ids[0] }}
  <span style="color:#27ae60">&#9632;</span> {{ subject_ids[1] }}
</p>
{% if isc_unfiltered_note %}<p class="qm-note">{{ isc_unfiltered_note }}</p>{% endif %}

{% if isc_roi_matrix.wtc %}
<details id="ISCRoiMatrix" open>
  <summary>a. ROI &times; ROI</summary>
  <div class="details-body">
    <p class="step-desc">The channel values of <code>hyper-isc-*.tsv</code> averaged in
      Fisher z inside each ROI pair, so this rests on the same channels the ROI coherence
      above does. Row = {{ subject_ids[0] }} and column = {{ subject_ids[1] }}, diagonal =
      the homologous region.
      {%- if wtc_chroma_labels | length > 1 %} {{ wtc_chroma_labels | join(" left, ") }}
      right, on one colour scale.{% endif %} Hover a cell to see which pairing it is.</p>
    <iframe class="plotly-frame" src="{{ isc_roi_matrix.wtc }}"
            title="ROI by ROI inter-brain synchrony"
            style="height:{{ isc_roi_matrix.h or 720 }}px"></iframe>
    <p class="fig-path">{{ isc_roi_matrix.wtc }}</p>
  </div>
</details>
{% endif %}

{% if isc_panel_hbo.wtc %}
<details id="ISCHbo" open>
  <summary>{{ "b" if isc_roi_matrix.wtc else "a" }}. HbO</summary>
  <div class="details-body">
    <iframe class="plotly-frame" src="{{ isc_panel_hbo.wtc }}"
            title="inter-brain synchrony, HBO"
            style="height:{{ isc_panel_hbo.h or 720 }}px"></iframe>
    <p class="fig-path">{{ isc_panel_hbo.wtc }}</p>
  </div>
</details>
{% endif %}

{% if isc_panel_hbr.wtc %}
<details id="ISCHbr" open>
  <summary>{{ "c" if isc_roi_matrix.wtc else "b" }}. HbR</summary>
  <div class="details-body">
    <iframe class="plotly-frame" src="{{ isc_panel_hbr.wtc }}"
            title="inter-brain synchrony, HBR"
            style="height:{{ isc_panel_hbr.h or 720 }}px"></iframe>
    <p class="fig-path">{{ isc_panel_hbr.wtc }}</p>
  </div>
</details>
{% endif %}
{% endif %}

<!-- ============================================================== numbers -->
{% if number_tables %}
<h2 id="Numbers">The numbers</h2>
<p class="step-desc">Every value the panels above were drawn from, one row per pairing
  {%- if condition_label %} over this window
  {%- else %}, each condition beside the whole run, which is the comparison no single panel
  above can show{% endif %}. Not rounded anywhere but here:
  <code>hyper-wtc.tsv</code>, <code>hyper-wtc-roichan.tsv</code> and
  <code>hyper-isc-*.tsv</code> under the group&rsquo;s <code>nirs/</code> carry the same
  numbers at full precision. <b>% in COI</b> beside a column group is the share of that
  window&rsquo;s band cells that survived the cone of influence, which is the one thing
  behind a WTC mean that no figure here shows. It is one number per window rather than per
  pairing, the cone depending on the window length and the band and not on the channels: a
  coherence resting on a third of its cells is not the same measurement as one that kept all
  of them.</p>
{#- one table per kind of pairing, not one grid announcing each kind on a row spanning it.
    A crossed dyad's channel table is hundreds of rows and the ROI tables are a handful, so
    they were never read side by side; separate tables let each carry only the columns it
    filled. -#}
<div class="qm-box">
  {% for table in number_tables %}
  <p class="qm-sub">{{ table.kind }} ({{ table.rows | length }})</p>
  <div class="num-scroll">
    <table class="qm-table num-table">
      {#- the two label columns to one width across the tables, which auto layout gives
          them only by accident: they hold an ROI name in one table and a channel in the
          next -#}
      <colgroup><col class="idcol"><col class="idcol"></colgroup>
      <thead>
        <tr>
          <th rowspan="2">{{ subject_ids[0] }}</th><th rowspan="2">{{ subject_ids[1] }}</th>
          {%- for scope in table.scopes %}
          <th colspan="{{ table.columns | length }}" class="grp">{{ scope.label }}
            {%- if scope.valid %} <span class="hdr-note">{{ scope.valid }}</span>{% endif %}
          </th>
          {%- endfor %}
        </tr>
        <tr>
          {%- for scope in table.scopes %}{% for col in table.columns %}
          <th{% if loop.first %} class="grp"{% endif %}>{{ col }}</th>
          {%- endfor %}{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in table.rows %}
        <tr><td>{{ row.a }}</td><td>{{ row.b }}</td>
          {%- for scope in table.scopes %}{% for col in table.columns %}
          <td{% if loop.first %} class="grp"{% endif %}
            >{{ row.cells.get(scope.label, {}).get(col) or "&mdash;" | safe }}</td>
          {%- endfor %}{% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endfor %}
  <p class="qm-note">An ROI value is the mean of the channel pairs inside the two regions,
    not a second analysis of an averaged signal. The ROI WTC is the plain mean of those
    coherences and the ROI ISC the Fisher z mean of those correlations, a correlation being
    signed where a coherence is not.</p>
</div>
{% endif %}

<!-- ================================================== per-subject quality -->
{% if subject_metrics_rows %}
<h2 id="Quality">Per-subject quality</h2>
<div class="qm-box">
  <p class="step-desc">One table per channel set. &uarr; / &darr; marks the better
    direction; SCI is coloured against this run&rsquo;s own threshold and HbO&ndash;HbR by
    sign. Last on the page for the reason the subject report puts its own metrics after the
    pictures: these are each member&rsquo;s numbers, and what the page is about is the pair.</p>
  {{ subject_metrics(subject_metrics_rows) }}
  <p class="qm-note">Each table is its own measurement, not a subset of the one above it:
    GVTD is an RMS across the channels of its set and a retention rate is a fraction of
    them. The coherence is computed on the long channels.</p>
  {% if condition_label %}
  <p class="qm-note">Over this window only, read off each member&rsquo;s own record, so
    these are the numbers that member&rsquo;s per-condition page prints. A blank row is one
    the record has no per-condition value for. This reports, it does not re-decide: the
    channel set is the whole recording&rsquo;s, since one montage has to serve every
    condition, so a channel that came loose here is still in.
    <a href="{{ run_href }}">Whole-run page</a>.</p>
  {% endif %}
</div>
{% elif condition_label %}
<h2 id="Quality">Per-subject quality &mdash; not available for this window</h2>
<div class="qm-box">
  <p class="qm-note">Neither member&rsquo;s record carries a <code>by_condition</code>
    section, so nothing is shown rather than the whole recording&rsquo;s numbers under this
    condition&rsquo;s heading. Those are on the
    <a href="{{ run_href }}">whole-run page</a>; re-running <code>fnirs-pipe</code> on
    these subjects writes the section.</p>
</div>
{% endif %}

<script>
var _CHROMA       = {{ wtc_chroma_json | safe }};
var _PER_CH       = {{ per_channel_post_json | safe }};
var _CH_PAIRS     = {{ ch_pairs_post_json | safe }};
var _BAD_PAIRS    = {{ bad_pairs_json | safe }};
var _PER_ROI      = {{ per_roi_post_json | safe }};
var _ROI_LABELS   = {{ roi_labels_json | safe }};
var _ALIGN        = {{ alignment_json | safe }};

// Nothing on this page is behind a chromophore control any more: every panel carries one
// image per chromophore, stacked and labelled, and _CHROMA is the order they sit in. What a
// variable below holds is a path under figures/, never the figure, so picking a channel
// points an img somewhere else and the browser fetches that one file.
function _img(el, d) {
  if (!el) return;
  var src = d && d.wtc;
  if (src) { el.src = src;               el.style.display = ""; }
  else     { el.removeAttribute("src");  el.style.display = "none"; }
}

// the ROI maps are live figures in their own pages, so the entry carries a height beside
// the same `wtc` URL a still would have put there
function _frame(el, d) {
  if (!el) return;
  if (d && d.wtc) {
    el.src = d.wtc;
    if (d.h) el.style.height = d.h + "px";
    el.style.display = "";
  } else {
    el.removeAttribute("src");
    el.style.display = "none";
  }
}

// alignment table
(function() {
  var tbody = document.getElementById("align-tbody");
  _ALIGN.forEach(function(row) {
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + row.subject_id + "</td>" +
      "<td>" + (row.offset_s   !== null ? row.offset_s.toFixed(3)   : "—") + "</td>" +
      "<td>" + (row.duration_s !== null ? row.duration_s.toFixed(1) : "—") + "</td>";
    tbody.appendChild(tr);
  });
})();

// Both map panels are a pair of selectors over one nested {sub1: {sub2: {...}}} table.
// An uncrossed run has only the diagonal and the template leaves the second selector out,
// so `_pick` falls back to the first one's label and the lookup is the same either way.
function _fill(sel, labels, mark) {
  if (!sel) return;
  labels.forEach(function(label, i) {
    var opt = document.createElement("option");
    opt.value = i;
    opt.textContent = (mark && mark.indexOf(label) >= 0) ? label + " (bad)" : label;
    sel.appendChild(opt);
  });
}

// One image per chromophore, in _CHROMA order, which is the order the template stacked them.
function _pick(maps, labels, id1, id2, base, setter) {
  var sel1 = document.getElementById(id1);
  var sel2 = document.getElementById(id2);
  if (!sel1 || !labels.length) return;
  var a = labels[parseInt(sel1.value) || 0];
  var b = sel2 ? labels[parseInt(sel2.value) || 0] : a;
  _CHROMA.forEach(function(c, i) {
    setter(document.getElementById(base + "-" + i),
           ((maps[c] || {})[a] || {})[b]);
  });
}

function _selectCh() {
  _pick(_PER_CH, _CH_PAIRS, "ch-select-post", "ch-select-post-2", "wtc-chan-img", _img);
}

function _selectRoi() {
  _pick(_PER_ROI, _ROI_LABELS, "roi-select-post", "roi-select-post-2",
        "wtc-roi-frame", _frame);
}

(function() {
  ["ch-select-post", "ch-select-post-2"].forEach(function(id) {
    var sel = document.getElementById(id);
    _fill(sel, _CH_PAIRS, _BAD_PAIRS);
    if (sel) sel.addEventListener("change", _selectCh);
  });
  ["roi-select-post", "roi-select-post-2"].forEach(function(id) {
    var sel = document.getElementById(id);
    _fill(sel, _ROI_LABELS, null);
    if (sel) sel.addEventListener("change", _selectRoi);
  });
})();

// the live ROI figures resize themselves; same protocol figure_io.py writes into every page
window.addEventListener("message", function(e) {
  if (!e.data || e.data.type !== "iframe-resize") return;
  var frames = document.querySelectorAll("iframe");
  for (var i = 0; i < frames.length; i++) {
    if (frames[i].contentWindow === e.source) {
      frames[i].style.height = e.data.h + "px";
      return;
    }
  }
});

window.addEventListener("DOMContentLoaded", function() {
  _selectCh();
  _selectRoi();
});
</script>

{% endblock %}
