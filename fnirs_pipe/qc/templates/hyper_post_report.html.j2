{% extends "_report_base.html.j2" %}
{% from "_macros.html.j2" import card, subject_metrics %}

{% block head_extra %}
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
{%- endblock %}

{% block css %}
select#ch-select-post {
  font-size: 0.78rem; border: 1px solid #ced4da; border-radius: 4px;
  padding: 0.15rem 0.35rem; background: #fff; margin-left: auto; max-width: 220px;
}
{% endblock %}

{% block content %}

<!-- Alignment table -->
{% call card("Time Alignment", hint="crop offset from first shared trigger &bull; all recordings trimmed to shortest") %}
<div class="align-wrap">
  <table id="align-table">
    <thead><tr><th>Subject</th><th>Offset (s)</th><th>Aligned duration (s)</th></tr></thead>
    <tbody id="align-tbody"></tbody>
  </table>
</div>
{% endcall %}

<!-- Per-subject quality metrics -->
{% if subject_metrics_rows %}
{% call card("Per-subject Quality Metrics", hint="↑ / ↓ = better direction &bull; SCI coloured against the threshold, HbO-HbR by sign") %}
<div class="subj-metrics-wrap">
  {{ subject_metrics(subject_metrics_rows, subject_ids) }}
</div>
{% endcall %}
{% endif %}

<!-- ROI grouping -->
{% if roi_rows %}
{% call card("ROI Grouping", hint="channel-to-region mapping from --roi-mapping") %}
<div class="align-wrap">
  <table id="roi-table">
    <thead><tr><th>ROI</th><th>Channels</th></tr></thead>
    <tbody>
    {% for row in roi_rows %}
      <tr>
        <td><b>{{ row.roi }}</b></td>
        <td>{{ row.channels | join(", ") }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endcall %}
{% endif %}

<!-- Per-channel WTC -->
<div class="card">
  <div class="panel-title">
    Wavelet Transform Coherence (per channel)
    <span class="panel-hint">
      Morlet wavelet &bull; white dashed = COI boundary &bull;
      regions below COI may be affected by edge effects
    </span>
    <select id="ch-select-post"></select>
  </div>
  <div id="wtc-plot"></div>
</div>

<!-- Per-ROI WTC -->
{% if roi_rows %}
<div class="card">
  <div class="panel-title">
    Wavelet Transform Coherence (per ROI)
    <span class="panel-hint">
      WTC on HbO averaged within each ROI (bad channels excluded) &bull; white dashed = COI boundary
    </span>
    <select id="roi-select-post"></select>
  </div>
  <div id="wtc-roi-plot"></div>
</div>

<div class="card" id="wtc-roi-matrix-card" style="display:none">
  <div class="panel-title">
    Wavelet Transform Coherence (ROI &times; ROI)
    <span class="panel-hint">
      band mean per ROI pair, inside the COI &bull; diagonal = homologous ROIs, the ones
      plotted above &bull; same numbers as <code>hyper-wtc-roi.tsv</code>
    </span>
  </div>
  <div id="wtc-roi-matrix-plot"></div>
</div>

{% if wtc_roi_grid_b64 %}
<div class="card">
  <div class="panel-title">
    Wavelet Transform Coherence (ROI maps, with relative phase)
    <span class="panel-hint">
      arrows: right = in phase, left = antiphase, up = {{ subject_ids[0] }} leads by a quarter
      cycle &bull; white dashed = COI boundary &bull; crossed runs get every ROI pair, rows
      {{ subject_ids[0] }} and columns {{ subject_ids[1] }}
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    <img src="data:image/png;base64,{{ wtc_roi_grid_b64 }}" style="max-width:100%"/>
  </div>
</div>
{% endif %}
{% endif %}

{% for cond in condition_figs %}
{% if cond.matrix or cond.grid %}
<div class="card">
  <div class="panel-title">
    Condition: {{ cond.label }}
    <span class="panel-hint">
      {{ cond.tstart }}&ndash;{{ cond.tstop }} s on the aligned clock &bull; the same analysis
      as the whole run, inside this window only &bull; numbers in
      <code>hyper-wtcbycond.tsv</code>
    </span>
  </div>
  {% if cond.matrix %}
  <div style="text-align:center; padding:0.5rem">
    <img src="data:image/png;base64,{{ cond.matrix }}" style="max-width:100%"/>
  </div>
  {% endif %}
  {% if cond.grid %}
  <div style="text-align:center; padding:0.5rem">
    <img src="data:image/png;base64,{{ cond.grid }}" style="max-width:100%"/>
  </div>
  {% endif %}
</div>
{% endif %}
{% endfor %}

{% if wtc_chan_matrix_b64 %}
<div class="card">
  <div class="panel-title">
    Wavelet Transform Coherence (channel &times; channel)
    <span class="panel-hint">
      band mean per channel pair &bull; row = {{ subject_ids[0] }}, column =
      {{ subject_ids[1] }} &bull; diagonal = the homologous pairs the selector plots &bull;
      same numbers as <code>hyper-wtc.tsv</code>
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    <img src="data:image/png;base64,{{ wtc_chan_matrix_b64 }}" style="max-width:100%"/>
  </div>
</div>
{% endif %}

<!-- ISC panel — HbO -->
{% if isc_panel_hbo_b64 %}
<div class="card">
  <div class="panel-title">
    Inter-brain Synchrony — HbO
    <span class="panel-hint">
      topomap (per-channel ISC) &bull; ISC matrix (channel &times; channel Pearson r) &bull;
      connectogram (|ISC| &ge; {{ "%.2f"|format(isc_threshold) }}) &bull;
      <span style="color:#8e44ad">&#9632;</span> {{ subject_ids[0] }}
      <span style="color:#27ae60">&#9632;</span> {{ subject_ids[1] }}
    </span>
  </div>
  {% if isc_unfiltered_note %}<div class="panel-caveat">{{ isc_unfiltered_note }}</div>{% endif %}
  <div style="text-align:center; padding:0.5rem">
    <img src="data:image/png;base64,{{ isc_panel_hbo_b64 }}" style="max-width:100%"/>
  </div>
</div>
{% endif %}

<!-- ISC panel — HbR -->
{% if isc_panel_hbr_b64 %}
<div class="card">
  <div class="panel-title">
    Inter-brain Synchrony — HbR
    <span class="panel-hint">
      topomap (per-channel ISC) &bull; ISC matrix (channel &times; channel Pearson r) &bull;
      connectogram (|ISC| &ge; {{ "%.2f"|format(isc_threshold) }}) &bull;
      <span style="color:#8e44ad">&#9632;</span> {{ subject_ids[0] }}
      <span style="color:#27ae60">&#9632;</span> {{ subject_ids[1] }}
    </span>
  </div>
  {% if isc_unfiltered_note %}<div class="panel-caveat">{{ isc_unfiltered_note }}</div>{% endif %}
  <div style="text-align:center; padding:0.5rem">
    <img src="data:image/png;base64,{{ isc_panel_hbr_b64 }}" style="max-width:100%"/>
  </div>
</div>
{% endif %}

<script>
var _PER_CH     = {{ per_channel_post_json | safe }};
var _CH_PAIRS   = {{ ch_pairs_post_json | safe }};
var _BAD_PAIRS  = {{ bad_pairs_json | safe }};
var _PER_ROI    = {{ per_roi_post_json | safe }};
var _ROI_LABELS = {{ roi_labels_json | safe }};
var _ROI_MATRIX = {{ wtc_roi_matrix_json | safe }};
var _ALIGN      = {{ alignment_json | safe }};
var _cfg = { responsive: true, displayModeBar: true };

// alignment table
(function() {
  var tbody = document.getElementById("align-tbody");
  _ALIGN.forEach(function(row) {
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + row.subject_id + "</td>" +
      "<td>" + (row.offset_s   !== null ? row.offset_s.toFixed(3)   : "—") + "</td>" +
      "<td>" + (row.duration_s !== null ? row.duration_s.toFixed(1) : "—") + "</td>";
    tbody.appendChild(tr);
  });
})();

// channel selector
(function() {
  var sel = document.getElementById("ch-select-post");
  _CH_PAIRS.forEach(function(pair, i) {
    var opt = document.createElement("option");
    opt.value = i;
    opt.textContent = (_BAD_PAIRS.indexOf(pair) >= 0) ? pair + " (bad)" : pair;
    sel.appendChild(opt);
  });
  sel.addEventListener("change", function() { _selectCh(parseInt(this.value)); });
})();

function _selectCh(idx) {
  var pair = _CH_PAIRS[idx];
  var ch   = _PER_CH[pair] || {};
  if (ch.wtc) Plotly.react("wtc-plot", ch.wtc.data, ch.wtc.layout, _cfg);
  else        Plotly.purge("wtc-plot");
}

// ROI selector
(function() {
  var sel = document.getElementById("roi-select-post");
  if (!sel) return;
  _ROI_LABELS.forEach(function(roi, i) {
    var opt = document.createElement("option");
    opt.value = i; opt.textContent = roi;
    sel.appendChild(opt);
  });
  sel.addEventListener("change", function() { _selectRoi(parseInt(this.value)); });
})();

function _selectRoi(idx) {
  var roi = _ROI_LABELS[idx];
  var d   = _PER_ROI[roi] || {};
  if (d.wtc) Plotly.react("wtc-roi-plot", d.wtc.data, d.wtc.layout, _cfg);
  else       Plotly.purge("wtc-roi-plot");
}

// The ROI x ROI matrix only exists when the ROIs were crossed; its card stays hidden otherwise.
(function() {
  var card = document.getElementById("wtc-roi-matrix-card");
  if (!card || !_ROI_MATRIX) return;
  card.style.display = "";
  Plotly.react("wtc-roi-matrix-plot", _ROI_MATRIX.data, _ROI_MATRIX.layout, _cfg);
})();

window.addEventListener("DOMContentLoaded", function() {
  if (_CH_PAIRS.length > 0)   _selectCh(0);
  if (_ROI_LABELS.length > 0) _selectRoi(0);
});
</script>

{% endblock %}
