{% extends "_report_base.html.j2" %}
{% from "_macros.html.j2" import card, subject_metrics %}

{% block css %}
select#ch-select-post, select#roi-select-post {
  font-size: 0.78rem; border: 1px solid #ced4da; border-radius: 4px;
  padding: 0.15rem 0.35rem; background: #fff; margin-left: auto; max-width: 220px;
}
/* One switch for every coherence panel, so a reader is never comparing an HbO channel
   against an HbR region without noticing. */
.chroma-switch { display: flex; gap: 0; margin: 0.35rem 0 0.15rem; }
.chroma-switch button {
  font: inherit; font-size: 0.82rem; cursor: pointer;
  padding: 0.25rem 0.9rem; background: #fff; color: #495057;
  border: 1px solid #ced4da; border-right-width: 0;
}
.chroma-switch button:first-child { border-radius: 4px 0 0 4px; }
.chroma-switch button:last-child  { border-radius: 0 4px 4px 0; border-right-width: 1px; }
.chroma-switch button[aria-pressed="true"] {
  background: #495057; color: #fff; border-color: #495057;
}
/* The run and its conditions are one set of pages; every one of them carries the whole
   strip, so any page reaches any other in a click. */
.cond-nav { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.4rem 0 0.1rem; }
.cond-nav a, .cond-nav span {
  font-size: 0.82rem; padding: 0.22rem 0.7rem; border-radius: 4px;
  border: 1px solid #ced4da; text-decoration: none; color: #495057; background: #fff;
}
.cond-nav a:hover { background: #f1f3f5; }
.cond-nav span.current { background: #495057; color: #fff; border-color: #495057; }
{% endblock %}

{% block content %}

<!-- The run and its conditions -->
{% if nav_links | length > 1 %}
<div class="card">
  <div class="panel-title">
    {% if condition_label %}Condition: {{ condition_label }}{% else %}Whole run{% endif %}
    <span class="panel-hint">
      {% if condition_label -%}
      {{ condition_window }} &bull; every panel below is this window read out of the whole-run
      transform, so it carries the recording's cone of influence and not two edges of its own
      {%- else -%}
      the coherence over the whole recording, averaged across every condition in it &bull;
      the per-condition pages are the ones to read for a block design
      {%- endif %}
    </span>
  </div>
  <div class="cond-nav">
    {% for link in nav_links %}
      {% if link.current %}<span class="current">{{ link.label }}</span>
      {% else %}<a href="{{ link.href }}">{{ link.label }}</a>{% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

<!-- Alignment table -->
{% call card("Time Alignment", hint="crop offset from first shared trigger &bull; all recordings trimmed to shortest") %}
<div class="align-wrap">
  <table id="align-table">
    <thead><tr><th>Subject</th><th>Offset (s)</th><th>Aligned duration (s)</th></tr></thead>
    <tbody id="align-tbody"></tbody>
  </table>
</div>
{% endcall %}

<!-- Per-subject quality metrics -->
{% if subject_metrics_rows %}
{% call card("Per-subject Quality Metrics", hint="↑ / ↓ = better direction &bull; SCI coloured against the threshold, HbO-HbR by sign") %}
<div class="subj-metrics-wrap">
  {{ subject_metrics(subject_metrics_rows, subject_ids) }}
</div>
{% endcall %}
{% elif condition_label %}
{% call card("Per-subject Quality Metrics", hint="measured over the whole recording") %}
<div class="panel-caveat">
  These are measured over the whole recording, so they are not this condition's and are not
  repeated here. They are on the
  <a href="{{ run_href }}">whole-run page</a>. A channel that held up through one condition
  and came loose in another is judged once, over the recording, and the coherence on this
  page rests on that one verdict; per-condition screening is not in yet.
</div>
{% endcall %}
{% endif %}

<!-- ROI grouping -->
{% if roi_rows %}
{% call card("ROI Grouping", hint="channel-to-region mapping from --roi-mapping") %}
<div class="align-wrap">
  <table id="roi-table">
    <thead><tr><th>ROI</th><th>Channels</th></tr></thead>
    <tbody>
    {% for row in roi_rows %}
      <tr>
        <td><b>{{ row.roi }}</b></td>
        <td>{{ row.channels | join(", ") }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endcall %}
{% endif %}

<!-- Chromophore switch: one control for every coherence panel below -->
<div class="card">
  <div class="panel-title">
    Chromophore
    <span class="panel-hint">
      {% if wtc_chroma_labels | length > 1 -%}
      switches every wavelet coherence panel on this page &bull;
      {%- else -%}
      this run computed {{ wtc_chroma_labels[0] }} only, so there is nothing to switch to
      &bull;
      {%- endif %}
      <code>hyper-wtc.tsv</code> carries {{ wtc_chroma_labels | join(" and ") }} in a
      <code>chromophore</code> column
    </span>
  </div>
  {% if wtc_chroma_labels | length > 1 %}
  <div class="chroma-switch" id="chroma-switch" role="group" aria-label="Chromophore"></div>
  {% endif %}
  <div class="panel-caveat">
    HbO and HbR are two parallel passes, never mixed and never averaged. The reason to have
    both is a consistency check, not two results: HbO has the larger amplitude and the
    better SNR, HbR is the less contaminated by scalp and systemic circulation, so a
    coupling that shows in HbO and not in HbR is a caution flag. It is not a quantitative
    test &mdash; coherence is unsigned and bounded, so there is no expected relationship
    between an HbO value and an HbR one. Read it as present or absent. The inter-brain
    correlation panels further down show both chromophores at once instead, an ISC matrix
    being small enough to sit side by side.
  </div>
</div>

<!-- Per-channel WTC -->
<div class="card">
  <div class="panel-title">
    Wavelet Transform Coherence (per channel) &mdash; <span class="chroma-label">{{ wtc_fig_chroma }}</span>
    <span class="panel-hint">
      Morlet wavelet &bull; arrows = relative phase, right in phase and up
      {{ subject_ids[0] }} leading &bull; washed-out band below the white dash sits outside
      the cone of influence
    </span>
    <select id="ch-select-post"></select>
  </div>
  <div style="text-align:center; padding:0.5rem">
    <img id="wtc-chan-img" alt="channel coherence map" style="max-width:100%"/>
  </div>
</div>

<!-- Per-ROI WTC -->
{% if roi_rows %}
<div class="card">
  <div class="panel-title">
    Wavelet Transform Coherence (per ROI) &mdash; <span class="chroma-label">{{ wtc_fig_chroma }}</span>
    <span class="panel-hint">
      the member channels' maps averaged cell by cell, bad channels excluded &bull; arrows
      and cone as above
    </span>
    <select id="roi-select-post"></select>
  </div>
  <div style="text-align:center; padding:0.5rem">
    <img id="wtc-roi-img" alt="ROI coherence map" style="max-width:100%"/>
  </div>
</div>

{% if has_roi_matrix %}
<div class="card" id="wtc-roi-matrix-card">
  <div class="panel-title">
    Wavelet Transform Coherence (ROI &times; ROI) &mdash; <span class="chroma-label">{{ wtc_fig_chroma }}</span>
    <span class="panel-hint">
      band mean per ROI pair, inside the COI &bull; diagonal = homologous ROIs, the ones
      plotted above &bull; the rows of <code>hyper-wtc-roichan.tsv</code> for this
      chromophore
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    <img id="wtc-roi-matrix-img" alt="ROI by ROI coherence matrix" style="max-width:100%"/>
  </div>
</div>
{% endif %}

{% if has_roi_grid %}
<div class="card" id="wtc-roi-grid-card">
  <div class="panel-title">
    Wavelet Transform Coherence (ROI maps, with relative phase) &mdash; <span class="chroma-label">{{ wtc_fig_chroma }}</span>
    <span class="panel-hint">
      arrows: right = in phase, left = antiphase, up = {{ subject_ids[0] }} leads by a quarter
      cycle &bull; white dashed = COI boundary &bull; crossed runs get every ROI pair, rows
      {{ subject_ids[0] }} and columns {{ subject_ids[1] }}
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    <img id="wtc-roi-grid-img" alt="ROI coherence maps" style="max-width:100%"/>
  </div>
</div>
{% endif %}
{% endif %}

{% if has_chan_matrix %}
<div class="card" id="wtc-chan-matrix-card">
  <div class="panel-title">
    Wavelet Transform Coherence (channel &times; channel) &mdash; <span class="chroma-label">{{ wtc_fig_chroma }}</span>
    <span class="panel-hint">
      band mean per channel pair &bull; row = {{ subject_ids[0] }}, column =
      {{ subject_ids[1] }} &bull; diagonal = the homologous pairs the selector plots &bull;
      the rows of <code>hyper-wtc.tsv</code> for this chromophore
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    <img id="wtc-chan-matrix-img" alt="channel coherence matrix" style="max-width:100%"/>
  </div>
</div>
{% endif %}

<!-- ISC panel — HbO -->
{% if isc_panel_hbo_path %}
<div class="card">
  <div class="panel-title">
    Inter-brain Synchrony — HbO
    <span class="panel-hint">
      topomap (per-channel ISC) &bull; ISC matrix (channel &times; channel Pearson r) &bull;
      connectogram (|ISC| &ge; {{ "%.2f"|format(isc_threshold) }}) &bull;
      {% if condition_label %}over this window only, z-scored inside it
      {%- else %}over the whole recording{% endif %} &bull;
      <span style="color:#8e44ad">&#9632;</span> {{ subject_ids[0] }}
      <span style="color:#27ae60">&#9632;</span> {{ subject_ids[1] }}
    </span>
  </div>
  {% if isc_unfiltered_note %}<div class="panel-caveat">{{ isc_unfiltered_note }}</div>{% endif %}
  <div style="text-align:center; padding:0.5rem">
    <img src="{{ isc_panel_hbo_path }}" alt="inter-brain synchrony, HBO" style="max-width:100%"/>
  </div>
</div>
{% endif %}

<!-- ISC panel — HbR -->
{% if isc_panel_hbr_path %}
<div class="card">
  <div class="panel-title">
    Inter-brain Synchrony — HbR
    <span class="panel-hint">
      topomap (per-channel ISC) &bull; ISC matrix (channel &times; channel Pearson r) &bull;
      connectogram (|ISC| &ge; {{ "%.2f"|format(isc_threshold) }}) &bull;
      {% if condition_label %}over this window only, z-scored inside it
      {%- else %}over the whole recording{% endif %} &bull;
      <span style="color:#8e44ad">&#9632;</span> {{ subject_ids[0] }}
      <span style="color:#27ae60">&#9632;</span> {{ subject_ids[1] }}
    </span>
  </div>
  {% if isc_unfiltered_note %}<div class="panel-caveat">{{ isc_unfiltered_note }}</div>{% endif %}
  <div style="text-align:center; padding:0.5rem">
    <img src="{{ isc_panel_hbr_path }}" alt="inter-brain synchrony, HBR" style="max-width:100%"/>
  </div>
</div>
{% endif %}

<script>
var _CHROMA       = {{ wtc_chroma_json | safe }};
var _CHROMA_NAME  = {{ wtc_chroma_names_json | safe }};
var _PER_CH       = {{ per_channel_post_json | safe }};
var _CH_PAIRS     = {{ ch_pairs_post_json | safe }};
var _BAD_PAIRS    = {{ bad_pairs_json | safe }};
var _PER_ROI      = {{ per_roi_post_json | safe }};
var _ROI_LABELS   = {{ roi_labels_json | safe }};
var _ROI_MATRIX   = {{ wtc_roi_matrix_json | safe }};
var _CHAN_MATRIX  = {{ wtc_chan_matrix_json | safe }};
var _ROI_GRID     = {{ wtc_roi_grid_json | safe }};
var _ALIGN        = {{ alignment_json | safe }};

// Every panel below reads this one variable, so the page is one chromophore at a time.
var _chroma = _CHROMA[0];

// Each of the variables above holds a path under figures/, never the figure itself, so
// switching a chromophore or a channel points an img somewhere else and the browser
// fetches that one file. The page used to carry the figures themselves, which on a
// 14-channel dyad with both chromophores came to 174 MB.
function _img(el, src) {
  if (!el) return;
  if (src) { el.src = src;               el.style.display = ""; }
  else     { el.removeAttribute("src");  el.style.display = "none"; }
}

// alignment table
(function() {
  var tbody = document.getElementById("align-tbody");
  _ALIGN.forEach(function(row) {
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + row.subject_id + "</td>" +
      "<td>" + (row.offset_s   !== null ? row.offset_s.toFixed(3)   : "—") + "</td>" +
      "<td>" + (row.duration_s !== null ? row.duration_s.toFixed(1) : "—") + "</td>";
    tbody.appendChild(tr);
  });
})();

// channel selector
(function() {
  var sel = document.getElementById("ch-select-post");
  _CH_PAIRS.forEach(function(pair, i) {
    var opt = document.createElement("option");
    opt.value = i;
    opt.textContent = (_BAD_PAIRS.indexOf(pair) >= 0) ? pair + " (bad)" : pair;
    sel.appendChild(opt);
  });
  sel.addEventListener("change", function() { _selectCh(parseInt(this.value)); });
})();

function _selectCh(idx) {
  var pair = _CH_PAIRS[idx];
  var ch   = (_PER_CH[_chroma] || {})[pair] || {};
  _img(document.getElementById("wtc-chan-img"), ch.wtc);
}

// ROI selector
(function() {
  var sel = document.getElementById("roi-select-post");
  if (!sel) return;
  _ROI_LABELS.forEach(function(roi, i) {
    var opt = document.createElement("option");
    opt.value = i; opt.textContent = roi;
    sel.appendChild(opt);
  });
  sel.addEventListener("change", function() { _selectRoi(parseInt(this.value)); });
})();

function _selectRoi(idx) {
  var roi = _ROI_LABELS[idx];
  var d   = (_PER_ROI[_chroma] || {})[roi] || {};
  _img(document.getElementById("wtc-roi-img"), d.wtc);
}

// Every panel that is not behind a selector: one set of nodes, pointed at the chromophore
// in force. A chromophore whose guard failed on one figure leaves that img hidden and the
// rest of the page intact.
function _drawImages() {
  _img(document.getElementById("wtc-roi-matrix-img"), _ROI_MATRIX[_chroma]);
  _img(document.getElementById("wtc-chan-matrix-img"), _CHAN_MATRIX[_chroma]);
  _img(document.getElementById("wtc-roi-grid-img"),    _ROI_GRID[_chroma]);
}

function _setChroma(name) {
  _chroma = name;
  document.querySelectorAll("#chroma-switch button").forEach(function(btn) {
    btn.setAttribute("aria-pressed", String(btn.dataset.chroma === name));
  });
  // every panel title carries one, so a screenshot of a single panel still says which
  // chromophore it is
  document.querySelectorAll(".chroma-label").forEach(function(el) {
    el.textContent = _CHROMA_NAME[name];
  });
  var chSel  = document.getElementById("ch-select-post");
  var roiSel = document.getElementById("roi-select-post");
  if (chSel  && _CH_PAIRS.length)   _selectCh(parseInt(chSel.value) || 0);
  if (roiSel && _ROI_LABELS.length) _selectRoi(parseInt(roiSel.value) || 0);
  _drawImages();
}

// One button per chromophore that was run. A single-chromophore run has no switch element
// at all -- the template leaves it out, since there is nothing to switch to and the panel
// titles already name the chromophore.
(function() {
  var box = document.getElementById("chroma-switch");
  if (!box) return;
  _CHROMA.forEach(function(name) {
    var btn = document.createElement("button");
    btn.type = "button";
    btn.dataset.chroma = name;
    btn.textContent = _CHROMA_NAME[name];
    btn.setAttribute("aria-pressed", String(name === _chroma));
    btn.addEventListener("click", function() { _setChroma(name); });
    box.appendChild(btn);
  });
})();

window.addEventListener("DOMContentLoaded", function() {
  _setChroma(_chroma);
});
</script>

{% endblock %}
