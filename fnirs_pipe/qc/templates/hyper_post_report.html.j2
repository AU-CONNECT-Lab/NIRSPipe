{% extends "_report_base.html.j2" %}
{% from "_macros.html.j2" import card, subject_metrics %}

{% block css %}
.map-pick { display: flex; align-items: center; gap: 0.3rem; margin-left: auto; }
.map-pick select {
  font-size: 0.78rem; border: 1px solid #ced4da; border-radius: 4px;
  padding: 0.15rem 0.35rem; background: #fff; max-width: 200px;
}
/* The two sides of a crossed pairing read left to right, so the separator has to say
   which member each selector belongs to rather than just sitting between them. */
.map-pick .pick-x { font-size: 0.78rem; color: #868e96; }
/* Both chromophores are on the page at once, stacked, so nothing is behind a control and
   a reader cannot be comparing an HbO channel against an HbR region without noticing. */
.chroma-stack { padding: 0.25rem 0 0.1rem; }
.chroma-stack + .chroma-stack { border-top: 1px solid #e9ecef; margin-top: 0.4rem; }
.chroma-stack > .chroma-name {
  display: inline-block; font-size: 0.78rem; font-weight: 600; color: #495057;
  letter-spacing: 0.03em; margin: 0 0 0.1rem 0.1rem;
}
/* The run and its conditions are one set of pages; every one of them carries the whole
   strip, so any page reaches any other in a click. */
.cond-nav { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.4rem 0 0.1rem; }
.cond-nav a, .cond-nav span {
  font-size: 0.82rem; padding: 0.22rem 0.7rem; border-radius: 4px;
  border: 1px solid #ced4da; text-decoration: none; color: #495057; background: #fff;
}
.cond-nav a:hover { background: #f1f3f5; }
.cond-nav span.current { background: #495057; color: #fff; border-color: #495057; }
{% endblock %}

{% block content %}

<!-- The run and its conditions -->
{% if nav_links | length > 1 %}
<div class="card">
  <div class="panel-title">
    {% if condition_label %}Condition: {{ condition_label }}{% else %}Whole run{% endif %}
    <span class="panel-hint">
      {% if condition_label -%}
      {{ condition_window }} &bull; every panel below is this window read out of the whole-run
      transform, so it carries the recording's cone of influence and not two edges of its own
      {%- elif analysis_window -%}
      restricted to {{ analysis_window }} by <code>--tstart</code>/<code>--tend</code>, taken
      out of the transform of the whole recording rather than cut from it &bull; the coherence
      is averaged across every condition inside that window
      {%- else -%}
      the coherence over the whole recording, averaged across every condition in it &bull;
      the per-condition pages are the ones to read for a block design
      {%- endif %}
    </span>
  </div>
  <div class="cond-nav">
    {% for link in nav_links %}
      {% if link.current %}<span class="current">{{ link.label }}</span>
      {% else %}<a href="{{ link.href }}">{{ link.label }}</a>{% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

<!-- Alignment table -->
{% call card("Time Alignment", hint="crop offset from first shared trigger &bull; all recordings trimmed to shortest") %}
<div class="align-wrap">
  <table id="align-table">
    <thead><tr><th>Subject</th><th>Offset (s)</th><th>Aligned duration (s)</th></tr></thead>
    <tbody id="align-tbody"></tbody>
  </table>
</div>
{% endcall %}

<!-- Per-subject quality metrics -->
{% if subject_metrics_rows %}
{% call card("Per-subject Quality Metrics",
             hint="↑ / ↓ = better direction &bull; SCI coloured against the threshold, HbO-HbR by sign") %}
<div class="subj-metrics-wrap">
  {{ subject_metrics(subject_metrics_rows, subject_ids) }}
</div>
{% if condition_label %}
<div class="panel-caveat">
  Over this window only, read out of the channel-by-window matrices each member's quality
  record already holds, so nothing was measured again. The rows with no windowed series
  behind them are on the <a href="{{ run_href }}">whole-run page</a> instead of being
  filled with the recording's numbers here.
  <br /><br />
  <b>This reports, it does not re-decide.</b> The coherence above was computed on the
  channel set the whole recording was screened into, and stays that way for two reasons:
  the window is read out of a transform of the whole recording, so a channel set of its own
  would need a transform of its own; and screening each condition separately would make a
  contrast between two conditions a contrast between two montages as well. So a channel that
  held up here and came loose elsewhere is still in, and one that came loose <i>here</i> is
  still in too &mdash; these numbers are how to see which.
</div>
{% endif %}
{% endcall %}
{% elif condition_label %}
{% call card("Per-subject Quality Metrics", hint="not available for this window") %}
<div class="panel-caveat">
  Neither member's quality record carries the channel-by-window matrices a per-condition
  view is sliced out of, so there is nothing to show here rather than the whole recording's
  numbers under this condition's heading. Those are on the
  <a href="{{ run_href }}">whole-run page</a>. Re-running <code>fnirs-pipe</code> on these
  subjects writes the matrices.
</div>
{% endcall %}
{% endif %}

<!-- ROI grouping -->
{% if roi_rows %}
{% call card("ROI Grouping", hint="channel-to-region mapping from --roi-mapping") %}
<div class="align-wrap">
  <table id="roi-table">
    <thead><tr><th>ROI</th><th>Channels</th></tr></thead>
    <tbody>
    {% for row in roi_rows %}
      <tr>
        <td><b>{{ row.roi }}</b></td>
        <td>{{ row.channels | join(", ") }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endcall %}
{% endif %}

<!-- Chromophore note: every coherence panel below carries all of them at once -->
<div class="card">
  <div class="panel-title">
    Chromophore
    <span class="panel-hint">
      every coherence panel below shows {{ wtc_chroma_labels | join(" above ") }} &bull;
      <code>hyper-wtc.tsv</code> carries {{ wtc_chroma_labels | join(" and ") }} in a
      <code>chromophore</code> column
    </span>
  </div>
  <div class="panel-caveat">
    HbO and HbR are two parallel passes, never mixed and never averaged. The reason to have
    both is a consistency check, not two results: HbO has the larger amplitude and the
    better SNR, HbR is the less contaminated by scalp and systemic circulation, so a
    coupling that shows in HbO and not in HbR is a caution flag. It is not a quantitative
    test &mdash; coherence is unsigned and bounded, so there is no expected relationship
    between an HbO value and an HbR one. Read it as present or absent. The inter-brain
    correlation panels further down show both chromophores at once instead, an ISC matrix
    being small enough to sit side by side.
  </div>
</div>

<!-- Per-channel WTC -->
<div class="card">
  <div class="panel-title">
    Wavelet Transform Coherence (per channel)
    <span class="panel-hint">
      Morlet wavelet &bull; arrows = relative phase, right in phase and up
      {{ subject_ids[0] }} leading &bull; washed-out band below the white dash sits outside
      the cone of influence
      {%- if chan_crossed %} &bull; left selector = {{ subject_ids[0] }}, right =
      {{ subject_ids[1] }}, the order the map title reads in{% endif %}
    </span>
    <span class="map-pick">
      <select id="ch-select-post" aria-label="{{ subject_ids[0] }} channel"></select>
      {% if chan_crossed %}
      <span class="pick-x">&times;</span>
      <select id="ch-select-post-2" aria-label="{{ subject_ids[1] }} channel"></select>
      {% endif %}
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    {% for c in wtc_chroma_labels %}
    <div class="chroma-stack">
      <span class="chroma-name">{{ c }}</span>
      <img id="wtc-chan-img-{{ loop.index0 }}" alt="channel coherence map ({{ c }})"
           style="max-width:100%"/>
    </div>
    {% endfor %}
  </div>
</div>

<!-- Per-ROI WTC -->
{% if roi_rows %}
<div class="card">
  <div class="panel-title">
    Wavelet Transform Coherence (per ROI)
    <span class="panel-hint">
      the member channels' maps averaged cell by cell, bad channels excluded &bull; arrows
      and cone as above
      {%- if roi_crossed %} &bull; left selector = {{ subject_ids[0] }}, right =
      {{ subject_ids[1] }}, so an off-diagonal pairing reads at the size of a homologous
      one{% endif %}
    </span>
    <span class="map-pick">
      <select id="roi-select-post" aria-label="{{ subject_ids[0] }} region"></select>
      {% if roi_crossed %}
      <span class="pick-x">&times;</span>
      <select id="roi-select-post-2" aria-label="{{ subject_ids[1] }} region"></select>
      {% endif %}
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    {% for c in wtc_chroma_labels %}
    <div class="chroma-stack">
      <span class="chroma-name">{{ c }}</span>
      <img id="wtc-roi-img-{{ loop.index0 }}" alt="ROI coherence map ({{ c }})"
           style="max-width:100%"/>
    </div>
    {% endfor %}
  </div>
</div>

{% if has_roi_matrix %}
<div class="card" id="wtc-roi-matrix-card">
  <div class="panel-title">
    Wavelet Transform Coherence (ROI &times; ROI)
    <span class="panel-hint">
      band mean per ROI pair, inside the COI &bull; one number per map the selectors above
      reach &bull; the rows of <code>hyper-wtc-roichan.tsv</code> for this chromophore
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    {% for c in wtc_chroma_labels %}
    <div class="chroma-stack">
      <span class="chroma-name">{{ c }}</span>
      <img id="wtc-roi-matrix-img-{{ loop.index0 }}" alt="ROI by ROI coherence matrix ({{ c }})"
           style="max-width:100%"/>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}
{% endif %}

{% if has_chan_matrix %}
<div class="card" id="wtc-chan-matrix-card">
  <div class="panel-title">
    Wavelet Transform Coherence (channel &times; channel)
    <span class="panel-hint">
      band mean per channel pair &bull; row = {{ subject_ids[0] }}, column =
      {{ subject_ids[1] }} &bull; one number per map the selectors above reach &bull;
      the rows of <code>hyper-wtc.tsv</code> for this chromophore
    </span>
  </div>
  <div style="text-align:center; padding:0.5rem">
    {% for c in wtc_chroma_labels %}
    <div class="chroma-stack">
      <span class="chroma-name">{{ c }}</span>
      <img id="wtc-chan-matrix-img-{{ loop.index0 }}" alt="channel coherence matrix ({{ c }})"
           style="max-width:100%"/>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

<!-- ISC panel — HbO -->
{% if isc_panel_hbo_path %}
<div class="card">
  <div class="panel-title">
    Inter-brain Synchrony — HbO
    <span class="panel-hint">
      topomap (per-channel ISC) &bull; ISC matrix (channel &times; channel Pearson r) &bull;
      connectogram (|ISC| &ge; {{ "%.2f"|format(isc_threshold) }}) &bull;
      {% if condition_label %}over this window only, z-scored inside it
      {%- else %}over the whole recording{% endif %} &bull;
      <span style="color:#8e44ad">&#9632;</span> {{ subject_ids[0] }}
      <span style="color:#27ae60">&#9632;</span> {{ subject_ids[1] }}
    </span>
  </div>
  {% if isc_unfiltered_note %}<div class="panel-caveat">{{ isc_unfiltered_note }}</div>{% endif %}
  <div style="text-align:center; padding:0.5rem">
    <img src="{{ isc_panel_hbo_path }}" alt="inter-brain synchrony, HBO" style="max-width:100%"/>
  </div>
</div>
{% endif %}

<!-- ISC panel — HbR -->
{% if isc_panel_hbr_path %}
<div class="card">
  <div class="panel-title">
    Inter-brain Synchrony — HbR
    <span class="panel-hint">
      topomap (per-channel ISC) &bull; ISC matrix (channel &times; channel Pearson r) &bull;
      connectogram (|ISC| &ge; {{ "%.2f"|format(isc_threshold) }}) &bull;
      {% if condition_label %}over this window only, z-scored inside it
      {%- else %}over the whole recording{% endif %} &bull;
      <span style="color:#8e44ad">&#9632;</span> {{ subject_ids[0] }}
      <span style="color:#27ae60">&#9632;</span> {{ subject_ids[1] }}
    </span>
  </div>
  {% if isc_unfiltered_note %}<div class="panel-caveat">{{ isc_unfiltered_note }}</div>{% endif %}
  <div style="text-align:center; padding:0.5rem">
    <img src="{{ isc_panel_hbr_path }}" alt="inter-brain synchrony, HBR" style="max-width:100%"/>
  </div>
</div>
{% endif %}

<script>
var _CHROMA       = {{ wtc_chroma_json | safe }};
var _PER_CH       = {{ per_channel_post_json | safe }};
var _CH_PAIRS     = {{ ch_pairs_post_json | safe }};
var _BAD_PAIRS    = {{ bad_pairs_json | safe }};
var _PER_ROI      = {{ per_roi_post_json | safe }};
var _ROI_LABELS   = {{ roi_labels_json | safe }};
var _ROI_MATRIX   = {{ wtc_roi_matrix_json | safe }};
var _CHAN_MATRIX  = {{ wtc_chan_matrix_json | safe }};
var _ALIGN        = {{ alignment_json | safe }};

// Nothing on this page is behind a chromophore control any more: every panel carries one
// image per chromophore, stacked and labelled, and _CHROMA is the order they sit in. What a
// variable below holds is a path under figures/, never the figure, so picking a channel
// points an img somewhere else and the browser fetches that one file.
function _img(el, src) {
  if (!el) return;
  if (src) { el.src = src;               el.style.display = ""; }
  else     { el.removeAttribute("src");  el.style.display = "none"; }
}

// alignment table
(function() {
  var tbody = document.getElementById("align-tbody");
  _ALIGN.forEach(function(row) {
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + row.subject_id + "</td>" +
      "<td>" + (row.offset_s   !== null ? row.offset_s.toFixed(3)   : "—") + "</td>" +
      "<td>" + (row.duration_s !== null ? row.duration_s.toFixed(1) : "—") + "</td>";
    tbody.appendChild(tr);
  });
})();

// Both map panels are a pair of selectors over one nested {sub1: {sub2: {...}}} table.
// An uncrossed run has only the diagonal and the template leaves the second selector out,
// so `_pick` falls back to the first one's label and the lookup is the same either way.
function _fill(sel, labels, mark) {
  if (!sel) return;
  labels.forEach(function(label, i) {
    var opt = document.createElement("option");
    opt.value = i;
    opt.textContent = (mark && mark.indexOf(label) >= 0) ? label + " (bad)" : label;
    sel.appendChild(opt);
  });
}

// One image per chromophore, in _CHROMA order, which is the order the template stacked them.
function _pick(maps, labels, id1, id2, imgBase) {
  var sel1 = document.getElementById(id1);
  var sel2 = document.getElementById(id2);
  if (!sel1 || !labels.length) return;
  var a = labels[parseInt(sel1.value) || 0];
  var b = sel2 ? labels[parseInt(sel2.value) || 0] : a;
  _CHROMA.forEach(function(c, i) {
    var d = ((maps[c] || {})[a] || {})[b] || {};
    _img(document.getElementById(imgBase + "-" + i), d.wtc);
  });
}

function _selectCh() {
  _pick(_PER_CH, _CH_PAIRS, "ch-select-post", "ch-select-post-2", "wtc-chan-img");
}

function _selectRoi() {
  _pick(_PER_ROI, _ROI_LABELS, "roi-select-post", "roi-select-post-2", "wtc-roi-img");
}

(function() {
  ["ch-select-post", "ch-select-post-2"].forEach(function(id) {
    var sel = document.getElementById(id);
    _fill(sel, _CH_PAIRS, _BAD_PAIRS);
    if (sel) sel.addEventListener("change", _selectCh);
  });
  ["roi-select-post", "roi-select-post-2"].forEach(function(id) {
    var sel = document.getElementById(id);
    _fill(sel, _ROI_LABELS, null);
    if (sel) sel.addEventListener("change", _selectRoi);
  });
})();

// The panels behind no selector. A chromophore whose guard failed on one figure leaves that
// one img hidden and the rest of the page intact.
function _drawImages() {
  _CHROMA.forEach(function(c, i) {
    _img(document.getElementById("wtc-roi-matrix-img-" + i), _ROI_MATRIX[c]);
    _img(document.getElementById("wtc-chan-matrix-img-" + i), _CHAN_MATRIX[c]);
  });
}

window.addEventListener("DOMContentLoaded", function() {
  _selectCh();
  _selectRoi();
  _drawImages();
});
</script>

{% endblock %}
