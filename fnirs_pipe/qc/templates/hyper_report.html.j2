{% extends "_report_base.html.j2" %}
{% from "_macros.html.j2" import subject_metrics %}

{% block css %}
/* the two panels a row holds are not the same width: a coherence bar beside a windowed
   heatmap, an optode map beside a head. Both collapse to one column on a narrow screen */
.row { display: grid; gap: 1rem; margin-top: 0.5rem; }
.row-coh    { grid-template-columns: 1fr 2fr; }
.row-layout { grid-template-columns: 1fr 2fr; }
@media (max-width: 900px) {
  .row-coh, .row-layout { grid-template-columns: 1fr; }
}
.row h3 { margin-top: 0; }

.cd-chip{cursor:pointer;padding:.1rem .5rem;border-radius:3px;font-size:.78rem;
  font-weight:600;display:inline-block;min-width:4.2rem;text-align:center}
.cd-chip.cd-unrated{background:#e9ecef;color:#6c757d}
.cd-chip.cd-good{background:#d4edda;color:#155724}
.cd-chip.cd-bad{background:#f8d7da;color:#721c24}
.cd-chip.cd-disabled{opacity:.45;pointer-events:none;cursor:not-allowed}
.cd-table td:not(:first-child), .cd-table th:not(:first-child) { text-align: center; }
/* one member's columns run into the next without it; a rule rather than a fill, so the
   cell colours the metrics carry are still the only colour in the table */
.cd-table .sub-edge { border-left: 2px solid #d8dee5; }
.cd-table .cd-cell { padding-left: 0.4rem; padding-right: 0.4rem; }
{% endblock %}

{% set rating_subject = page_stem %}
{# One cell per section, anchored to it, as the subject and post bars are. Every id that has
   ever been rated is kept even where the section it names was rewritten: a rating is filed
   under the id, so renaming one leaves an old verdict on disk with no cell to show it in.
   `Triggers` is the one that lost its own section; it folded into Alignment, which is where
   a reader looking for it now goes. #}
{% set rating_modules = [[
  {"id": "Summary", "name": "Summary", "href": "#Final", "ratable": false},
  {"sep": true},
  {"id": "Alignment", "name": "Alignment", "href": "#Alignment"},
  {"id": "Usable", "name": "Usable time", "href": "#Usable"},
  {"id": "Head", "name": "Head", "href": "#Head"},
  {"id": "Coherence", "name": "Synchrony", "href": "#Coherence"},
  {"id": "Signal_Quality", "name": "Comparable", "href": "#Quality"},
  {"id": "Channels", "name": "Channels", "href": "#Channels"},
  {"sep": true},
  {"id": "Provenance", "name": "Provenance", "href": "#Provenance", "ratable": false},
  {"id": "Methods", "name": "Methods", "href": "#Methods", "ratable": false},
  {"id": "PostReport", "name": "Post report →",
   "href": post_href or false, "ratable": false},
]] %}
{% set rating_pinned = [{"id": "Final", "name": "FINAL", "href": "#Final"}] %}
{% set rating_chip = "group-" ~ group_id %}
{% set rating_save_endpoint = "/save_hyper_ratings" %}
{% set rating_load_endpoint = "/load_hyper_ratings/" ~ page_stem %}

{# The dyad report reads as a document, so its header is a titled band rather than the
   sticky nav bar the dashboard reports carry. #}
{% block header %}
<div class="page-header">
  <h1>{{ page_heading }}</h1>
  <span class="subtitle">dyad raw QC &bull;
    v{{ versions.get('fnirs-pipe', 'unknown') }} &bull; {{ run_date }}</span>
</div>
{% endblock %}

{% block content %}

<!-- ============================================================== summary -->
<h2 id="Final">Summary</h2>
<div class="summary-box">
  <div class="summary-grid">
    <table>
      <tr><th>Group</th><td>group-{{ group_id }}</td></tr>
      <tr><th>Task</th><td>{{ task }}</td></tr>
      <tr><th>Members</th><td>{{ subject_ids | join(' &times; ') | safe }}</td></tr>
      <tr><th>Scope</th><td>the recording as acquired, before preprocessing</td></tr>
      <tr><th>Date</th><td>{{ run_date }}</td></tr>
      <tr><th>fnirs-pipe</th><td>v{{ versions.get('fnirs-pipe', 'n/a') }}</td></tr>
      <tr><th>MNE</th><td>v{{ versions.get('mne', 'n/a') }}</td></tr>
      <tr><th>Python</th><td>{{ versions.get('python', 'n/a') }}</td></tr>
    </table>
    <table>
      <tr><th>SCI threshold</th><td>{{ "%.2f"|format(sci_threshold) }}</td></tr>
      <tr><th>Coherence band</th>
          <td>{{ "%.3f"|format(coherence_fmin) }}&ndash;{{ "%.3f"|format(coherence_fmax) }}&thinsp;Hz</td></tr>
      <tr><th>Aligned duration</th>
          <td>{% if align_duration_s %}{{ "%.1f"|format(align_duration_s) }}&thinsp;s
              {%- else %}&mdash;{% endif %}</td></tr>
      <tr><th>Max crop offset</th>
          <td>{{ "%.3f"|format(align_max_offset_s) }}&thinsp;s</td></tr>
      <tr><th>Channel pairs</th><td id="sum-n-pairs">&mdash;</td></tr>
      <tr><th>Good in every member</th><td id="sum-all-good">&mdash;</td></tr>
      <tr><th>Bad in every member</th><td id="sum-all-bad">&mdash;</td></tr>
      <tr><th>Usable by the dyad</th><td id="sum-usable">&mdash;</td></tr>
      <tr><th>Screening synchrony</th><td id="sum-screening">&mdash;</td></tr>
    </table>
  </div>
  <p class="qm-note" style="margin-top:0.75rem;">
    This page is the raw pass: every channel is measured, nothing is split by separation and
    nothing has been corrected. It is what says whether the recording is worth preprocessing.
    The synchrony below it is a screening flag read against its own null, not the
    analysis.{% if post_href %} That is on the
    <a href="{{ post_href }}">post report</a>.{% endif %}
  </p>

  <h3 style="margin-top:1.1rem;">The two clocks</h3>
  <p class="qm-note">Crop offset from the first shared trigger; all recordings are then
    trimmed to the shortest. A dyad window is on the aligned clock and a member&rsquo;s own
    record is on its own, and these are what convert between them.</p>
  <div class="summary-grid">
    <table class="qm-table qm-flat" id="align-table">
      <thead><tr><th>Member</th><th>Offset (s)</th><th>Aligned duration (s)</th></tr></thead>
      <tbody id="align-tbody"></tbody>
    </table>
    <table class="qm-table qm-flat" id="blocks-table">
      <thead><tr><th>Block</th><th>Start (s)</th><th>Length (s)</th></tr></thead>
      <tbody id="blocks-tbody"></tbody>
    </table>
  </div>
  <p class="qm-note" id="blocks-verdict"></p>
  <h3 style="margin-top:1rem;">Run command</h3>
  <pre>{{ run_command }}</pre>
</div>

<!-- ================================================= 2. alignment and clocks -->
<h2 id="Alignment">1 &middot; Alignment and the two clocks</h2>
<p class="step-desc">Alignment crops each recording at the first shared trigger, which
  removes a constant offset and nothing else. What it cannot remove is a trigger that landed
  late in one member, or a sampling-rate difference that pulls the two apart across the run.
  Both show up as a block that does not line up below.</p>

{% if figure_paths.alignment_timeline %}
<details id="Timeline" open>
  <summary>The blocks, before and after alignment</summary>
  <div class="details-body">
    <iframe class="plotly-frame" src="{{ figure_paths.alignment_timeline.src }}"
            title="conditions before and after alignment"
            style="height:{{ figure_paths.alignment_timeline.h }}px"></iframe>
    <p class="qm-note">One row per member. The top pair is what was recorded; the bottom
      pair is what every later panel reads.</p>
    <p class="fig-path">{{ figure_paths.alignment_timeline.src }}</p>
  </div>
</details>
{% endif %}

<!-- ================================================== 3. shared usable time -->
<h2 id="Usable">2 &middot; Shared usable time</h2>
<p class="step-desc">A channel is usable by the dyad only while it is coupled in
  <em>both</em> members at the same moment, so the dyad&rsquo;s usable time is the
  intersection of the two and not the smaller of them: two members can each keep 13 of 14
  pairs and share only 12, if the pair they each lose is a different one.</p>

{% if figure_paths.usable_time %}
<details id="UsablePanel" open>
  <summary>a. Which pairs, when, and why not</summary>
  <div class="details-body">
    <iframe class="plotly-frame" src="{{ figure_paths.usable_time.src }}"
            title="usable channel pairs over the shared clock"
            style="height:{{ figure_paths.usable_time.h }}px"></iframe>
    <p class="qm-note">The series over the carpet are each member&rsquo;s long-channel means
      for the metrics the mask is made of, off the same matrices, so a dip in a line is the
      reason for the hole under it. Dotted rules are the screening lines.</p>
    <p class="fig-path">{{ figure_paths.usable_time.src }}</p>
  </div>
</details>
{% endif %}

<!-- ==================================================== 3b. where on the head -->
{% if figure_paths.head_by_condition or figure_paths.head_slider %}
<h2 id="Head">3 &middot; Where on the head</h2>
<p class="step-desc">The same screening verdict as the carpet above, on the montage instead
  of on a channel axis. A long channel is a bar of discs along its source-detector path, a
  short one an outlined square; both share one colour scale, which is what makes the short
  channels readable as a contamination check rather than a second map.</p>

{% if figure_paths.head_by_condition %}
<details id="HeadByCondition" open>
  <summary>a. Per block</summary>
  <div class="details-body">
    <p class="step-desc">Colour is the share of that block&rsquo;s windows in which the
      channel was coupled, in that member.</p>
    <iframe class="plotly-frame" src="{{ figure_paths.head_by_condition.src }}"
            title="coupled-window share per member per block"
            style="height:{{ figure_paths.head_by_condition.h }}px"></iframe>
    <p class="fig-path">{{ figure_paths.head_by_condition.src }}</p>
  </div>
</details>
{% endif %}

{% if figure_paths.head_slider %}
<details id="HeadSlider" open>
  <summary>b. Over the recording <span class="hint">one head per member, with a slider</span></summary>
  <div class="details-body">
    <p class="step-desc">Colour is that window&rsquo;s SCI. The block the slider sits in is
      named above the heads and moves with it.</p>
    <iframe class="plotly-frame" src="{{ figure_paths.head_slider.src }}"
            title="SCI per channel over the recording"
            style="height:{{ figure_paths.head_slider.h }}px"></iframe>
    <p class="fig-path">{{ figure_paths.head_slider.src }}</p>
  </div>
</details>
{% endif %}
{% endif %}

<!-- ======================================================= 4. screening sync -->
<h2 id="Coherence">4 &middot; Screening synchrony, against its null</h2>
<p class="step-desc">Band coherence in
  {{ "%.3f"|format(coherence_fmin) }}&ndash;{{ "%.3f"|format(coherence_fmax) }}&thinsp;Hz,
  read as each window&rsquo;s rank inside a null drawn for <em>that</em> window by pairing
  one member against a phase-scrambled copy of the other. The estimator&rsquo;s floor moves
  with the window length, so two windows&rsquo; raw values are not on a common scale and
  neither is readable alone. This is a screening flag, not the analysis: the wavelet
  coherence is on the post report{% if post_href %},
  <a href="{{ post_href }}">here</a>{% endif %}.</p>

{% if figure_paths.screening_strip %}
<details id="ScreeningPanel" open>
  <summary>a. Percentile against the null</summary>
  <div class="details-body">
    <iframe class="plotly-frame" src="{{ figure_paths.screening_strip.src }}"
            title="screening coherence against its null"
            style="height:{{ figure_paths.screening_strip.h }}px"></iframe>
    <p class="qm-note">One pale dot per channel, the diamond is the window&rsquo;s own rank
      with the channels pooled &mdash; read the diamond. A per-channel rank over a hundred
      draws moves with the draw; the window&rsquo;s does not.</p>
    <p class="fig-path">{{ figure_paths.screening_strip.src }}</p>
  </div>
</details>

<details id="ScreeningTable" open>
  <summary>b. The numbers</summary>
  <div class="details-body">
    <table class="qm-table qm-flat" id="screening-table">
      <thead><tr><th>Window</th><th>Length (s)</th><th>Welch segments</th>
        <th>Measured</th><th>Null mean</th><th>Percentile</th>
        <th>Channels above</th></tr></thead>
      <tbody id="screening-tbody"></tbody>
    </table>
    <p class="qm-note"><b>A flag, not a result.</b> Shared movement, shared task structure
      and shared physiology all raise this number and the surrogate removes none of them: it
      removes only that the two members were together <em>at that moment</em>.</p>
  </div>
</details>
{% endif %}

<!-- ================================================== 1. are they comparable -->
<h2 id="Quality">5 &middot; Are the two members comparable</h2>
<p class="step-desc">Everything downstream matches channels by S-D label and assumes one
  clock. A mismatch here is silent in every later panel: an unmatched label becomes a blank
  row, and a sampling-rate difference becomes drift that alignment cannot remove.</p>

<details id="Comparable" open>
  <summary>a. Montage and rate</summary>
  <div class="details-body">
    <table class="qm-table qm-flat" id="compare-table">
      <thead><tr><th>Member</th><th>Sampling rate (Hz)</th><th>Aligned duration (s)</th>
        <th>S-D pairs</th><th>Long pairs</th></tr></thead>
      <tbody id="compare-tbody"></tbody>
    </table>
    <p class="qm-note" id="compare-verdict"></p>
  </div>
</details>

{% if subject_metrics_rows %}
<details id="MemberMetrics" open>
  <summary>b. Per-member quality metrics</summary>
  <div class="details-body">
    <p class="step-desc">&uarr; / &darr; marks the better direction; SCI is coloured against
      this run&rsquo;s own threshold and HbO&ndash;HbR by sign. One unheaded table: the raw
      pass measures every channel and does not split by separation.</p>
    {{ subject_metrics(subject_metrics_rows) }}
  </div>
</details>
{% endif %}

<details id="GroupSQM" open>
  <summary>c. Group-level quality metrics</summary>
  <div class="details-body">
    <p class="step-desc">The dyad&rsquo;s own numbers rather than either member&rsquo;s: how
      many channel pairs survived in both, and where the screening synchrony sits against
      its own null.</p>
    <ul id="sqm-list" class="qm-list"></ul>
  </div>
</details>

<!-- ============================================================= 5. channels -->
<h2 id="Channels">6 &middot; Channels</h2>

{% if figure_paths.ch_summary %}
<details id="ChannelSummary" open>
  <summary>a. Quality summary across the dyad</summary>
  <div class="details-body">
    <p class="step-desc">Green = kept by every member, yellow = mixed, red = kept by
      none.</p>
    <iframe class="plotly-frame" src="{{ figure_paths.ch_summary.src }}"
            title="channel quality summary across the group"
            style="height:{{ figure_paths.ch_summary.h }}px"></iframe>
    <p class="fig-path">{{ figure_paths.ch_summary.src }}</p>
  </div>
</details>
{% endif %}

<details id="hyper-decisions-card" open>
  <summary>{{ "b" if figure_paths.ch_summary else "a" }}. Channel decisions
    <span class="hint" id="hyper-decisions-hint">per member</span></summary>
  <div class="details-body">
    <p class="step-desc">One row per source-detector pair, both members side by side, with
      the columns the subject report prints and each member&rsquo;s decision at the end of
      its own block. Rows in red were rejected by screening and Status names the criterion.
      Click a chip to cycle: &mdash; &rarr; good &rarr; bad. Saves to each member&rsquo;s
      JSON, and is only active when the page is served by
      <code>fnirs-rate hyper</code>.</p>
    <div style="overflow-x:auto">
      <table class="qm-table cd-table" id="hyper-decisions-table">
        <thead>
          <tr>
            <th rowspan="2">{{ ch_columns[0][1] }}</th>
            {%- for sid in subject_ids %}
            <th colspan="{{ ch_columns|length }}" class="sub-edge">{{ sid }}</th>
            {%- endfor %}
          </tr>
          <tr>
            {%- for sid in subject_ids %}
              {%- for _key, label in ch_columns[1:] %}
            <th class="{{ 'sub-edge' if loop.first else '' }}">{{ label }}</th>
              {%- endfor %}
            <th>Decision</th>
            {%- endfor %}
          </tr>
        </thead>
        <tbody id="hyper-decisions-tbody"></tbody>
      </table>
    </div>
  </div>
</details>

<!-- ============================================================== 6. signals -->
<h2 id="Signals">7 &middot; Per-channel signals</h2>

<details id="PerChannel">
  <summary>a. Both members on one set of axes
    <span class="hint">signal overlay and PSD</span></summary>
  <div class="details-body">
    <p class="step-desc">The one view an individual report cannot give: two members on the
      same axes. No epoch panel &mdash; this design gives one block per condition, so a
      &ldquo;mean epoch&rdquo; would average a single trial.</p>
    <select id="ch-select" class="ch-select"></select>
    <iframe id="ch-detail-iframe" class="plotly-frame" title="per-channel detail"
            style="height:600px"></iframe>
  </div>
</details>


<script>
window.addEventListener("message", function(e) {
  if (!e.data || e.data.type !== "iframe-resize") return;
  var frames = document.querySelectorAll("iframe");
  for (var i = 0; i < frames.length; i++) {
    if (frames[i].contentWindow === e.source) {
      frames[i].style.height = e.data.h + "px";
      return;
    }
  }
});
</script>

<script>
var _ALIGN          = {{ alignment_json | safe }};
var _CH_PAIRS       = {{ ch_pairs_json | safe }};
var _SQM            = {{ sqm_json | safe }};
var _CH_DETAIL_TMPL = {{ ch_detail_template_json | safe }};
var _BLOCKS         = {{ blocks_json | safe }};
var _MEMBERS        = {{ member_info_json | safe }};

window._CH_PAIRS        = _CH_PAIRS;
window._HYPER_SUBJECTS  = {{ subject_ids | tojson }};
window._DECISION_ROWS   = {{ decision_rows_json | safe }};
window._CH_COLUMNS      = {{ ch_columns | tojson }};

function _pairFname(pair) {
  return pair.replace(/[^a-zA-Z0-9]/g, "");
}

// ── alignment table ──────────────────────────────────────────────────────────
(function() {
  var tbody = document.getElementById("align-tbody");
  _ALIGN.forEach(function(row) {
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + row.subject_id + "</td>" +
      "<td>" + (row.offset_s   !== null ? row.offset_s.toFixed(3)   : "—") + "</td>" +
      "<td>" + (row.duration_s !== null ? row.duration_s.toFixed(1) : "—") + "</td>";
    tbody.appendChild(tr);
  });
})();

// ── channel selector → swap per-channel iframe src ───────────────────────────
(function() {
  var sel   = document.getElementById("ch-select");
  var frame = document.getElementById("ch-detail-iframe");
  _CH_PAIRS.forEach(function(pair) {
    var opt = document.createElement("option");
    opt.value = pair; opt.textContent = pair;
    sel.appendChild(opt);
  });
  function _load(pair) {
    if (!_CH_DETAIL_TMPL) return;
    frame.src = _CH_DETAIL_TMPL.replace("{pair}", _pairFname(pair));
  }
  sel.addEventListener("change", function() { _load(this.value); });
  if (_CH_PAIRS.length > 0) _load(_CH_PAIRS[0]);
})();

// the summary's cells come from the same record the sections do, so the two cannot
// disagree about a number the reader sees twice
function _set(id, text, cls) {
  var el = document.getElementById(id);
  if (!el) return;
  el.textContent = text;
  el.className = cls || "";
}

// ── group-level metrics, and the three of them the summary repeats ───────────
(function() {
  var q = _SQM;
  function li(label, value, cls) {
    return "<li><span class='ql'>" + label + "</span>" +
           "<span class='qv" + (cls ? " " + cls : "") + "'>" + value + "</span></li>";
  }
  var _sc = q.screening || {};
  var _alpha = _sc.alpha != null ? _sc.alpha : 95;
  var _wholeRun = (_sc.windows || {})["whole run"] || null;
  var pct = q.pct_all_good;
  var goodCls = pct != null ? (pct >= 80 ? "qm-ok" : pct >= 50 ? "qm-warn" : "qm-bad") : "";
  document.getElementById("sqm-list").innerHTML =
    li("Channels — all good",
       (q.n_all_good != null ? q.n_all_good : "—") +
         (q.n_total ? " / " + q.n_total : ""), goodCls) +
    li("Channels — mixed",   q.n_mixed   != null ? q.n_mixed   : "—") +
    li("Channels — all bad", q.n_all_bad != null ? q.n_all_bad : "—",
       q.n_all_bad > 0 ? "qm-bad" : "") +
    // the measured value is worth printing but cannot be graded on its own: this
    // estimator's floor moves with the window, and 0.008 on a whole run is the floor and
    // not a fault. The percentile against this window's own null is the verdict.
    li("Screening coherence, whole run",
       q.mean_coherence != null ? q.mean_coherence.toFixed(3) : "—") +
    li(" against its own null",
       _wholeRun ? _wholeRun.percentile.toFixed(1) + "th pct" : "—",
       _wholeRun ? (_wholeRun.percentile >= _alpha ? "qm-ok" : "") : "") +
    li("Peak coherence channel",
       q.peak_coherence_channel
         ? q.peak_coherence_channel + " (" + (q.peak_coherence != null ? q.peak_coherence.toFixed(3) : "—") + ")"
         : "—") +
    li("Aligned duration",    q.aligned_duration_s != null ? q.aligned_duration_s + " s" : "—") +
    li("Max alignment offset",q.max_offset_s       != null ? q.max_offset_s + " s"       : "—");

  _set("sum-n-pairs", q.n_total != null ? String(q.n_total) : "—");
  _set("sum-all-good",
       (q.n_all_good != null ? q.n_all_good : "—") +
         (pct != null ? " (" + pct.toFixed(0) + "%)" : ""), goodCls);
  _set("sum-all-bad", q.n_all_bad != null ? String(q.n_all_bad) : "—",
       q.n_all_bad > 0 ? "qm-bad" : "");
  _set("sum-usable",
       q.usable_pairs_mean != null
         ? q.usable_pairs_mean.toFixed(2) + " of " + q.n_long_pairs + " pairs on average"
         : "—");
})();

// ── are the two members comparable ───────────────────────────────────────────
(function() {
  var tbody = document.getElementById("compare-tbody");
  if (!tbody || !_MEMBERS.length) return;
  _MEMBERS.forEach(function(m) {
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + m.subject_id + "</td>" +
      "<td>" + (m.sfreq != null ? m.sfreq.toFixed(4) : "—") + "</td>" +
      "<td>" + (m.duration_s != null ? m.duration_s.toFixed(1) : "—") + "</td>" +
      "<td>" + m.n_pairs + "</td>" +
      "<td>" + m.n_long + "</td>";
    tbody.appendChild(tr);
  });
  // a rate mismatch is drift alignment cannot remove, and an unmatched label becomes a
  // blank row in every later panel; both are silent unless this line says so
  var rates = _MEMBERS.map(function(m) { return m.sfreq; });
  var sameRate = rates.every(function(r) { return Math.abs(r - rates[0]) < 1e-9; });
  var counts = _MEMBERS.map(function(m) { return m.n_pairs; });
  var sameSet = counts.every(function(c) { return c === counts[0]; });
  var el = document.getElementById("compare-verdict");
  if (!el) return;
  if (sameRate && sameSet) {
    el.innerHTML = "<span class='badge-green'>Comparable</span> — same sampling rate and "
      + "the same " + counts[0] + " S-D pairs.";
  } else {
    var why = [];
    if (!sameRate) why.push("sampling rates differ (" + rates.join(", ") + " Hz)");
    if (!sameSet) why.push("the montages carry different channel counts ("
      + counts.join(", ") + ")");
    el.innerHTML = "<span class='badge-red'>Not comparable</span> — " + why.join("; ") + ".";
  }
})();

// ── where each block landed ──────────────────────────────────────────────────
(function() {
  var tbody = document.getElementById("blocks-tbody");
  var names = Object.keys(_BLOCKS);
  if (!tbody) return;
  if (!names.length) {
    tbody.innerHTML = "<tr><td colspan='3' style='color:#adb5bd;font-style:italic;"
      + "text-align:center'>No annotated blocks</td></tr>";
    return;
  }
  names.forEach(function(name) {
    var span = _BLOCKS[name];
    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td>" + name + "</td>" +
      "<td>" + span[0].toFixed(2) + "</td>" +
      "<td>" + (span[1] - span[0]).toFixed(1) + "</td>";
    tbody.appendChild(tr);
  });
  var el = document.getElementById("blocks-verdict");
  if (el) {
    el.textContent = "Times are on the shared clock, after the crop. A block that does not "
      + "line up between the two rows of the figure above is a trigger that landed late in "
      + "one member, or two clocks drifting apart.";
  }
})();

// ── screening synchrony ──────────────────────────────────────────────────────
(function() {
  var sc = (_SQM.screening || {});
  var windows = sc.windows || {};
  var tbody = document.getElementById("screening-tbody");
  var alpha = sc.alpha != null ? sc.alpha : 95;
  if (tbody) {
    Object.keys(windows).forEach(function(name) {
      var v = windows[name];
      var hit = v.percentile >= alpha;
      var tr = document.createElement("tr");
      tr.innerHTML =
        "<td>" + name + "</td>" +
        "<td>" + v.window_s.toFixed(0) + "</td>" +
        "<td>" + v.n_seg + "</td>" +
        "<td>" + v.coherence.toFixed(4) + "</td>" +
        "<td>" + v.null_mean.toFixed(4) + "</td>" +
        "<td class='" + (hit ? "good" : "") + "'>" + v.percentile.toFixed(1) + "</td>" +
        "<td>" + v.n_channels_above + " / " + v.n_channels + "</td>";
      tbody.appendChild(tr);
    });
  }
  var above = sc.above || [];
  _set("sum-screening",
       above.length ? above.join(", ") + " above the null"
                    : (Object.keys(windows).length ? "nothing above the null" : "—"),
       above.length ? "qm-ok" : "");
})();

</script>

<!-- Channel Decisions — populated by fnirs-rate hyper when served via Flask -->
<script>
(function(){
  var _hyperDecisions = {};
  var _isStatic       = true;
  var _hdTimer        = null;

  var subjects = window._HYPER_SUBJECTS || [];
  // strings and cell classes already built by qc/channel_table.py, as in the raw viewer:
  // a renderer that formatted its own numbers would drift from the report beside it
  var _DECISION_ROWS = window._DECISION_ROWS || {};
  var _CH_COLUMNS    = window._CH_COLUMNS || [];

  fetch("/load_decisions")
    .then(function(r) { if (!r.ok) throw new Error("load failed"); return r.json(); })
    .then(function(data) {
      _isStatic = false;
      _hyperDecisions = data || {};
      var hint = document.getElementById("hyper-decisions-hint");
      if (hint) hint.textContent = "per subject";
      buildTable();
    })
    .catch(function() {
      _isStatic = true;
      var hint = document.getElementById("hyper-decisions-hint");
      if (hint) hint.textContent = "read-only · launch via fnirs-rate hyper to save decisions";
      buildTable();
    });

  function buildTable() {
    var tbody = document.getElementById("hyper-decisions-tbody");
    if (!tbody) return;
    tbody.innerHTML = "";
    var metrics = _CH_COLUMNS.slice(1);                 // the name column heads the row
    var nCols = 1 + subjects.length * (metrics.length + 1);
    if (!_DECISION_ROWS.length) {
      tbody.innerHTML = "<tr><td colspan='" + nCols + "' style='color:#adb5bd;"
        + "font-style:italic;text-align:center'>No channels</td></tr>";
      return;
    }
    // long first, then short, the split and the titles the subject report uses; a montage
    // of one kind gets no group rows at all
    var blocks = [["Long channels", []], ["Short channels", []], ["Unclassified", []]];
    _DECISION_ROWS.forEach(function(row) {
      var i = row.separation === "short" ? 1 : (row.separation === "unclassified" ? 2 : 0);
      blocks[i][1].push(row);
    });
    blocks = blocks.filter(function(b) { return b[1].length; });

    blocks.forEach(function(block) {
      if (blocks.length > 1) {
        var head = document.createElement("tr");
        var th = document.createElement("td");
        th.className = "ch-group";
        th.colSpan = nCols;
        th.textContent = block[0] + " (" + block[1].length + ")";
        head.appendChild(th);
        tbody.appendChild(head);
      }
      block[1].forEach(function(row) {
        var tr = document.createElement("tr");
        var tdName = document.createElement("td");
        tdName.textContent = row.pair;
        tr.appendChild(tdName);

        subjects.forEach(function(sid, si) {
          var cells = row.by_sub[sid] || {};
          metrics.forEach(function(col) {
            var td = document.createElement("td");
            td.textContent = cells[col[0]] != null ? cells[col[0]] : "—";
            var cls = cells[col[0] + "_cls"];
            if (cls) td.className = cls;
            if (col === metrics[0]) td.classList.add("sub-edge");
            tr.appendChild(td);
          });
          tr.appendChild(chipCell(sid, row.pair));
        });
        if (row.by_sub[subjects[0]] && row.by_sub[subjects[0]].is_bad) {
          tr.style.background = "#fff8f8";
        }
        tbody.appendChild(tr);
      });
    });
  }

  function chipCell(sid, pair) {
    var hbo = pair + " hbo";
    var hbr = pair + " hbr";
    if (!_hyperDecisions[sid]) _hyperDecisions[sid] = {};
    var state = _hyperDecisions[sid][hbo] || "unrated";
    var chip = document.createElement("span");
    chip.className = "cd-chip cd-" + state + (_isStatic ? " cd-disabled" : "");
    chip.textContent = {unrated: "—", good: "good", bad: "bad"}[state];
    if (!_isStatic) {
      chip.addEventListener("click", function() {
        var cur  = _hyperDecisions[sid][hbo] || "unrated";
        var next = {unrated: "good", good: "bad", bad: "unrated"}[cur];
        _hyperDecisions[sid][hbo] = next;
        _hyperDecisions[sid][hbr] = next;
        chip.className   = "cd-chip cd-" + next;
        chip.textContent = {unrated: "—", good: "good", bad: "bad"}[next];
        save();
      });
    }
    var td = document.createElement("td");
    td.className = "cd-cell";
    td.appendChild(chip);
    return td;
  }

  function save() {
    if (_isStatic) return;
    if (_hdTimer) clearTimeout(_hdTimer);
    _hdTimer = setTimeout(function() {
      fetch("/save_hyper_decisions", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify(_hyperDecisions),
      })
      .then(function(r) { return r.json(); })
      .then(function(d) { if (d.status !== "success") console.warn("hyper cd save failed:", d); })
      .catch(function(e) { console.warn("hyper cd save error:", e); });
    }, 500);
  }
})();
</script>

{% endblock %}
